#etcsl#link type=q t41311.q1 t41311.q2 t41311.q3
#etcsl#linkGrpc
#trailer rubric	kirugu


@(B.B.27 = 27) 3rd @fsux{kirugu}.

#trailer subscript	cir-namcub


@(B.B.28 = 28) A @fsux{šir-namšub} of @wDN{Suen}.
