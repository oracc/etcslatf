@div sa-ŋara C

C.22. {d}en-lil₂ en gal diŋir-re-e-ne uŋ₃ šar₂-ra-bi-še₃ il₂-la
#lem: Enlil[1]DN; en[lord]; gal[big]; diŋir[deity]; uŋ[people]; šar[numerous]V/i; il[raise]
#etcsl: line-id=C.22

C.23. [...] en gal diŋir-re-e-ne uŋ₃# šar₂-ra-bi-še₃ il₂-la
#lem: X; en[lord]; gal[big]; diŋir[deity]; uŋ[people]; šar[numerous]V/i; il[raise]
#etcsl: line-id=C.23

C.24. [...] inim# mah dug₄-ga-zu X saŋ#-ba du-am₃
#lem: X; inim[word]; mah[great]; dug[speak]; X; saŋ[head]; ŋen[go]
#etcsl: line-id=C.24

C.25. [...] niŋ₂ nu-kur₂-ru dug₄-ga-zu ki-bi-še₃ ŋar
#lem: X; niŋ[thing]; kur[different]; dug[speak]; ki[place]; ŋar[put]
#etcsl: line-id=C.25

C.26. [...] X tuku saŋ us₂ e₂-za-ra
#lem: X; X; tuku[acquire]; saŋ[head]; us[accompany]; e[house]
#etcsl: line-id=C.26

C.27. [...] UN#-še₃ nam dug₃ tar-mu-ni-ib
#lem: X; X; nam[fate]; dug[good]; tar[cut]
#etcsl: line-id=C.27

C.28. {[d]}[iš-me]-{[d]}[da-gan] dumu {d}en-lil₂-la₂-ka [...] RI
#lem: Išmedagan[1]RN; dumu[child]; Enlil[1]DN; X; X
#etcsl: line-id=C.28

C.29. [... an] ki zag til-be₂-eš [... he₂]-em-mah
#lem: X; an[sky]; ki[place]; zag[side]; til[complete]; X; mah[great]
#etcsl: line-id=C.29

C.30. [...] X-bi he₂-bad-bad
#lem: X; X; bad[open]
#etcsl: line-id=C.30

C.31. [...] ki kur he₂-em-ši-gam-e
#lem: X; ki[place]; kur[mountain(s)]; gurum[bend]
#etcsl: line-id=C.31

C.32. [...] {[d]}[iš-me]-{d}da-gan [... he₂]-me-en
#lem: X; Išmedagan[1]RN; X; me[be]
#etcsl: line-id=C.32

C.33. [...] X he₂-me-en
#lem: X; X; me[be]
#etcsl: line-id=C.33

C.34. [...]-sub₂-ba
#lem: ŋen[go]
#etcsl: line-id=C.34

C.35. [...] he₂#-me-en
#lem: X; me[be]
#etcsl: line-id=C.35

C.36. [...] he₂-en-ŋal₂
#lem: X; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=C.36

C.37. [...] ZI# he₂-ši-mah
#lem: X; X; mah[great]
#etcsl: line-id=C.37

C.38. [...] saŋ-e-eš he₂-rig₇
#lem: X; saŋ[head]; rig[donate]
#etcsl: line-id=C.38

C.39. [... ŋa₂-la] nu-dag#-ge he₂-me-en
#lem: X; ŋala[cvne]; dag[roam around]; me[be]
#etcsl: line-id=C.39

C.40. [...] X ki kug ki sikil X [...] im-mi-ib₂-ŋal₂
#lem: X; X; ki[place]; kug[purify]; ki[place]; sikil[purify]; X; X; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=C.40

