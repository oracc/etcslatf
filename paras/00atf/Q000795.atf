#lg 1.1	proverb

@(A.1.1.1 = 1)  @note{cf. @xref[t.6.2.3,]{6.2.3: UET 6/2 291 ll. 1-2}, @xref[t.6.2.5,]{6.2.5: YBC 8713 ll. 1-2}} Who can compete with righteousness? It creates life.

#lg 1.2	proverb

@(A.1.2.2 = 2)  @note{cf. @xref[t.6.2.3,]{6.2.3: UET 6/2 291 l. 3}, @xref[t.6.2.5,]{6.2.5: YBC 8713 l. 3}} If wickedness exerts itself, how will @wDN{Utu} succeed?

#lg 1.3	proverb

@(A.1.3.3 = 3)  You should not cut the throat of that which has already had its throat cut.

#lg 1.4	proverb

@(A.1.4.4 = 4)  You should not say to @wDN{Ninŋišzida}: @q{“Let me live!”}

#lg 1.5	proverb

@(A.1.5.5 = 5)  Do not make me pass through the gate!

#lg 1.6	proverb

@(A.1.6.6 = 6)  @note{cf. @xref[t.6.2.3,]{6.2.3: UET 6/2 265 l. 1}} What has submitted will exhibit resistance.

#lg 1.7	proverb

@(A.1.7.7 = 7)  @note{cf. @xref[t.6.2.5,]{6.2.5: YBC 4677 ll. 6-7}} What has been destroyed belongs to a god. No one is able to take it away.

#lg 1.8	proverb

@(A.1.8.8 = 8-9)  @q{“Though I still have bread left over, I will eat your bread!”} Will this endear a man to the household of his friend?

#lg 1.9	proverb

@(A.1.9.10 = 10-11)  @note{cf. @xref[t.6.1.22,]{6.1.22: ll. 140-145}, @xref[t.6.2.3,t623.h3]{6.2.3: UET 6/2 239}, @xref[t.6.2.3,t623.h4]{6.2.3: UET 6/2 320}, @xref[t.6.2.3,]{6.2.3: UET 6/2 339 + UET 6/3 235 Seg. B l. 2}} If bread is left over, the mongoose eats it. If I have any bread left over, then a stranger will eat it.

#lg 1.10	proverb

@(A.1.10.12 = 12)  My things changed things.

#lg 1.11	proverb

@(A.1.11.13 = 13-14)  You don't speak of that which you have found. You talk only about what you have lost.

#lg 1.12	proverb

@(A.1.12.15 = 15-16)  Something which has never occurred since time immemorial: a young woman did not fart in her husband's embrace.

#lg 1.13	proverb

@(A.1.13.17 = 17)  It is a thing of short duration.

#lg 1.14	proverb

@(A.1.14.18 = 18)  Whatever it is that hurts you, don't talk to anyone about it.

#lg 1.15	proverb

@(A.1.15.19 = 19-20)  Wealth is far away, poverty is close at hand.

#lg 1.16	proverb

@(A.1.16.21 = 21)  @note{cf. @xref[t.6.2.5,]{6.2.5: YBC 4677 l. 5}} He who possesses many things is constantly on guard.

#lg 1.17	proverb

@(A.1.17.22 = 22)  Possessions make trust of crucial importance.

#lg 1.18	proverb

@(A.1.18.23 = 23-24)  Possessions are flying birds -- they never find a place to settle.

#lg 1.19	proverb

@(A.1.19.25 = 25)  Good fortune  @varh[t6101.v1]{is embedded in } @vart[t6101.v2,]{@note{3 mss. have instead:} reinforces } organisation and wisdom.


#etcsl#altGrpo
#etcsl#alt t6101.v1 t6101.v2
#etcsl#altGrpc
#lg 1.20	proverb

@(A.1.20.26 = 26-27)  What is eaten for today (?) was put there by the dog. What is eaten by the dog was put there for today (?).

#lg 1.21	proverb

@(A.1.21.28 = 28)  @varh[t6101.v3]{One shouldn't } @vart[t6101.v4,]{@note{1 ms. has instead:} I will not } scorn bread which has turned bad.


#etcsl#altGrpo
#etcsl#alt t6101.v3 t6101.v4
#etcsl#altGrpc
#lg 1.22	proverb

@(A.1.22.29 = 29)  Give out only half a loaf voluntarily!

#lg 1.23	proverb

@(A.1.23.30 = 30)  @note{cf. @xref[t.6.2.3,t623.h5]{6.2.3: UET 6/2 261 and UET 6/2 262}, @xref[t.6.2.3,]{6.2.3: UET 6/2 339 + UET 6/3 235 Seg. B l. 3}, @xref[t.4.14.1,]{4.14.1: l. 144}} To be wealthy and insist (?) on demanding more is abominable.

#lg 1.24	proverb

@(A.1.24.31 = 31)   @gap{1 line fragmentary} 

#lg 1.25	proverb

@(A.1.25.32 = 32)   @gap{1 line unclear} 

#lg 1.26	proverb

@(A.1.26.33 = 33)  Let him decree the fates while consuming what you have made.

#lg 1.27	proverb

@(A.1.27.34 = 34)  I always seem to be speaking about unpleasant things.

#lg 1.28	proverb

@(A.1.28.35 = 35)  When a purchase is settled it is soon out of mind.

#lg 1.29	proverb

@(A.1.29.36 = 36)  He did something never seen before.

#lg 1.30	proverb

@(A.1.30.37 = 37-38)  @note{cf. @xref[t.6.1.07,t.6.1.07.82]{6.1.07.82}} That which does not eat grass is a wild bull of the mountains. That which does not drink water is a gazelle of the mountains.

#lg 1.31	proverb

@(A.1.31.39 = 39)  @note{cf. @xref[t.6.1.07,t.6.1.07.37]{6.1.07.37}} One does not return borrowed bread.

#lg 1.32	proverb

@(A.1.32.40 = 40)  The herald rejoices when the estate makes expenditures.

#lg 1.33	proverb

@(A.1.33.41 = 41)  The steward rejoices when the estate increases its income.

#lg 1.34	proverb

@(A.1.34.42 = 42)  …… slave …… bought …….

#lg 1.35	proverb

@(A.1.35.43 = 43)  Don't pick things now; they will bear fruit later.

#lg 1.36	proverb

@(A.1.36.44 = 44-45)  Who will listen to your translations?

#lg 1.37	proverb

@(A.1.37.46 = 46)  What you are doing is a small accomplishment. That man is not doing a man's work.

#lg 1.38	proverb

@(A.1.38.47 = 47-50)  Bread is served but it is not used for wiping. Water is poured out, and then drunk by the ground. In the nether world, the most honoured place, since it is water and food, it is called a water libation.

#lg 1.39	proverb

@(A.1.39.51 = 51)  He broke it like bread and mixed it with …….

#lg 1.40	proverb

