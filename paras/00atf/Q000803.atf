@div proverb 10.1

10.1.1. [nir]-ŋal₂#-e a-na# [bi₂-in]-dug₄# nu-sag₉
#lem: nirŋal[authoritative]; ana[what?]; dug[speak]; sag[good]
#etcsl: line-id=10.1.1

#etcsl#cf cf. 6.1.09.a1, 6.2.5: IM 43438 Seg. A l. 1

@end proverb

@div proverb 10.2

10.2.2. nir-ŋal₂-e a-na bi₂#-in-dug₄ nu-zid
#lem: nirŋal[authoritative]; ana[what?]; dug[speak]; zid[right]
#etcsl: line-id=10.2.2

#etcsl#cf cf. 6.1.09.a2

@end proverb

@div proverb 10.3-4

10.3-4.3. nir-ŋal₂ kug-zu-am₃ ukur₃ šu dim₄-am₃
#lem: nirŋal[authoritative]; kugzu[wise]; ukur[poor]; šu[hand]; dim[check]
#etcsl: line-id=10.3-4.3

#etcsl#cf cf. 6.1.09.a3, 6.2.2: MDP 27 216, 6.2.5: IM 43438 Seg. A l. 2

10.3-4.4. šu ŋar ŋal₂-la aratta{ki}-ka
#lem: šu[hand]; ŋar[put]; ŋal[⟦be⟧ to be (there]; Aratta[1]GN
#etcsl: line-id=10.3-4.4

@end proverb

@div proverb 10.5

10.5.5. a₂-tuku lugal ki-in-du-ke₄
#lem: atuku[powerful]; lugal[king]; kindu[earth]
#etcsl: line-id=10.5.5

#etcsl#cf cf. 6.1.09.a4, 6.1.22: l. 190, 6.2.3: UET 6/3 80 l. 18

@end proverb

@div proverb 10.6

10.6.6. usu ka lu₂-ta-am₃ am₃-ku₄-ku₄
#lem: usu[strength]; kag[mouth]; lu[person]; kur[enter]
#etcsl: line-id=10.6.6

#etcsl#cf cf. 6.1.09.a5

@end proverb

@div proverb 10.7

10.7.7. usu igi-ŋal₂-tuku nu-mu-e-da-sa₂
#lem: usu[strength]; igiŋaltuku[wise]; sa[equal]
#etcsl: line-id=10.7.7

#etcsl#cf cf. 6.1.09.a6, 6.2.3: UET 6/3 462

@end proverb

@div proverb 10.8

10.8.8. usu diŋir-ŋa₂ ni₂-ŋa₂ ba-til
#lem: usu[strength]; diŋir[deity]; ni[self]; til[complete]
#etcsl: line-id=10.8.8

#etcsl#cf cf. 6.1.09.a7

@end proverb

@div proverb 10.9

10.9.9. [nam]-ŋuruš# anše kar#-ra-gin₇ haš₂-ŋa₂ ba-e-taka₄
#lem: namŋuruš[manliness]; anše[equid]; kar[flee]; haš[thigh]; taka[set aside]
#etcsl: line-id=10.9.9

#etcsl#cf cf. 6.1.09.a8, 6.1.17.b3: ll. 12-13, 5.6.7: l. 28

@end proverb

@div proverb 10.10

10.10.10. [hur-saŋ] gig₂#-ŋu₁₀ im#-babbar ba-an-mu₂
#lem: hursaŋ[mountain]; giggig[black]; imbabbar[gypsum]; mu[grow]
#etcsl: line-id=10.10.10

#etcsl#cf cf. 6.1.17.b3: l. 14, 6.1.19.a1: l. 1, 5.6.7: l. 29

@end proverb

@div proverb 10.11

10.11.11. ama-ŋu₁₀ {ŋiš}tir-ta lu₂ mu-ši-in-gi₄
#lem: ama[mother]; tir[forest]; lu[person]; gi[turn]
#etcsl: line-id=10.11.11

#etcsl#cf cf. 6.1.17.b3: l. 15, 6.1.19.a1: ll. 2-3, 5.6.7: l. 30

10.11.12. šu dab₅-ŋu₁₀ ma-an-šum₂
#lem: šu[hand]; dab[seize]; šum[give]
#etcsl: line-id=10.11.12

@end proverb

@div proverb 10.12

10.12.13. {d}nin-kilim (1:niŋ₂:1) hab₂-ba gu₇-gu₇-ŋu₁₀
#lem: ninkilim[mongoose]; niŋ[thing]; hab[malodorous]; gu[eat]
#etcsl: line-id=10.12.13

:13v.1.1: ($1 ms. has instead:$) uzu
#lem: uzu[flesh]

#etcsl#cf cf. 6.1.17.b3: ll. 16-17, 6.1.19.a1: ll. 4-5, 5.6.7: l. 31

10.12.14. dug i₃-nun-na-še₃ gu₂ nu-mu-un-ši-la₂-e
#lem: dug[(clay) pot]; inun[ghee]; gu[neck]; la[hang]
#etcsl: line-id=10.12.14

@end proverb

@div proverb 10.13

10.13.15. ur₂ %es am-mu-uš-e i-bi₂ %s imin-e
#lem: ur[loin]; ammuš[three]; ibi[eye]N; imin[seven]
#etcsl: line-id=10.13.15

10.13.16. bad₃-si gul-gul-e na-ab-be₂-a
#lem: badsi[parapet]; gul[destroy]; e[speak]
#etcsl: line-id=10.13.16

@end proverb

@div proverb 10.14

10.14.17. esaŋ₂ gibil-za in-nu sumun-a-ŋu₁₀ ga-an-si-e-še
#lem: esaŋ[grain-store]; gibil[new]; inu[straw]; sumun[old]; si[fill]
#etcsl: line-id=10.14.17

@end proverb

@div proverb 10.15

10.15.18. lu₂ mu-e-ši-in-gi₄ %e ta-am₃ %s bi₂-ib-dab₅
#lem: lu[person]; gi[turn]; ta[what?]QP; dab[seize]
#etcsl: line-id=10.15.18

@end proverb

@div proverb 10.16

10.16.19. [ma]-la#-ga-ni mu-na-ni-ib-gi₄-gi₄
#lem: malag[female neighbor]; gi[turn]
#etcsl: line-id=10.16.19

@end proverb

@translation labeled en project

#lg 10.1	proverb

@(10.1.1 = 1)  @note{cf. @xref[t.6.1.09,t.6.1.09.a1]{6.1.09.a1}, @xref[t.6.2.5,]{6.2.5: IM43438 Seg. A l. 1}} Whatever the man in authority said, it was not pleasant.

#lg 10.2	proverb

@(10.2.2 = 2)  @note{cf. @xref[t.6.1.09,t.6.1.09.a2]{6.1.09.a2}} Whatever the man in authority said, it was not right.

#lg 10.3-4	proverb

@(10.3-4.3 = 3-4)  @note{cf. @xref[t.6.1.09,t.6.1.09.a3]{6.1.09.a3}, @xref[t.6.2.2,t622.h5]{6.2.2: MDP 27 216}, @xref[t.6.2.5,]{6.2.5: IM 43438 Seg. A l. 2}} When the authorities are wise, and the poor are loyal, it is the effect of the blessing of @wSN{Aratta}.

#lg 10.5	proverb

@(10.5.5 = 5)  @note{cf. @xref[t.6.1.09,t.6.1.09.a4]{6.1.09.a4}, @xref[t.6.1.22,]{6.1.22: l. 190}, @xref[t.6.2.3,]{6.2.3: UET 6/3 80 l. 18}} The mighty man is master of the earth.

#lg 10.6	proverb

@(10.6.6 = 6)  @note{cf. @xref[t.6.1.09,t.6.1.09.a5]{6.1.09.a5}} It is from a man's mouth that strength comes.

#lg 10.7	proverb

@(10.7.7 = 7)  @note{cf. @xref[t.6.1.09,t.6.1.09.a6]{6.1.09.a6}, @xref[t.6.2.3,t623.h65]{6.2.3: UET 6/3 462}} Strength cannot keep pace with intelligence.

#lg 10.8	proverb

@(10.8.8 = 8)  @note{cf. @xref[t.6.1.09,t.6.1.09.a7]{6.1.09.a7}} The strength of my god completes my own.

#lg 10.9	proverb

@(10.9.9 = 9)  @note{cf. @xref[t.6.1.09,t.6.1.09.a8]{6.1.09.a8}, @xref[t.6.1.17,t.6.1.17.b3]{6.1.17.b3}, @xref[t.6.1.17,]{ll. 12-13}, 5.6.7: l. 28} Youthful vigour has left my loins, like a runaway donkey.

#lg 10.10	proverb

@(10.10.10 = 10)  @note{cf. @xref[t.6.1.17,t.6.1.17.b3]{6.1.17.b3}, @xref[t.6.1.17,]{l. 14}, @xref[t.6.1.19,t.6.1.19.a1]{6.1.19.a1}, @xref[t.6.1.19,]{l. 1}, 5.6.7: l. 29} My black mountain has sprouted white gypsum.

#lg 10.11	proverb

@(10.11.11 = 11-12)  @note{cf. @xref[t.6.1.17,t.6.1.17.b3]{6.1.17.b3}, @xref[t.6.1.17,]{l. 15}, @xref[t.6.1.19,t.6.1.19.a1]{6.1.19.a1}, @xref[t.6.1.19,]{ll. 2-3}, 5.6.7: l. 30} My mother sent to me a man from the forest, who has given me paralysed hands.

#lg 10.12	proverb

@(10.12.13 = 13-14)  @note{cf. @xref[t.6.1.17,t.6.1.17.b3]{6.1.17.b3}, @xref[t.6.1.17,]{ll. 16-17}, @xref[t.6.1.19,t.6.1.19.a1]{6.1.19.a1}, @xref[t.6.1.19,]{ll. 4-5}, 5.6.7: l. 31} My mongoose, which used to eat strong-smelling  @varh[t6110.v1]{food } @vart[t6110.v2,]{@note{1 ms. has instead:} meat }, can no longer stretch its neck toward a jar of ghee.


#etcsl#altGrpo
#etcsl#alt t6110.v1 t6110.v2
#etcsl#altGrpc
#lg 10.13	proverb

@(10.13.15 = 15-16)  @q{“The lap three (?) times, the eye (?) seven times”} is what she says to the one about to breach her defences.

#lg 10.14	proverb

@(10.14.17 = 17)  @q{“Let me fill your new storehouse with my old hay.”}

#lg 10.15	proverb

@(10.15.18 = 18)  A man turned toward you. What did he seize?

#lg 10.16	proverb

@(10.16.19 = 19)  Her girl friend answered her as follows.
