#etcsl: line-id=B.11

B.12. {d}inana mah-di an ki-a gaba-ri nu-tuku-me-en
#lem: Inanak[1]DN; mahdi[exalted]; an[sky]; ki[place]; gabari[equal]; tuku[acquire]
#etcsl: line-id=B.12

B.13. lugal ki aŋ₂ diŋir-re-e-ne a-la mu-un-ši-ak-e#
#lem: lugal[king]; ki[place]; aŋ[measure]; diŋir[deity]; ala[exuberance]; ak[do]
#etcsl: line-id=B.13

B.14. {d}ur-{d}nin-urta šul igi il₂-la-zu me-te-zu-uš en-e
#lem: Urninurta[1]RN; šul[youth]; igi[eye]; il[raise]; mete[appropriate thing]; en[priest]
#etcsl: line-id=B.14

B.15. {d}nin-tur₅-re hi-li mu#-[un-ši]-in-tu#-ud-<<de₃-en>> u₆ [di-zu]-še₃# ma-ra-an-gub
#lem: Nintur[1]DN; hili[attractiveness]; utud[give birth (to)]; u[admiration]; di[speak]; gub[stand]
#etcsl: line-id=B.15

B.16. ŋiš-šub-ba-ni sag₉-ge mu-un#-[ge]-en# igi-za im-mi-in#-[...]
#lem: ŋeššub[lot]; sag[good]; gin[confirm]; igi[eye]; X
#etcsl: line-id=B.16

B.17. ur₃-ra GA šu-nir-e he₂-du₇-a nam-nun-še₃ mu-un-il₂
#lem: ur[roof]; X; šunir[emblem]; hedu[ornament]; namnun[magnificence]; il[raise]
#etcsl: line-id=B.17

