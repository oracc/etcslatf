@div sa-ŋara D

D.25. {d}inana# nin an ki daŋal-la u₁₈-ru KI UD-ta
#lem: Inanak[1]DN; nin[lady]; an[sky]; ki[place]; daŋal[wide]; urun[exalted]; X; X
#etcsl: line-id=D.25

D.26. X [...] X-ma saŋ mu₂-mu₂-mu₂ ŋi₆ u₃-na kar₂-kar₂
#lem: X; X; X; saŋ[head]; mu[grow]; ŋi[night]; ŋiʾunak[night]; kar[blow]
#etcsl: line-id=D.26

D.27. [...] kur# idim-ta e₃-a an uraš-a daŋal bur₂
#lem: X; kur[mountain(s)]; idim[spring]; e[leave]; an[sky]; uraš[earth]; daŋal[wide]; bur[spread out]
#etcsl: line-id=D.27

D.28. [...]-da# teš₂-bi-im ama-na hi-li-bi-im
#lem: X; teš[(sense of) shame]; ama[mother]; hili[attractiveness]
#etcsl: line-id=D.28

D.29. [... he₂]-mi#-ni-in-mah-en ur-{d}nin-urta-ke₄
#lem: X; mah[great]; Urninurta[1]RN
#etcsl: line-id=D.29

D.30. [...] saŋ# hu-mu-ni-in-il₂ am gal-bi he₂-a
#lem: X; saŋ[head]; il[raise]; am[wild bull]; gal[big]; me[be]
#etcsl: line-id=D.30

D.31. [...] gam#-gam-mu-na-ab šu he₂-em-ri-ri-e
#lem: X; gurum[bend]; šu[hand]; ri[impose]
#etcsl: line-id=D.31

D.32. [a] zid#-da-ta ri-a-na šu mah-a-ni si-bi₂-ib
#lem: a[water]; zid[right]; ri[impose]; šu[hand]; mah[great]; si[fill]
#etcsl: line-id=D.32

D.33. uŋ₃# u₂-sal-la hu-mu-un-de₃-nu₂ na-gada-bi he₂-a
#lem: uŋ[people]; usal[meadow]; nud[lie down]; nagada[herdsman]; me[be]
#etcsl: line-id=D.33

D.34. {d}ur-{d}nin-urta-ke₄ uŋ₃ šar₂-re us₂ zid he₂-bi₂-ib-dab₅-be₂
#lem: Urninurta[1]RN; uŋ[people]; šar[numerous]V/i; us[path]; zid[right]; dab[seize]
#etcsl: line-id=D.34

