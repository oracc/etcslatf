F.38. nin me gal-gal-la nam-nir-ra šu du₇
#lem: nin[lady]; me[Being]; gal[big]; namnir[supremacy]; šu[hand]; du[perfect]
#etcsl: line-id=F.38

F.39. {d}inana nin me gal-gal-la nam-nir-ra šu du₇
#lem: Inanak[1]DN; nin[lady]; me[Being]; gal[big]; namnir[supremacy]; šu[hand]; du[perfect]
#etcsl: line-id=F.39

F.40. {d}ur-{d}nin-urta-ra he₂-ŋal₂ zi su₃-ud-ŋal₂ saŋ-e-eš mu-ni-rig₇
#lem: Urninurta[1]RN; heŋal[plenty]; zi[life]; sudŋal[long-lasting]; saŋ[head]; rig[donate]
#etcsl: line-id=F.40

