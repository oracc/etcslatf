&Q000790

{1 = 1-10}
1.	@wPN{Nam-zid-tara} walked by @wDN{Enlil}, who said to him: 
2.	@q[Enlil,Nam-zid-tara]{“Where have you come from, 
3.	@wPN{Nam-zid-tara}?”} @q[Nam-zid-tara,Enlil]{“From @wDN{Enlil's} temple. 
4.	My turn of duty is finished. 
5.	I serve at the place of the @fsux{gudug} priests, 
6.	with their sheep. 
7.	I am on my way home. 
8.	Don't stop me; 
9.	I am in a hurry. 
10.	Who are you who asks me questions?”} 

{11 = 11-16}
11.	@q[Enlil,Nam-zid-tara]{“I am @wDN{Enlil}.”} But @wDN{Enlil} had changed his appearance: 
12.	he had turned into a raven and was croaking. 
13.	@q[Nam-zid-tara,Enlil]{“But you are not a raven, 
14.	you really are @wDN{Enlil}!”} 
15.	@q[Enlil,Nam-zid-tara]{“How did you recognise that I am @wDN{Enlil}, 
16.	who decrees the destinies?”} 

{17 = 17-18}
17.	@q[Nam-zid-tara,Enlil]{“When your uncle @wDN{En-me-šara} was a captive, after taking for himself the rank of @wDN{Enlil}, 
18.	he said: @q[En-me-cara,]{“Now I shall know the fates, like a lord.”}”} 

{19 = 19-23}
19.	@q[Enlil,Nam-zid-tara]{“You may acquire precious metals, you may acquire precious stones, 
20.	you may acquire cattle or you may acquire sheep; 
21.	but the day of a human being is always getting closer, 
22.	so where does your wealth lead? Now, I am indeed @wDN{Enlil}, 
23.	who decrees the fates. What is your name?”} 

{24 = 24-27}
@q[Nam-zid-tara,Enlil]{“My name is @wPN{Nam-zid-tara} (Well-blessed).”} @q[Enlil,Nam-zid-tara]{“Your fate shall be assigned according to your name: 
leave the house of your master, 
and your heirs shall come 
and go regularly in my temple.”} 
