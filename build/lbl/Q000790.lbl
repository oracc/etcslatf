&Q000790

{1 = 1-10}
11.	@wPN{Nam-zid-tara} walked by @wDN{Enlil}, who said to him: 
12.	@q[Enlil,Nam-zid-tara]{“Where have you come from, @wPN{Nam-zid-tara}?”} 
13.	@q[Nam-zid-tara,Enlil]{“From @wDN{Enlil's} temple. 
14.	My turn of duty is finished. 
15.	I serve at the place of the @fsux{gudug} priests, 
16.	with their sheep. 
17.	I am on my way home. 
18.	Don't stop me; 
19.	I am in a hurry. 
110.	Who are you who asks me questions?”} 

{11 = 11-16}
1111.	@q[Enlil,Nam-zid-tara]{“I am @wDN{Enlil}.”} But @wDN{Enlil} had changed his appearance: 
1112.	he had turned into a raven and was croaking. 
1113.	@q[Nam-zid-tara,Enlil]{“But you are not a raven, 
1114.	you really are @wDN{Enlil}!”} 
1115.	@q[Enlil,Nam-zid-tara]{“How did you recognise that I am @wDN{Enlil}, 
1116.	who decrees the destinies?”} 

{17 = 17-18}
1717.	@q[Nam-zid-tara,Enlil]{“When your uncle @wDN{En-me-šara} was a captive, after taking for himself the rank of @wDN{Enlil}, 
1718.	he said: @q[En-me-cara,]{“Now I shall know the fates, like a lord.”}”} 

{19 = 19-23}
1919.	@q[Enlil,Nam-zid-tara]{“You may acquire precious metals, you may acquire precious stones, 
1920.	you may acquire cattle or you may acquire sheep; 
1921.	but the day of a human being is always getting closer, 
1922.	so where does your wealth lead? Now, I am indeed @wDN{Enlil}, who decrees the fates. 
1923.	What is your name?”} 

{24 = 24-27}
2424.	@q[Nam-zid-tara,Enlil]{“My name is @wPN{Nam-zid-tara} (Well-blessed).”} @q[Enlil,Nam-zid-tara]{“Your fate  
2425.	shall be assigned according to your name: 
2426.	leave the house of your master, 
2427.	and your heirs shall come and go regularly in my temple.”} 
