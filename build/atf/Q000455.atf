#lem: šag[heart]; sudŋal[long-lasting]; me[Being]; šar[numerous]V/i; u[ride]; Enlil[1]DN; X
#tr.en: who rides upon all the divine powers, who …… like @wDN{Enlil}. 
#etcsl: line-id=A.A.9

