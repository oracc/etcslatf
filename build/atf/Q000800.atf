@div segment A

@div proverb 7.1

A.7.1.1. [ki gul-la-ba ki] he₂#-en-gul
#tr.en: @note{cf. @xref[t.6.1.02,t.6.1.02.1]{6.1.02.1}, @xref[t.6.2.1,]{6.2.1: Ni 9824 Seg. A ll. 1-2}, @xref[t.6.2.3,]{6.2.3: UET 6/2 356 ll. 3-8}} @q{“In those places which have been destroyed, let more places be destroyed.
#lem: ki[place]; gul[destroy]; ki[place]; gul[destroy]
#etcsl: line-id=A.7.1.1

#etcsl#cf cf. 6.1.02.1, 6.2.1: Ni 9824 Seg. A ll. 1-2, 6.2.3: UET 6/2 356 ll. 3-8

A.7.1.2. [ki nu-gul]-la-ba [gu₂-ŋiri₃] he₂-en-ŋal₂
#tr.en: In those places which have not been destroyed, let a breach be made there.
#lem: ki[place]; gul[destroy]; guŋiri[breach]; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=A.7.1.2

A.7.1.3. [ki-ni ki lu-ub₂]{sar} ku₅-ra₂ he₂-a
#tr.en: Let his place become like chopped-up turnips.”}
#lem: ki[place]; ki[place]; lub[turnip]; kud[cut]; me[be]
#etcsl: line-id=A.7.1.3

A.7.1.4. [me-bi] ba-da-ha-lam
#tr.en: Their place in the universe was destroyed.
#lem: me[Being]; halam[forsake]
#etcsl: line-id=A.7.1.4

A.7.1.5. [di-ir-ga-a ki nam]-ba-e-gul
#tr.en: -- Where there are bonds, you should not destroy the place!
#lem: dirga[bond]; ki[place]; gul[destroy]
#etcsl: line-id=A.7.1.5

A.7.1.6. [me-bi na]-ab-da-[ha-lam-e-en-ze₂-en]
#tr.en: You should not destroy their place in the universe.
#lem: me[Being]; halam[forsake]
#etcsl: line-id=A.7.1.6

@end proverb

$ (approx. 14 lines missing)
@end segment

