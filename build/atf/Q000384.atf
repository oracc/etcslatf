&Q000384 = An adab to Bau for Luma (Luma A)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.2.3.1
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.2.3.1&display=Crit&charenc=gcirc#

@div sa-gida A

A.1. dumu an-na an gal ki gal-ta šag₄ kug-ga-ni im-mi-in-pad₃-de₃
#lem: dumu[child]; An[1]DN; an[sky]; gal[big]; ki[place]; gal[big]; šag[heart]; kug[pure]; pad[find]
#tr.en: Child of @wDN{An}, he has chosen you in his holy heart in the great sky and on the great earth and made you worthy of the ladyship of the Land. 
#etcsl: line-id=A.1

#etcsl#cite Cited in Ur III catalogue at Yale, 0.1.2, line 42 (?)

A.2. nam-nin kalam-ma-kam bi₂-in-tum₂-en
#lem: namnin[ladyship]; kalam[the Land (of Sumer)]; tum[suitable]
#tr.en: @wDN{Bau}, child of @wDN{An}, 
#etcsl: line-id=A.2

A.3. {d}ba-u₂ dumu an-na an gal ki gal-ta
#lem: Bau[1]DN; dumu[child]; An[1]DN; an[sky]; gal[big]; ki[place]; gal[big]
#tr.en: he has chosen you in his holy heart in the great sky and on the great earth and made you worthy of the ladyship of the Land. 
#etcsl: line-id=A.3

A.4. šag₄ kug-ga-ni im-mi-in-pad₃-de₃
#lem: šag[heart]; kug[pure]; pad[find]
#tr.en: @wDN{Enlil} has looked at you with favour, young woman, 
#etcsl: line-id=A.4

A.5. nam-nin kalam-ma-kam bi₂-in-tum₂-en
#lem: namnin[ladyship]; kalam[the Land (of Sumer)]; tum[suitable]
#tr.en: Mother @wDN{Bau}, 
#etcsl: line-id=A.5

A.6. {d}en-lil₂-le e₂-kur za-gin₃-ta
#lem: Enlil[1]DN; Ekur[1]TN; zagin[lapis lazuli]
#tr.en: from the shining @wTN{E-kur}, 
#etcsl: line-id=A.6

A.7. ki-sikil ama {d}ba-u₂ igi zid mu-un-ši-in-bar
#lem: kisikil[young woman]; ama[mother]; Bau[1]DN; igi[eye]; zid[right]; bar[place outside]
#tr.en: and made you eminently fit for Lord @wDN{Ninŋirsu}. 
#etcsl: line-id=A.7

A.8. en# {d}nin-ŋir₂-su gal-bi mu-un-na-an-du₇
#lem: en[lord]; Ninŋirsuk[1]DN; gal[big]; du[perfect]
#tr.en: The Great Mountain @wDN{Enlil} has looked at you with favour, 
#etcsl: line-id=A.8

A.9. kur gal {d}en-lil₂-le e₂-kur za-gin₃-ta
#lem: kur[mountain(s)]; gal[big]; Enlil[1]DN; Ekur[1]TN; zagin[lapis lazuli]
#tr.en: young woman, 
#etcsl: line-id=A.9

A.10. ki-sikil ama {d}ba-u₂ igi zid mu-un-ši-in-bar
#lem: kisikil[young woman]; ama[mother]; Bau[1]DN; igi[eye]; zid[right]; bar[place outside]
#tr.en: Mother @wDN{Bau}, 
#etcsl: line-id=A.10

A.11. en {d}nin-ŋir₂-su-ra gal-bi mu-na-ab-du₇
#lem: en[lord]; Ninŋirsuk[1]DN; gal[big]; du[perfect]
#tr.en: from the shining @wTN{E-kur} and made you eminently fit for Lord @wDN{Ninŋirsu}. 
#etcsl: line-id=A.11

A.12. e₂-tar-sir₂-sir₂ an-ne₂ ŋar-ra-za
#lem: Etarsirsir[1]TN; An[1]DN; ŋar[put]
#tr.en: In the @wTN{E-tar-sirsir}, founded for you by @wDN{An}, 
#etcsl: line-id=A.12

A.13. nam kur-kur-ra ša-mu-ni-ib₂-tar-re
#lem: nam[fate]; kur[mountain(s)]; tar[cut]
#tr.en: you decide the fate of all the countries; 
#etcsl: line-id=A.13

A.14. nin-ŋu₁₀ ŋiš i₃-in-bar di-bi-še₃! i₃-kud-de₃
#lem: nin[lady]; kaš[decision]; bar[place outside]; did[lawsuit]; kud[cut]
#tr.en: you, my lady, render verdicts and decree judgments. 
#etcsl: line-id=A.14

A.15. {d}ba-u₂ e₂-tar-sir₂-sir₂ an-ne₂ ŋar-ra-za
#lem: Bau[1]DN; Etarsirsir[1]TN; an[sky]; ŋar[put]
#tr.en: @wDN{Bau}, in the @wTN{E-tar-sirsir}, founded for you by @wDN{An}, 
#etcsl: line-id=A.15

A.16. nam kur-kur-ra ša-mu-ni-ib₂-tar-re
#lem: nam[fate]; kur[mountain(s)]; tar[cut]
#tr.en: you decide the fate of all the countries; 
#etcsl: line-id=A.16

A.17. {d}ba-u₂ ŋiš i₃-in-bar di-bi-še₃ i₃-kud-de₃
#lem: Bau[1]DN; kaš[decision]; bar[place outside]; did[lawsuit]; kud[cut]
#tr.en: you, @wDN{Bau}, 
#etcsl: line-id=A.17

A.18. {d}lamma RI kisal iri-kug-ga-za
#lem: lammar[(female) tutelary deity]; X; kisal[courtyard]; Irikug[1]SN
#tr.en: render verdicts and decree judgments. 
#etcsl: line-id=A.18

