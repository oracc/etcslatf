#etcsl: line-id=A.19

A.20. {d}ba-u₂ {d}lamma RI kisal iri-kug-ga-za
#lem: Bau[1]DN; lammar[(female) tutelary deity]; X; kisal[courtyard]; Irikug[1]SN
