#tr.en: chosen by @wDN{Inana} with her @vart[t216.v1,t216.v1]{@varn{1 ms. adds:} holy } heart -- @wRN{@wDN{Utu}-ḫeŋal}, the mighty man, 
#etcsl: line-id=25

