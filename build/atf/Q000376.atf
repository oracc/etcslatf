#lem: Kengir[1]; niŋerim[evil]; si[fill]
#tr.en: the king of the four quarters, 
#etcsl: line-id=4

5. dam tuku dam-ni ba-an-da-kar-ra
#lem: dam[spouse]; tuku[acquire]; dam[spouse]; kar[flee]
#tr.en: the king whose orders cannot be countermanded, 
#etcsl: line-id=5

