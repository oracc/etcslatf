#lem: lugal[king]; an[sky]; ub[corner]; limmu[four]; lugal[king]; dug[speak]; gi[turn]
#tr.en: who took away spouses from the married and took away children from parents, 
#etcsl: line-id=11

12. {d}en-lil₂ lugal kur-kur-ra-ke₄ a₂-bi mu-da-an-aŋ₂
#lem: Enlil[1]DN; lugal[king]; kur[mountain(s)]; a[arm]; aŋ[measure]
#tr.en: who made wickedness and violence normal in the Land. 
#etcsl: line-id=12

13. {d}inana nin-a-ni mu-na-an-ŋen šudu₃ mu-na-ša₄
#lem: Inanak[1]DN; nin[lady]; ŋen[go]; šud[prayer]; ša[cvve]
#tr.en: He went to his lady, @wDN{Inana}, 
#etcsl: line-id=13

14. nin-ŋu₁₀ piriŋ me₃ kur-kur-da du₇-du₇
