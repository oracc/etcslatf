#lem: dumu[child]; tuku[acquire]; dumu[child]; kar[flee]
#tr.en: with wiping out the name of @wGN{Gutium}, 
#etcsl: line-id=6

7. niŋ₂-a-erim₂ niŋ₂-a₂-zig₃ kalam-ma mi-ni-in-ŋar-ra
#lem: niŋerim[evil]; niŋazig[violence]; kalam[the Land (of Sumer)]; ŋar[put]
#tr.en: the fanged (?) snake of the mountains, 
#etcsl: line-id=7

8. {d}en-lil₂ lugal kur-kur-ra-ke₄
#lem: Enlil[1]DN; lugal[king]; kur[mountain(s)]
#tr.en: who acted with violence against the gods, 
#etcsl: line-id=8

9. mu-bi ha-lam-e-de₃
#lem: mu[name]; halam[forsake]
#tr.en: who carried off the kingship of @wGN{Sumer} to foreign lands, 
#etcsl: line-id=9

10. {d}utu-he₂-ŋal₂ nitah kalag-ga lugal unug{ki}-ga
#lem: Utuheŋal[1]RN; nita[male]; kalag[strong]; lugal[king]; Unug[1]SN
#tr.en: who filled @wGN{Sumer} with wickedness, 
