&Q000672 = A balbale to Nanna (Nanna C)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.4.13.03
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.4.13.03&display=Crit&charenc=gcirc#

@div segment A

@div unknown A

A.A.1. e₂ {d}utu e₃-a# ki-en-gi-ra#
#tr.en: O eastern (?) house of Sumer, I will declare your greatness!
#lem: e[house]; Utu[1]DN; e[leave]; Kengir[1]
#etcsl: line-id=A.A.1

$ ({d}utu is a supralinear correction by the scribe from an original UD-ta)
A.A.2. e₂-kiš#-[nu]-ŋal₂ šu-luh dadag-ga-am₃
#lem: Ekišnuŋal[1]TN; šuluh[ritual cleansing]; dadag[bright]
#etcsl: line-id=A.A.2

A.A.3. e₂ {d}nanna# nam-mah-za ga-ri#-dug₄
#lem: e[house]; Nanna[1]DN; nammah[greatness]; dug[speak]
#etcsl: line-id=A.A.3

A.A.4. eš₃#{ma} urim₂{ki} mu-zu pa ga-an-e₃
#lem: eš[shrine]; Urim[1]SN; mu[name]; pa[branch]; e[leave]
#etcsl: line-id=A.A.4

A.A.5. hur#-saŋ sikil šag₄ kug-ta e₃-a
#lem: hursaŋ[mountain]; sikil[purify]; šag[heart]; kug[pure]; e[leave]
#etcsl: line-id=A.A.5

A.A.6. urim₂{ki} igi-ŋal₂ {{%akk ta-ši-im-tum}} an uraš-a
#lem: Urim[1]SN; igiŋal[wise]; L; An[1]DN; Uraš[1]DN
#etcsl: line-id=A.A.6

A.A.7. e₂-temen-ni₂-guru₃-a tum₂-ma
#lem: Etemenniguru[1]TN; tum[suitable]
#etcsl: line-id=A.A.7

A.A.8. an-da nam-lugal {{%akk šar!-[...] %akk X}} mu-un-da-e-ba
#lem: An[1]DN; namlugal[kingship]; L; L; ba[allot]
#etcsl: line-id=A.A.8

A.A.9. nam-mah-zu kur-kur-re ba-X [...] X
#lem: nammah[greatness]; kur[mountain(s)]; X; X; X
#etcsl: line-id=A.A.9

A.A.10. su₃-ra₂-še₃ mu-zu pa ga-an-[e₃]
#lem: sud[distant]; mu[name]; pa[branch]; e[leave]
#etcsl: line-id=A.A.10

A.A.11. šu-luh nam-en-na-ke₄ si bi₂-sa₂-a#
#tr.en: He keeps in order the lordly purification rites …….
#lem: šuluh[ritual cleansing]; namen[the office of en-priest]; si[horn]; sa[equal]
#etcsl: line-id=A.A.11

A.A.12. urim₂{ki}-ma dur₂ ki ba-ni-[X-ŋar]
#tr.en: He has taken his seat …… in @wSN{Urim}.
#lem: Urim[1]SN; dur[buttocks]; ki[place]; ŋar[put]
#etcsl: line-id=A.A.12

A.A.13. mu-zu dug₃-ga-am₃ nun-e mu-un#-X [...]
#tr.en: Your name is sweet! The Prince …….
#lem: mu[name]; dug[good]; nun[prince]; X; X
#etcsl: line-id=A.A.13

A.A.14. inim kug-zu an-ra ša-mu-sag₉# X
#tr.en: Your holy word is pleasing to @wDN{An}.
#lem: inim[word]; kug[pure]; An[1]DN; sag[good]; X
#etcsl: line-id=A.A.14

A.A.15. en-he₂-du₇-an-na-ŋu₁₀ an-na he₂-dirig#
#tr.en: May my @wPN{En-ḫedu-ana} excel even @wDN{An}.
#lem: Enheduana[1]PN; An[1]DN; dirig[make more than]
#etcsl: line-id=A.A.15

A.A.16. šu-luh ŋi₆-par₄-ra SI [...]
#tr.en: …… the purification rites of the @fsux{ŋipar}.
#lem: šuluh[ritual cleansing]; ŋipar[cloister]; X; X
#etcsl: line-id=A.A.16

A.A.17. me nam-en-na ba-ab-[...]
#tr.en: …… the lordly divine powers.
#lem: me[Being]; namen[the office of en-priest]; X
#etcsl: line-id=A.A.17

A.A.18. ŋi₆-par₄-ra dib-dib-be₂ [X X]
#tr.en: …… the excellent @fsux{ŋipar}.
#lem: ŋipar[cloister]; dib[pass]; X; X
#etcsl: line-id=A.A.18

A.A.19. {d#}[aš]-im₂-babbar-re# [...]
#tr.en: @wDN{Ašimbabbar} …….
#lem: Dilimbabbar[1]DN; X
#etcsl: line-id=A.A.19

$ (probably 1 line missing)
A.A.21. zi# [...]
#tr.en: ($fragmentary$)
#lem: zi[life]; X
#etcsl: line-id=A.A.21

A.A.22. šir₃ DI [...]
#tr.en: ($fragmentary$)
#lem: šir[sing]; X; X
#etcsl: line-id=A.A.22

A.A.23. šir₃ kug# [...]
#tr.en: …… holy songs …….
#lem: šir[sing]; kug[purify]; X
#etcsl: line-id=A.A.23

A.A.24. nun-e X [...]
#tr.en: The Prince …….
#lem: nun[prince]; X; X
#etcsl: line-id=A.A.24

A.A.25. ŋeštug₂ [...]
#tr.en: …… wisdom …….
#lem: ŋeštug[ear]; X
#etcsl: line-id=A.A.25

A.A.26. me gal-gal-la [...]
#tr.en: …… the great divine powers.
#lem: me[Being]; gal[big]; X
#etcsl: line-id=A.A.26

A.A.27. an {d}en-lil₂ GI# [...]
#tr.en: @wDN{An} and @wDN{Enlil} …….
#lem: An[1]DN; Enlil[1]DN; X; X
#etcsl: line-id=A.A.27

A.A.28. {d}nin-gal-la [...]
#tr.en: @wDN{Ningal} …… May he excel …….
#lem: Ningal[1]DN; X
#etcsl: line-id=A.A.28

A.A.29. he₂-dirig u₃-tud [...]
#tr.en: @wDN{Aš-im-babbar} …….
#lem: dirig[make more than]; utud[give birth (to)]; X
#etcsl: line-id=A.A.29

A.A.30. {d}dil-im₂-babbar-re X X X [...]
#tr.en: Like the sweet moonlight …….
#lem: Dilimbabbar[1]DN; X; X; X; X
#etcsl: line-id=A.A.30

A.A.31. iti₆ niŋ₂ dug₃-gin₇ X URU [...]
#tr.en: …… the @fsux{ŋipar}, my delight, …….
#lem: itud[moon]; niŋ[thing]; dug[good]; X; X; X
#etcsl: line-id=A.A.31

A.A.32. ŋi₆-par₄ šag₄ hul₂-la-ŋu₁₀# [...]
#tr.en: @wDN{An} and @wDN{Enlil} …….
#lem: ŋipar[cloister]; šag[heart]; hul[rejoice]; X
#etcsl: line-id=A.A.32

A.A.33. an {d}en-lil₂-bi [...]
#tr.en: Mother @wDN{Ningal} …… charm …….
#lem: An[1]DN; Enlil[1]DN; X
#etcsl: line-id=A.A.33

A.A.34. ama {d}nin-gal hi-li# [...]
#tr.en: The high priestess of the moon god …….
#lem: ama[mother]; Ningal[1]DN; hili[attractiveness]; X
#etcsl: line-id=A.A.34

A.A.35. zirru(|EN.NU.NUNUZ.ZI.AN.NANNA|) [...]
#tr.en: @wPN{En-ḫedu-ana} ……. My king …….
#lem: zirru[priestess]; X
#etcsl: line-id=A.A.35

A.A.36. en-he₂-du₇-an#-[na ...]
#tr.en: …… the great divine powers …….
#lem: Enheduana[1]PN; X
#etcsl: line-id=A.A.36

A.A.37. lugal-ŋu₁₀ [...]
#tr.en: …… holy songs,
#lem: lugal[king]; X
#etcsl: line-id=A.A.37

A.A.38. me gal-gal-la-ni [...]
#tr.en: light ……
#lem: me[Being]; gal[big]; X
#etcsl: line-id=A.A.38

A.A.39. šir₃ kug su₃-ra₂-aŋ₂ GA# [...]
#tr.en: ($fragmentary$)
#lem: šir[sing]; kug[purify]; sudaŋ[precious metal or material (possibly amber)]; X; X
#etcsl: line-id=A.A.39

A.A.40. mu-zu A GAR# X KI# [...]
#tr.en: @wPN{En-ḫedu-ana} ……
#lem: mu[name]; X; X; X; X; X
#etcsl: line-id=A.A.40

A.A.41. en-he₂-du₇-an-na an-na# [...]
#tr.en: ($fragmentary$)
#lem: Enheduana[1]PN; an[sky]; X
#etcsl: line-id=A.A.41

A.A.42. la-la [...] lu₂-e [...]
?$ (@gap{probably 1 line missing}) 
#lem: lala[plenty]; X; lu[person]; X
#etcsl: line-id=A.A.42

$ (probably 1 line missing)
@end unknown

@end segment

@div segment B

@div ŋišgiŋal B

B.B.1. [...] lu₂# šu-luh-zu mu-un-zu-a
#tr.en: …… who is familiar with your purification rites,
#lem: X; lu[person]; šuluh[ritual cleansing]; zu[know]
#etcsl: line-id=B.B.1

B.B.2. [...]-e# hu-mu-un-ak-e
#tr.en: ……, may he do …….
#lem: X; ak[do]
#etcsl: line-id=B.B.2

B.B.3. [...]-zu# unu! sikil-la ša-ra-an-du₃
#tr.en: …… shall build for you in the pure abode (?) …….
#lem: X; unu[dwelling]; sikil[pure]; du[build]
#etcsl: line-id=B.B.3

B.B.4. [X X] nu₂#-a {{%akk šu-un-nu-um}} nu-un-ši-ku₄-ku₄
#tr.en: …… shall not enter …….
#lem: X; X; nud[lie down]; L; kur[enter]
#etcsl: line-id=B.B.4

B.B.5. še#-zu |GA₂×GI| sikil-la ma-ra-ar₃-ar₃-e {{%akk iṭ-ṭe-e-en-kum}}
#tr.en: He shall grind your barley for you in the pure cloister.
#lem: še[barley]; ŋagia[cloister]; sikil[pure]; ara[grind]; L
#etcsl: line-id=B.B.5

B.B.6. ar₃-ar₃-ra-zu {{%akk E₂ %akk ṭe₆-X-nu}} unu-na la-ba-e-nu₂ {{%akk u₂-ul %akk uš-ta-a-an}}
#tr.en: Your milled grain is not laid in his hall.
#lem: ara[grind]; L; L; unu[dwelling]; nud[lie down]; L; L
#etcsl: line-id=B.B.6

B.B.7. niŋ₂-ar₃-ra-zu {{%akk mu-un-da-ka}} a nu-tag-ge
#tr.en: Water shall not touch what you have ground, and your malt shall not be turned over.
#lem: niŋara[groats]; L; a[water]; tag[touch]
#etcsl: line-id=B.B.7

B.B.8. munu₄-zu niŋ₂ šu bal nu-ak-dam
#tr.en: O palace of @wDN{Suen},
#lem: munu[malt]; niŋ[thing]; šu[hand]; bala[turn]; ak[do]
#etcsl: line-id=B.B.8

B.B.9. e₂-gal {d}suen-na lu₂ a-na-zu mu-un-zu
#tr.en: what do men know of you?
#lem: egal[palace]; Suen[1]DN; lu[person]; ana[what?]; zu[know]
#etcsl: line-id=B.B.9

B.B.10. al-la₂-e {{%akk i-na %akk e-ri-iš-tim}} gudug-e-ne-ka
?$ (@gap{1 line unclear}) 
#lem: la[hang]; L; L; gudug[priest]
#etcsl: line-id=B.B.10

B.B.11. {gi}ma-sa₂-ab ku₄-ku₄-dam asil₃-la₂ di-dam
#tr.en: To bring offerings in baskets, to cause rejoicing,
#lem: masab[basket]; kur[enter]; asilala[joy]; di[speak]
#etcsl: line-id=B.B.11

B.B.12. e₂ dug₃-ge-da e₂ ŋa₂-ŋa₂-dam {{%akk šu-X-X-a-am}}
#tr.en: to make the house comfortable, to establish the house,
#lem: e[house]; dug[good]; e[house]; ŋar[put]; L
#etcsl: line-id=B.B.12

B.B.13. ki šu-luh kug-ga si sa₂-e-dam
#tr.en: to put in order the place of the holy purification rites -- may @wDN{Ningal},
#lem: ki[place]; šuluh[ritual cleansing]; kug[pure]; si[horn]; sa[equal]
#etcsl: line-id=B.B.13

B.B.14. {d#}nin-gal en-he₂-du₇-an-na-ŋu₁₀
#tr.en: my @wPN{En-ḫedu-ana}, restore your …….
#lem: Ningal[1]DN; Enheduana[1]PN
#etcsl: line-id=B.B.14

B.B.15. [...]-zu ki-bi hu-mu-na-gi₄-gi₄
#tr.en: …… @wDN{Nanna}, I shall praise you.
#lem: X; ki[place]; gi[turn]
#etcsl: line-id=B.B.15

B.B.16. [...] {d}nanna mi₂ ga-e-dug₄
#tr.en: …… @wDN{Suen},
#lem: X; Nanna[1]DN; mi[cvne]; dug[speak]
#etcsl: line-id=B.B.16

B.B.17. [...] {d}suen mu-zu pa ga!-an-e₃
#tr.en: I shall glorify your name.
#lem: X; Suen[1]DN; mu[name]; pa[branch]; e[leave]
#etcsl: line-id=B.B.17

@div trailer 

B.B.18. [ŋiš]-gi₄#-ŋal₂-bi-im
#tr.en: Its @fsux{ŋišgiŋal}.
#lem: ŋešgiŋal[musical refrain]
#etcsl: line-id=B.B.18

@end trailer

@end ŋišgiŋal

@div trailer 

B.B.19. [bal]-bal#-e {d}nanna-kam
#tr.en: A @fsux{balbale} of @wDN{Nanna}.
#lem: balbale[literary subscript]; Nanna[1]DN
#etcsl: line-id=B.B.19

