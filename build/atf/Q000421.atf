&Q000421 = Amar-Suena and Enki's temple (Amar-Suena A)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.2.4.3.1
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.2.4.3.1&display=Crit&charenc=gcirc#

@div segment A

A.1. {d}alad X [...]
#tr.en: …… protective deity ……. @wRN{Amar-@wDN{Suena}} …… his heart.
#lem: alad[spirit]; X; X
#etcsl: line-id=A.1

#etcsl#doc The sequence of Segment A (UET 8 33 + U 5307) and Segments B-E (UET 8 32, UET 6/3 487) is far from certain; they may well belong to separate compositions. However, C follows B and E follows D.

A.2. {d}amar-{d}suen# [...] šag₄ mu-un#-X [...]
#tr.en: He who …… the temple with an axe …….
#lem: Amarsuenak[1]RN; X; šag[heart]; X; X
#etcsl: line-id=A.2

A.3. lu₂ {urud}ha-zi-in-na e₂!-e KU X [...]
#tr.en: @wRN{Amar-@wDN{Suena}} …… the @fsux{abzu} shrine. …… built with gold,
#lem: lu[person]; hazin[ax]; e[house]; X; X; X
#etcsl: line-id=A.3

A.4. {d}amar-{d}suen-na eš₃-e!(SUM) abzu-a [...]
#tr.en: and decorated with lapis lazuli.
#lem: Amarsuenak[1]RN; eš[shrine]; Eʾabzu[1]; X
#etcsl: line-id=A.4

A.5. kug-sig₁₇ du₃-a {na₄}za-gin₃ šu tag X [...]
#tr.en: He applied himself to building the temple;
#lem: kugsig[gold]; du[build]; zagin[lapis lazuli]; šu[hand]; tag[touch]; X; X
#etcsl: line-id=A.5

A.6. e₂-e du₃-u₃-de₃ šu-ni mu-un-[ŋar]
#tr.en: King @wRN{Amar-@wDN{Suena}} applied himself to building the temple.
#lem: e[house]; du[build]; šu[hand]; ŋar[put]
#etcsl: line-id=A.6

A.7. {d}amar-{d}suen-na lugal-e e₂-e du₃-u₃-[de₃] šu-ni mu-un-[ŋar]
#tr.en: The people turned against the king,
#lem: Amarsuenak[1]RN; lugal[king]; e[house]; du[build]; šu[hand]; ŋar[put]
#etcsl: line-id=A.7

A.8. lugal-e# uŋ₃#-e ba-da-an-bal kur-ra X [...]
#tr.en: and the foreign countries …….
#lem: lugal[king]; uŋ[people]; bala[turn]; kur[mountain(s)]; X; X
#etcsl: line-id=A.8

A.9. e₂-e# mu 1-kam-ma ba-an-šub ki-bi-še₃ nu-mu#-[un-gi₄]
#tr.en: In the first year the temple remained in ruins, and he did not restore it.
#lem: e[house]; mu[year]; n; šub[fall]; ki[place]; gi[turn]
#etcsl: line-id=A.9

A.10. {d}amar-suen-na me nam-lugal-la-na X [...]
#tr.en: @wRN{Amar-@wDN{Suena}} …… the divine powers of kingship.
#lem: Amarsuenak[1]RN; me[Being]; namlugal[kingship]; X; X
#etcsl: line-id=A.10

A.11. mu 2-kam-ma ba#-[an]-šub ki-bi-še₃ nu-mu-un#-[gi₄]
#tr.en: In the second year it remained in ruins, and he did not restore it.
#lem: mu[year]; n; šub[fall]; ki[place]; gi[turn]
#etcsl: line-id=A.11

A.12. {d}amar-{d}suen-na lu-bu-uš-tum nam-lugal#-[la-ka]-ni tug₂-mu-dur₇-ra ba-an-[...]
#tr.en: @wRN{Amar-@wDN{Suena}} …… his royal garments for mourning clothes.
#lem: Amarsuenak[1]RN; lubuštum[clothing]; namlugal[kingship]; tugmudura[mourning garment]; X
#etcsl: line-id=A.12

A.13. mu 3-kam-ma ba-an-šub ki-bi-še₃ nu-mu-un#-[gi₄]
#tr.en: In the third year it remained in ruins, and he did not restore it.
#lem: mu[year]; n; šub[fall]; ki[place]; gi[turn]
#etcsl: line-id=A.13

A.14. {d}amar-{d}suen-na# ŋiš-kin₂-kin₂-na ŋiškim-bi# [nu]-bur₂#-ru
#tr.en: @wRN{Amar-@wDN{Suena}} could not interpret (?) the temple's ominous sign among (?) the birch trees.
#lem: Amarsuenak[1]RN; ŋešgana[tree]; ŋeškim[sign]; bur[spread out]
#etcsl: line-id=A.14

A.15. mu 4-kam-ma# [ba-an]-šub ki-bi-še₃ nu-mu-un-gi₄
#tr.en: In the fourth year it remained in ruins, and he did not restore it.
#lem: mu[year]; n; šub[fall]; ki[place]; gi[turn]
#etcsl: line-id=A.15

A.16. abgal-e dug₄-ga u₃#-na-dug₄ ŋiš-hur e₂-e pa e₃ nu-mu-un-ak-e
#tr.en: Although he had been advised (?) by a sage, he could not realise the plans of the temple.
#lem: abgal[sage]; dug[speak]; dug[speak]; ŋešhur[plan]; e[house]; pa[branch]; e[leave]; ak[do]
#etcsl: line-id=A.16

A.17. mu 5-kam-ma ba-an-šub ki-bi-še₃ nu-mu-un-gi₄
#tr.en: In the fifth year it remained in ruins, and he did not restore it.
#lem: mu[year]; n; šub[fall]; ki[place]; gi[turn]
#etcsl: line-id=A.17

A.18. eš₃-e abzu-am₃ kalag-ga-še₃ šu mu-ra-ra-e-ne
#tr.en: The @fsux{abzu} shrine has been …… by force.
#lem: eš[shrine]; Eʾabzu[1]; kalag[strong]; šu[hand]; rah[beat]
#etcsl: line-id=A.18

A.19. mu 6-kam-ma ba-an-šub ki-bi-še₃ nu-mu-un-gi₄
#tr.en: In the sixth year it remained in ruins, and he did not restore it.
#lem: mu[year]; n; šub[fall]; ki[place]; gi[turn]
#etcsl: line-id=A.19

A.20. ŋiš-hur e₂-e mu-un-kiŋ₂-kiŋ₂-e nu-mu-ni-in-pad₃-de₃
#tr.en: He was searching for the divine plan of the temple, but could not find it.
#lem: ŋešhur[plan]; e[house]; kiŋ[seek]; pad[find]
#etcsl: line-id=A.20

A.21. mu 7-kam-ma ba-an-šub ki-bi-še₃ nu-mu-un-gi₄
#tr.en: In the seventh year it remained in ruins, and he did not restore it.
#lem: mu[year]; n; šub[fall]; ki[place]; gi[turn]
#etcsl: line-id=A.21

A.22. {d}en-ki-ke₄ e₂-bi-še₃ e₂ nu-me-a ba-an-na-dug₄
#tr.en: @wDN{Enki} spoke to him about the temple, the temple that did not exist.
#lem: Enkik[1]DN; e[house]; e[house]; me[be]; dug[speak]
#etcsl: line-id=A.22

A.23. mu 8-kam-ma e₂ du₃-u₃-de₃ šu-ni mu-un-ŋar
#tr.en: In the eighth year, he applied himself to building the temple.
#lem: mu[year]; n; e[house]; du[build]; šu[hand]; ŋar[put]
#etcsl: line-id=A.23

A.24. mu 9-kam-ma-ta {d}amar-{d}suen# lugal-e
#tr.en: By the ninth year,
#lem: mu[year]; n; Amarsuenak[1]RN; lugal[king]
#etcsl: line-id=A.24

A.25. e₂-udun-na en# gal-an-zu HAR-ra-gin₇ ba-du₃
#tr.en: King @wRN{Amar-@wDN{Suena}} built the @wTN{E-uduna} of the wise lord (?) like …….
#lem: Euduna[1]TN; en[lord]; galanzu[wise]; X; du[build]
#etcsl: line-id=A.25

A.26. ud-ba en-e e₂ ni₂-te-na-ka
#tr.en: Then the lord, the great lord @wDN{Enki},
#lem: ud[sun]; en[lord]; e[house]; ni[self]
#etcsl: line-id=A.26

A.27. en gal {d}en-ki ki-bi ba-da-an-hul
#tr.en: destroyed (?) the site of his own temple.
#lem: en[lord]; gal[big]; Enkik[1]DN; ki[place]; hulu[bad]
#etcsl: line-id=A.27

A.28. X#-a-ni mu-un-|DU.DU| X
#tr.en: ($fragmentary$)
#lem: X; X; X
#etcsl: line-id=A.28

A.29. kuš₂-a ki-a |DU.DU| gaba X [...] X X [...]
#tr.en: ($fragmentary$)
#lem: kušu[tired]; ki[place]; X; gaba[breast]; X; X; X; X; X
#etcsl: line-id=A.29

A.30. a-a {d}en#-[ki] eridug{ki} [... mu]-un-dim₂# [...]
#tr.en: Father @wDN{Enki} …… @wSN{Eridug} …….
#lem: aya[father]; Enkik[1]DN; Eridug[1]SN; X; dim[create]; X
#etcsl: line-id=A.30

A.31. sukkal-a-ni [...] GI#-GI# gal# mu-[...] nu-kuš₂ [...] X IL₂ [...]
#tr.en: …… his minister ……
#lem: sukkal[secretary]; X; X; gal[big]; X; kušu[tired]; X; X; X; X
#etcsl: line-id=A.31

A.32. [...] X [...]
#tr.en: ($fragmentary$)
#lem: X; X; X
#etcsl: line-id=A.32

$ (unknown no. of lines missing)
@end segment

@div segment B

B.1. X GIRI₃# sud#-su₃-ud X [...]
#tr.en: ($fragmentary$)
#lem: X; X; sud[distant]; X; X
#etcsl: line-id=B.1

#etcsl#eq = UET 8 32 obverse

B.2. saŋ keše₂ ki# daŋal-la [...]
#tr.en: The guardian (?) of the spacious land …….
#lem: saŋ[head]; kešed[bind]; ki[place]; daŋal[wide]; X
#etcsl: line-id=B.2

B.3. {d}en-ki-ke₄ igi il₂-la-a-ni# [...]
#tr.en: As @wDN{Enki} lifted his gaze …….
#lem: Enkik[1]DN; igi[eye]; il[raise]; X
#etcsl: line-id=B.3

B.4. e₂-bi um-ta-e₃-a abzu#-a [...]
#tr.en: Having left the temple …… in the @fsux{abzu}.
#lem: e[house]; e[leave]; abzu[(cosmic) underground water]; X
#etcsl: line-id=B.4

B.5. ud-ba nam-lu₂-ulu₃ šu nu-sag₉-ga DI nam [...]
#tr.en: At that time mankind was not …….
#lem: ud[sun]; namlulu[humanity]; šu[hand]; sag[good]; X; nam[fate]; X
#etcsl: line-id=B.5

B.6. ŋizzal sud-a inim ŋeštug₂ nu-dug₄# [...]
#tr.en: Far-reaching wisdom, wise words were not …….
#lem: ŋizzal[hearing]; sud[distant]; inim[word]; ŋeštug[ear]; dug[speak]; X
#etcsl: line-id=B.6

B.7. ba#-DUN-DUN umbin ru-gu₂-ni nu-du₈-e
?$ (@gap{1 line unclear}) 
?#tr.en: To grieve and to do evil was good (?).
?#tr.en: @wRN{Amar-@wDN{Suena}} …… to build the temple of @wDN{Enlil}.
?$ (@gap{unknown no. of lines missing}) 
#lem: X; umbin[finger]; rugu[withstand]; du[spread]
#etcsl: line-id=B.7

B.8. šag₄ hul dim₂-dim₂ niŋ₂-erim₂ ak-ak sag₉-ga
#lem: šag[heart]; hulu[bad]; dim[create]; niŋerim[evil]; ak[do]; sag[good]
#etcsl: line-id=B.8

B.9. {d}amar-{d}suen-na# e₂ {d}en-lil₂-la₂-še₃ du₃-u₃-de₃
#lem: Amarsuenak[1]RN; e[house]; Enlil[1]DN; du[build]
#etcsl: line-id=B.9

$ (unknown no. of lines missing)
@end segment

@div segment C

seg3.1. en# [...] X X [...]
#lem: en[lord]; X; X; X; X
#etcsl: line-id=seg3.1

#etcsl#eq = UET 8 32 reverse

seg3.2. e₂ {d}en-ki-ka₃-še₃ du₃-u₃-de₃ maš₂-e šu mu-un-gid₂-da-a
?#tr.en: Lord ……. When he performed extispicy regarding the building of @wDN{Enki's} temple,
?#tr.en: the omen did not mention anything about the building of the temple,
?#tr.en: so he did not start it. To establish a lasting fame for himself,
?#tr.en: the king ……;
?#tr.en: to establish a lasting fame for himself, @wRN{Amar-@wDN{Suena}} …….
?#tr.en: …… the temple of @wDN{Enki} …….
?$ (@gap{unknown no. of lines missing}) 
#lem: e[house]; Enkik[1]DN; du[build]; maš[goat]; šu[hand]; gid[long]
#etcsl: line-id=seg3.2

seg3.3. maš₂-bi-ta e₂ du₃-a nu-mu-na-ab-be₂ šu-ni la#-ba-ši-in-[ŋar]
#lem: maš[goat]; e[house]; du[build]; e[speak]; šu[hand]; ŋar[put]
#etcsl: line-id=seg3.3

seg3.4. lugal-e mu-ni ud su₃-ra₂-še₃ ŋa₂-ŋa₂-[de₃ ...]
#lem: lugal[king]; mu[name]; ud[sun]; sud[distant]; ŋar[put]; X
#etcsl: line-id=seg3.4

seg3.5. {d}amar-{d}suen mu-ni ud su₃-ra₂#-[še₃ ŋa₂-ŋa₂-de₃] mu#-[...]
#lem: Amarsuenak[1]RN; mu[name]; ud[sun]; sud[distant]; ŋar[put]; X
#etcsl: line-id=seg3.5

seg3.6. X mu e₂ {d}en-ki-ke₄# [...]
#lem: X; mu[name]; e[house]; Enkik[1]DN; X
#etcsl: line-id=seg3.6

$ (unknown no. of lines missing)
@end segment

