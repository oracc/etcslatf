@div proverb 23.7

B.23.7.3. hi-li sipad KU šir-[a-ni]
#lem: hili[attractiveness]; sipad[shepherd]; X; šir[testicle]
#tr.en: @note{cf. @xref[t.6.1.01,t.6.1.01.153]{6.1.01.153}, @xref[t.6.1.01,t.6.1.01.159]{6.1.01.159}, @xref[t.6.1.02,t.6.1.02.62]{6.1.02.62}, @xref[t.6.1.02,t.6.1.02.142]{6.1.02.142}, @xref[t.6.1.03,t.6.1.03.9]{6.1.03.9}, @xref[t.6.1.16,t.6.1.16.b4]{6.1.16.b4-5}, @xref[t.6.1.22,]{6.1.22: ll. 26-27}, @xref[t.6.1.25,t.6.1.25.7]{6.1.25.7}} A …… shepherd's sex appeal is his testicles (?); 
#etcsl: line-id=B.23.7.3

#etcsl#cf cf. 6.1.01.153, 6.1.01.159, 6.1.02.62, 6.1.02.142, 6.1.03.9, 6.1.16.b4-5, 6.1.22: ll. 26-27, 6.1.25.7

B.23.7.4. nu-{ŋiš}kiri₆ suhur-[a-ni]
#lem: nukirik[gardener]; suhur[tuft]
#tr.en: a gardener's is his hair. 
#etcsl: line-id=B.23.7.4

B.23.7.5. {kuš}a₂-ŋa₂-la₂-še₃ šu! il₂ [...]
#lem: aŋala[leather sack]; šu[hand]; il[raise]; X
#tr.en: …… a waterskin. 
#etcsl: line-id=B.23.7.5

B.23.7.6. dam nu-il₂ dumu nu-[il₂]
#lem: dam[spouse]; il[raise]; dumu[child]; il[raise]
#tr.en: He who does not support a wife, 
#etcsl: line-id=B.23.7.6

B.23.7.7. lu₂-lul-la e₂-[a-ni nu-mu-un-da-du₃]
#lem: lulul[liar]; e[house]; du[build]
#tr.en: and who does not support a son. 
#etcsl: line-id=B.23.7.7

B.23.7.8. e₂ gu₅-li-ŋu₁₀ {ŋiš}al-tar-re [ba-gub]
#lem: e[house]; guli[friend]; altar[construction work]; gub[stand]
#tr.en: Although the dishonest man was unable to build his own house, 
#etcsl: line-id=B.23.7.8

B.23.7.9. lu₂-lul-la gal₄-la! [ba-an-us₂]
#lem: lulul[liar]; gala[female genitals]; us[accompany]
#tr.en: he came to serve as a construction worker at my friend's house. 
#etcsl: line-id=B.23.7.9

B.23.7.10. lu₂ nu-ŋar-ra {ŋiš}šu-gur₁₀ 2-[am₃]
#lem: lu[person]; niŋnuŋara[malice]; kin[sickle]; n
#tr.en: A dishonest man chases after women's genitals; 
#etcsl: line-id=B.23.7.10

B.23.7.11. e₂ lu₂ zid-da du₃-a
#lem: e[house]; lu[person]; zid[right]; du[build]
#tr.en: an unreliable man has two sickles. 
#etcsl: line-id=B.23.7.11

B.23.7.12. lu₂-lul-la ba-gul
#lem: lulul[liar]; gul[destroy]
#tr.en: A house built by a righteous man is destroyed by a treacherous man. 
#etcsl: line-id=B.23.7.12

@end proverb

@div proverb 23.8

B.23.8.13. nu-mu-un-na-du-du ŋiri₃ <nu>-mu-na-ŋa₂-ŋa₂
#lem: du[go]; ŋiri[foot]; ŋar[put]
#tr.en: No one walks together with him or directs their steps towards him. 
#etcsl: line-id=B.23.8.13

B.23.8.14. nam-til₃-la (1:a-gin₇ i₃-dib₂-be₂:1)
#lem: namtil[life]; a[water]; dib[pass]
#tr.en: Life @varh[t6123.v1]{passes him by like water } @vart[t6123.v2,]{@note{1 ms. has instead:} eludes him just as he avoids others }. He is dear to no just man, 
#etcsl: line-id=B.23.8.14

:14v.1.1: ($1 ms. has instead:$) e-ne-gin₇ mu-ni-in-dib₂-be₂
#lem: ane[he]; dib[pass]

B.23.8.15. lu₂ zid nu-kal!-la (1:nam-uš₂-ta dirig:1)
#lem: lu[person]; zid[right]; kal[rare]; namuš[death]; dirig[make more than]
#tr.en: @varh[t6123.v3]{plague prevails over him } @vart[t6123.v4,]{@note{1 ms. has instead:} life is not given to him }. Like a worthless penny, @varh[t6123.v5]{……; 
#etcsl: line-id=B.23.8.15

:15v.1.1: ($1 ms. has instead:$) nam-til₃ li#-bi₂-in-šum₂#
#lem: namtil[life]; šum[give]

B.23.8.16. nu-kug-gin₇ (1:mu-un-TI GAR-e nu-tar!-[re]:1)
#lem: kug[pure]; X; X; tar[cut]
#tr.en: no one …… } @vart[t6123.v6,]{@note{1 ms. has instead:} he is thrown away; no one cares about him }. He is clothed with a garment as if a heavy punishment were assigned to him. 
#etcsl: line-id=B.23.8.16

:16v.1.1: ($1 ms. has instead:$) mu-un-ni-šub en₃-na nu-tar#-re
#lem: šub[fall]; en[cvne]; tar[cut]

B.23.8.17. tug₂-gin₇ i₃-mu₄-mu₄
#lem: tug[textile]; mur[dress]
#tr.en: @varh[t6123.v7]{Who is he? His name? 
#etcsl: line-id=B.23.8.17

B.23.8.18. nam-tag dugud un-ŋar-ra
#lem: namtaga[sin]; dugud[heavy]; ŋar[put]
#tr.en: A man sleeping with someone's wife. 
#etcsl: line-id=B.23.8.18

B.23.8.19. (1:a-ba mu-ni lu₂ dam lu₂-kam ba-nu₂!:1)
#lem: aba[who?]; mu[name]; lu[person]; dam[spouse]; lu[person]; nud[lie down]
#tr.en: } @vart[t6123.v8,]{@note{1 ms. has instead:} Who is he? He is a man who slept with someone's wife. } 
#etcsl: line-id=B.23.8.19

:19v.1.1: ($1 ms. has instead:$) a-ba-am₃ e-ne lu₂ dam lu₂-ka in-da-nu₂#-a
#lem: aba[who?]; ane[he]; lu[person]; dam[spouse]; lu[person]; nud[lie down]

@end proverb

@div proverb 23.9

B.23.9.20. an u₂-ga{mušen} ki {d}nin-kilim
#lem: an[sky]; uga[raven]; ki[place]; ninkilim[mongoose]
#tr.en: @note{cf. @xref[t.6.1.01,t.6.1.01.128]{6.1.01.128}, @xref[t.6.1.22,]{6.1.22: ll. 146-147}, @xref[t.6.2.3,t623.h9]{6.2.3: UET 6/2 210}} In the sky there is the raven, on the earth there is the mongoose; and in the desert a lion in its den; my husband (?), where shall I go? 
#etcsl: line-id=B.23.9.20

#etcsl#cf cf. 6.1.01.128, 6.1.22: ll. 146-147, 6.2.3: UET 6/2 210

B.23.9.21. edin-na ur-mah-e ki-tuš-a-bi-X nitalam!(|MUNUS.UŠ|)-ŋu₁₀ me#-am₃ ga-ba-ŋen
#lem: eden[back]; urmah[lion]; kituš[dwelling place]; ŋidlam[(equal ranking) spouse]; mea[where?]; ŋen[go]
#etcsl: line-id=B.23.9.21

@end proverb

