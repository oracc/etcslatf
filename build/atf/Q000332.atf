&Q000332 = Enki and Ninḫursaŋa
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.1.1.1
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.1.1.1&display=Crit&charenc=gcirc#

1. iri{ki} kug-kug-ga-am₃ e-ne ba-am₃-me-en-ze₂-en kur dilmun{ki} kug-ga-am₃
#tr.en: Pure are the cities -- and you are the ones to whom they are allotted. Pure is @wGN{Dilmun} land.
#lem: iri[city]; kug[pure]; ane[he]; ba[allot]; kur[mountain(s)]; Dilmun[1]GN; kug[pure]
#etcsl: line-id=1

2. ki-en-gi kug-ga e-ne ba-am₃-me-en-ze₂-en kur dilmun{ki} kug-ga-am₃
#tr.en: Pure is @wGN{Sumer} -- and you are the ones to whom it is allotted. Pure is @wGN{Dilmun} land.
#lem: Kengir[1]; kug[pure]; ane[he]; ba[allot]; kur[mountain(s)]; Dilmun[1]GN; kug[pure]
#etcsl: line-id=2

3. kur dilmun{ki} kug-ga-am₃ kur dilmun sikil-am₃
#tr.en: Pure is @wGN{Dilmun} land. Virginal is @wGN{Dilmun} land.
#lem: kur[mountain(s)]; Dilmun[1]GN; kug[pure]; kur[mountain(s)]; Dilmun[1]GN; sikil[pure]
#etcsl: line-id=3

4. kur dilmun{ki} sikil-am₃ kur dilmun{ki} dadag-ga-am₃
#tr.en: Virginal is @wGN{Dilmun} land. Pristine is @wGN{Dilmun} land.
#lem: kur[mountain(s)]; Dilmun[1]GN; sikil[pure]; kur[mountain(s)]; Dilmun[1]GN; dadag[bright]
#etcsl: line-id=4

5. dili-ni-ne dilmun{ki}-a u₃-bi₂-in-nu₂
#tr.en: He laid her down all alone in @wGN{Dilmun},
#lem: dili[single]; Dilmun[1]GN; nud[lie down]
#etcsl: line-id=5

6. ki {d}en-ki dam-a-ni-da ba-an-da-nu₂-a-ba
#tr.en: and the place where @wDN{Enki} had lain down with his spouse,
#lem: ki[place]; Enkik[1]DN; dam[spouse]; nud[lie down]
#etcsl: line-id=6

7. ki-bi sikil-am₃ ki-bi dadag-ga-am₃
#tr.en: that place was still virginal, that place was still pristine.
#lem: ki[place]; sikil[pure]; ki[place]; dadag[bright]
#etcsl: line-id=7

8. dili-ni-ne dilmun{ki}-a u₃-bi₂-in-nu₂
#tr.en: He laid her down all alone in @wGN{Dilmun},
#lem: dili[single]; Dilmun[1]GN; nud[lie down]
#etcsl: line-id=8

9. ki {d}en-ki {d}nin-sikil-la ba-an-da-nu₂-a-ba
#tr.en: and the place where @wDN{Enki} had lain down with @wDN{Ninsikila},
#lem: ki[place]; Enkik[1]DN; Ninsikila[1]DN; nud[lie down]
#etcsl: line-id=9

10. ki-bi sikil-am₃ ki-bi dadag-ga-am₃
#tr.en: that place was virginal, that place was pristine.
#lem: ki[place]; sikil[pure]; ki[place]; dadag[bright]
#etcsl: line-id=10

11. dilmun{ki}-a uga{mušen} gu₃-gu₃ nu-mu-ni-be₂
#tr.en: In @wGN{Dilmun} the raven was not yet cawing,
#lem: Dilmun[1]GN; uga[raven]; gu[voice]; e[speak]
#etcsl: line-id=11

12. dar{mušen}-e gu₃ dar{mušen}-re nu-mu-ni-ib-be₂
#tr.en: the partridge not cackling.
#lem: dar[bird]; gu[voice]; dar[bird]; e[speak]
#etcsl: line-id=12

13. ur-gu-la saŋ ŋiš nu-ub-ra-ra
#tr.en: The lion did not slay,
#lem: urgula[lion]; saŋ[head]; ŋeš[tree]; rah[beat]
#etcsl: line-id=13

14. ur-bar-ra-ke₄ sila₄ nu-ub-kar-re
#tr.en: the wolf was not carrying off lambs,
#lem: urbara[wolf]; sila[lamb]; kar[flee]
#etcsl: line-id=14

15. ur-gir₁₅ maš₂ gam-gam nu-ub-zu
#tr.en: the dog had not been taught to make kids curl up,
#lem: urgir[(domestic) dog]; maš[goat]; gurum[bend]; zu[know]
#etcsl: line-id=15

16. šah₂ še gu₇-gu₇-e nu-ub-zu
#tr.en: the pig had not learned that grain was to be eaten.
#lem: šah[pig]; še[barley]; gu[eat]; zu[know]
#etcsl: line-id=16

17. nu-mu-un-su₂ munu₄ ur₃-ra barag₂-ga-ba
#tr.en: When a widow has spread malt on the roof,
#lem: numunkuš[widow]; munu[malt]; ur[roof]; barag[spread out]
#etcsl: line-id=17

18. mušen-e an-na munu₄-bi na-an-gu₇-e
#tr.en: the birds did not yet eat that malt up there.
#lem: mušen[bird]; an[sky]; munu[malt]; gu[eat]
#etcsl: line-id=18

19. tum₁₂{mušen}-e saŋ nu-mu-un-da-RU-e
#tr.en: The pigeon then did not tuck the head under its wing.
#lem: tum[wild dove]; saŋ[head]; X
#etcsl: line-id=19

20. igi-gig-e igi-gig-me-en nu-mu-ni-be₂
#tr.en: No eye-diseases said there: @q[eye disease,self]{“I am the eye disease.”}
#lem: igigig[eye disease]; igigig[eye disease]; e[speak]
#etcsl: line-id=20

21. saŋ-gig-e saŋ-gig-me-en nu-mu-ni-be₂
#tr.en: No headache said there: @q[headache,self]{“I am the headache.”}
#lem: saŋgig[headache]; saŋgig[headache]; e[speak]
#etcsl: line-id=21

22. um-ma-bi um-ma-me-en nu-mu-ni-be₂
#tr.en: No old woman belonging to it said there: @q[old woman,self]{“I am an old woman.”}
#lem: umma[old woman]; umma[old woman]; e[speak]
#etcsl: line-id=22

23. ab-ba-bi ab-ba-me-en nu-mu-ni-be₂
#tr.en: No old man belonging to it said there: @q[old man,self]{“I am an old man.”}
#lem: abba[father]; abba[father]; e[speak]
#etcsl: line-id=23

24. ki-sikil a nu-tu₅-a-ni iri-a nu-mu-ni-ib-sig₁₀-ge
#tr.en: No maiden in her unwashed state …… in the city.
#lem: kisikil[young woman]; a[water]; tu[cvve]; iri[city]; sig[put into]
#etcsl: line-id=24

25. lu₂ id₂-da bal-e ŋi₆-de₃ nu-mu-ni-be₂
#tr.en: No man dredging a river said there: @q[man,self]{“It is getting dark.”}
#lem: lu[person]; id[river]; bala[turn]; ŋi[night]; e[speak]
#etcsl: line-id=25

26. niŋir-e zag-ga-na nu-um-niŋin₂-niŋin₂
#tr.en: No herald made the rounds in his border district.
#lem: niŋir[herald]; zag[side]; niŋin[encircle]
#etcsl: line-id=26

27. nar-e e-lu-lam nu-mu-ni-be₂
#tr.en: No singer sang an @fsux{elulam} there.
#lem: nar[musician]; elulam[song]; e[speak]
#etcsl: line-id=27

28. zag iri-ka i-lu nu-mu-ni-be₂
#tr.en: No wailings were wailed in the city's outskirts there.
#lem: zag[side]; iri[city]; ilu[lament]; e[speak]
#etcsl: line-id=28

29. {d}nin-sikil-la a-a-ni {d}en-ki-ra gu₃ mu-na-de₂-e
#tr.en: @wDN{Ninsikila} said to her father @wDN{Enki}: @q[Ninsikila,Enki]{“You have given a city. You have given a city. What does your giving avail me?
#lem: Ninsikila[1]DN; aya[father]; Enkik[1]DN; gu[voice]; de[pour]
#etcsl: line-id=29

30. iri mu-e-šum₂ iri mu-e-šum₂ nam-ŋu₁₀ šum₂-ma-zu
#tr.en: You have given a city, @wGN{Dilmun}. You have given a city.
#lem: iri[city]; šum[give]; iri[city]; šum[give]; nam[(a derivational morpheme used for making nouns from nouns]; šum[give]
#etcsl: line-id=30

31. dilmun iri mu-e-šum₂ iri <mu-e-šum₂ nam-ŋu₁₀ šum₂-ma-zu>
#tr.en: What does your giving avail me? You have given …….
#lem: Dilmun[1]GN; iri[city]; šum[give]; iri[city]; šum[give]; anam[what]; šum[give]
#etcsl: line-id=31

32. [X X] mu-e-šum₂ iri <mu-e-šum₂ nam-ŋu₁₀ šum₂-ma-zu>
#tr.en: You have given a city. What avails me your giving?”}
#lem: X; X; šum[give]; iri[city]; šum[give]; anam[what]; šum[give]
#etcsl: line-id=32

33. [iri kar] id₂-da nu-un-tuku-a
#tr.en: @q{“You have given ……, a city that has no river quay.
#lem: iri[city]; kar[harbor]; id[river]; tuku[acquire]
#etcsl: line-id=33

34. [X X] mu-e-šum₂ iri <mu-e-šum₂ nam-ŋu₁₀ šum₂-ma-zu>
#tr.en: You have given a city. What does your giving avail me?”}
#lem: X; X; šum[give]; iri[city]; šum[give]; anam[what]; šum[give]
#etcsl: line-id=34

