36. [iri a-šag₄] a-gar₃ [ab-sin₂ nu-un-tuku]-a
#tr.en: @q{“A city that has no fields, glebe or furrow”}
#lem: iri[city]; ašag[field]; agar[meadow]; absin[furrow]; tuku[acquire]
#etcsl: line-id=36

