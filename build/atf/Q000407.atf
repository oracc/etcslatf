#lem: Šulgir[1]RN; sipad[shepherd]; zid[right]; Kengir[1]
#tr.en: @wRN{Šulgi}, the good shepherd of @wGN{Sumer}, praised his brother and friend, Lord @wDN{Gilgameš}, in his might, and declared to him in his heroism: 
#etcsl: line-id=A.49

