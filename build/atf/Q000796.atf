&Q000796 = Proverbs: collection 2 + 6
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.6.1.02
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.6.1.02&display=Crit&charenc=gcirc#

@div segment A

@div proverb 2.1

A.2.1.1. ki gul-la-ba ki he₂-en-gul
#tr.en: @note{cf. @xref[t.6.1.07,t.6.1.07.1]{6.1.07.1}, @xref[t.6.2.1,]{6.2.1: Ni 9824 Seg. A ll. 1-2}, @xref[t.6.2.3,]{6.2.3: UET 6/2 356 ll. 3-8}} @q{“In those places which have been destroyed, let more places be destroyed.
#lem: ki[place]; gul[destroy]; ki[place]; gul[destroy]
#etcsl: line-id=A.2.1.1

#etcsl#cf cf. 6.1.07.1, 6.2.1: Ni 9824 Seg. A ll. 1-2, 6.2.3: UET 6/2 356 ll. 3-8

A.2.1.2. ki nu-gul-la-ba gu₂-ŋiri₃ he₂-en-ŋal₂
#tr.en: And in those places which have not been destroyed, let a breach be made there.
#lem: ki[place]; gul[destroy]; guŋiri[breach]; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=A.2.1.2

A.2.1.3. ki-ni ki lu-ub₂{sar} kud-da he₂-a
#tr.en: Let his place become like chopped-up turnips!”}
#lem: ki[place]; ki[place]; lub[turnip]; kud[cut]; me[be]
#etcsl: line-id=A.2.1.3

A.2.1.4. ŋarza-bi ŋiri₃ ba-da-kur₂
#tr.en: -- Their rituals were alienated.
#lem: ŋarza[rites]; ŋiri[foot]; kur[different]
#etcsl: line-id=A.2.1.4

A.2.1.5. di-ir-ga-a ki ba-e-gul
#tr.en: Where there were bonds, that place was destroyed.
#lem: dirga[bond]; ki[place]; gul[destroy]
#etcsl: line-id=A.2.1.5

A.2.1.6. me-bi ba-da-ha-lam
#tr.en: Their place in the universe was eradicated.
#lem: me[Being]; halam[forsake]
#etcsl: line-id=A.2.1.6

A.2.1.7. ŋarza-bi ŋiri₃ na-ab-ta-ab-kur₂-ru-de₃-en-ze₂-en
#tr.en: -- You should not alienate their rituals!
#lem: ŋarza[rites]; ŋiri[foot]; kur[different]
#etcsl: line-id=A.2.1.7

A.2.1.8. di-ir-ga-a ki nam-ba-e-gul-lu-de₃-en-ze₂-en
#tr.en: Where there are bonds, you should not destroy the place!
#lem: dirga[bond]; ki[place]; gul[destroy]
#etcsl: line-id=A.2.1.8

A.2.1.9. me-bi na-ab-ta-ab-ha-lam-e-en-ze₂-en
#tr.en: You should not eradicate their place in the universe.
#lem: me[Being]; halam[forsake]
#etcsl: line-id=A.2.1.9

A.2.1.10. gud-de₃ ki-gub-ba na-ab-ta-ab-kur₂-ru-de₃-en-ze₂-en
#tr.en: You should not move the oxen from their places!
#lem: gud[bull]; kigub[station]; kur[different]
#etcsl: line-id=A.2.1.10

@end proverb

@div proverb 2.2

A.2.2.11. nam-tar-ŋu₁₀ ga-am₃-dug₄ in-na-am₃
#tr.en: @note{cf. @xref[t.6.1.26,t.6.1.26.c10]{6.1.26.c10}, @xref[t.6.2.3,]{6.2.3: UET 6/2 292 ll. 1-2}} Let me tell you about my fate: it is an insult.
#lem: namtar[fate]; dug[speak]; in[abuse]
#etcsl: line-id=A.2.2.11

#etcsl#cf cf. 6.1.26.c10, 6.2.3: UET 6/2 292 ll. 1-2

A.2.2.12. pa ga-am₃-e₃ sulummar₂-am₃
#tr.en: Let me explain it to you: it is a disgrace.
#lem: pa[branch]; e[leave]; sulummar[slander]
#etcsl: line-id=A.2.2.12

@end proverb

@div proverb 2.3

A.2.3.13. nam-tar-ŋu₁₀ ušur-ŋa₂ ga-na-ab-dug₄
#tr.en: Were I to tell my neighbour about my fate,
#lem: namtar[fate]; usar[(female) neighbor]; dug[speak]
#etcsl: line-id=A.2.3.13

A.2.3.14. in-na ma-ŋa₂-ŋa₂
#tr.en: he would heap insults upon me.
#lem: in[abuse]; ŋar[put]
#etcsl: line-id=A.2.3.14

@end proverb

@div proverb 2.4

A.2.4.15. a-a igi i-ni-in-bar nam-tar-ŋu₁₀ ba-dib-ba
#tr.en: @note{cf. @xref[t.6.2.1,]{6.2.1: Ni 9824 Seg. A l. 4}} I looked into the water. My destiny was drifting past.
#lem: a[water]; igi[eye]; bar[place outside]; namtar[fate]; dib[pass]
#etcsl: line-id=A.2.4.15

#etcsl#cf cf. 6.2.1: Ni 9824 Seg. A l. 4

@end proverb

@div proverb 2.5

A.2.5.16. ud nam-tar gig-ga-ka ba-tu-ud-de₃-en
#tr.en: I was born on an ill-fated day.
#lem: ud[sun]; namtar[fate]; gig[sick]; utud[give birth (to)]
#etcsl: line-id=A.2.5.16

@end proverb

@div proverb 2.6

A.2.6.17. nam-tar-ŋu₁₀ gu₃-nam ama-ŋu₁₀ mu-da-an-kur₂
#tr.en: @note{cf. @xref[t.6.2.1,]{6.2.1: Ni 4300 Seg. A l. 4}} My fate is her voice: my mother can change it.
#lem: namtar[fate]; gu[voice]; ama[mother]; kur[different]
#etcsl: line-id=A.2.6.17

#etcsl#cf cf. 6.2.1: Ni 4300 Seg. A l. 4

@end proverb

@div proverb 2.7

A.2.7.18. zu-a ur₃-ra mu-un-ne-e-ed₃
#tr.en: An acquaintance has gone up onto the roof to them.
#lem: zu[know]; ur[roof]; ed[go up]
#etcsl: line-id=A.2.7.18

@end proverb

@div proverb 2.8

A.2.8.19. ušur ama-ŋu₁₀ e₂-a-na zi mu-un-di-ni-gi₄
#tr.en: The neighbour is on friendly terms with my mother in her house.
#lem: usar[(female) neighbor]; ama[mother]; e[house]; zi[life]; gi[turn]
#etcsl: line-id=A.2.8.19

@end proverb

@div proverb 2.9

A.2.9.20. nam nu-tar-re ki-gul-la gaba ba-an-ri#-[me-en]
#tr.en: I am one whose fate has not been determined, confronted by a waif.
#lem: nam[fate]; tar[cut]; kigula[destitute person]; gaba[breast]; ri[impose]
#etcsl: line-id=A.2.9.20

A.2.9.21. lu₂ kug la₂ zu-me-en igi-za ga-gub ma-an-dug₄-e-še
#tr.en: @q{“I will be the one who knows how to settle the account; let me take my position in front of you,”} she said to me.
#lem: lu[person]; kug[purify]; la[hang]; zu[know]; igi[eye]; gub[stand]; dug[speak]
#etcsl: line-id=A.2.9.21

@end proverb

@div proverb 2.10

A.2.10.22. nam nu-tar-re a₂-sag₃-e gaba ba-an-ri-me-en
#tr.en: I am one whose fate has not been determined, confronted by a sickness demon.
#lem: nam[fate]; tar[cut]; Asag[1]DN; gaba[breast]; ri[impose]
#etcsl: line-id=A.2.10.22

A.2.10.23. kug niŋ₂-gur₁₁ zu-me-en igi-za ga-gub ma-an-dug₄-e-še
#tr.en: @q{“I am one who knows wealth and possessions; let me take my position in front of you,”} he said to me.
#lem: kug[purify]; niŋgur[property]; zu[know]; igi[eye]; gub[stand]; dug[speak]
#etcsl: line-id=A.2.10.23

@end proverb

@div proverb 2.11

A.2.11.24. nam-tar ur-ra-am₃ zu₂ mu-un-da-an-kud
#tr.en: @note{cf. @xref[t.6.1.07,t.6.1.07.70]{6.1.07.70}} Fate is a dog -- well able to bite. Like dirty rags,
#lem: namtar[fate]; ur[dog]; zu[tooth]; kud[cut]
#etcsl: line-id=A.2.11.24

#etcsl#cf cf. 6.1.07.70

A.2.11.25. tug₂-mu-dur₇-ra-gin₇ im-ma-tab-tab
#tr.en: it clings, saying:
#lem: tugmudura[mourning garment]; tab[double]
#etcsl: line-id=A.2.11.25

A.2.11.26. a-ba-am₃ lu₂-ŋu₁₀ hu-mu-un-da-an-zu
#tr.en: @q{“Who is my man? Let him know it.”}
#lem: aba[who?]; lu[person]; zu[know]
#etcsl: line-id=A.2.11.26

@end proverb

@div proverb 2.12

A.2.12.27. nam-tar tug₂-ga-am₃ edin-na mu-un-na-an-la₂
#tr.en: Fate is a cloth stretched out in the desert for a man.
#lem: namtar[fate]; tug[textile]; eden[back]; la[hang]
#etcsl: line-id=A.2.12.27

@end proverb

@div proverb 2.13

A.2.13.28. nam-tar ud huš kalam-ma ri-a
#tr.en: Fate is a raging storm blowing over the Land.
#lem: namtar[fate]; ud[storm]; huš[reddish]; kalam[the Land (of Sumer)]; ri[impose]
#etcsl: line-id=A.2.13.28

@end proverb

@div proverb 2.14

A.2.14.29. (1:du-lum:1) ur-gir₁₅-ra-am₃ egir-ra-na mu-un-DU
#tr.en: @varh[t6102.v1]{Hard work } @vart[t6102.v2,]{@note{1 ms. has instead:} Fate } is a dog walking always behind a man.
#lem: dulum[toil]; urgir[(domestic) dog]; egir[back]; X
#etcsl: line-id=A.2.14.29

:29v.1.1: ($1 ms. has instead:$) nam-tar
?#tr.en: The poor man must always look to his next meal.
#lem: namtar[fate]

@end proverb

@div proverb 2.15

A.2.15.30. ukur₃-re niŋ₂ gu₇-u₃-da-ni-še₃ igi an-ši-du₃-du₃
#lem: ukur[poor]; niŋ[thing]; gu[eat]; igi[eye]; du[build]
#etcsl: line-id=A.2.15.30

@end proverb

@div proverb 2.16

A.2.16.31. ukur₃ bu-lu-uh₂ si-il-le# lu₂ niŋ₂-tuku-e igi tur nam-ba-e-gid₂-i
#tr.en: The belching poor man should not look scornfully at the rich man.
#lem: ukur[poor]; buluh[vomit]; sil[split]; lu[person]; niŋtuku[rich]; igi[eye]; tur[small]; gid[long]
#etcsl: line-id=A.2.16.31

@end proverb

@div proverb 2.17

A.2.17.32. ukur₃-re še ur₁₁-ru nu-mu-un-zu-a ziz₂ a-na ba-ur₁₁-ru
#tr.en: How can a poor man who doesn't know how to cultivate barley manage to cultivate wheat?
#lem: ukur[poor]; še[barley]; uru[sow]; zu[know]; ziz[emmer wheat]; ana[what?]; uru[sow]
#etcsl: line-id=A.2.17.32

@end proverb

@div proverb 2.18

A.2.18.33. ukur₃ nu-kal
#tr.en: The poor man is not appreciated.
#lem: ukur[poor]; kal[rare]
#etcsl: line-id=A.2.18.33

@end proverb

@div proverb 2.19

A.2.19.34. ukur₃-re niŋ₂ šu ti-a-ni zu₂ an-ur₅
#tr.en: The poor man chews whatever he is given.
#lem: ukur[poor]; niŋ[thing]; šu[hand]; teŋ[approach]; zu[tooth]; ur[cvve]
#etcsl: line-id=A.2.19.34

@end proverb

@div proverb 2.20

A.2.20.35. en-te-na-ka a-šag₄ nu-ur₁₁-ru
#tr.en: @note{cf. @xref[t.6.1.26,t.6.1.26.d4]{6.1.26.d4}} He didn't plough the field during winter.
#lem: enten[winter]; ašag[field]; uru[sow]
#etcsl: line-id=A.2.20.35

#etcsl#cf cf. 6.1.26.d4

A.2.20.36. ud# buru₁₄#-ka šu ga-rig₂ am₃-du₃-du₃-e
#tr.en: And at harvest time he turned his hand to carding.
#lem: ud[sun]; buru[harvest]; šu[hand]; garig[comb]; du[build]
#etcsl: line-id=A.2.20.36

@end proverb

@div proverb 2.21

A.2.21.37. [...] X X niŋ₂-na e₂ šar₂-ra [...] X X X BAR
#tr.en: …… incense burners …… a multitude of houses …….
#lem: X; X; X; niŋna[incense (burner)]; e[house]; šar[numerous]V/i; X; X; X; X; X
#etcsl: line-id=A.2.21.37

@end proverb

@div proverb 2.22

A.2.22.38. ukur₃-re al#-ŋal₂-la X X
#tr.en: @note{cf. @xref[t.6.1.17,t.6.1.17.b5]{6.1.17.b5}} When someone is poor ……,
#lem: ukur[poor]; ŋal[⟦be⟧ to be (there]; X; X
#etcsl: line-id=A.2.22.38

#etcsl#cf cf. 6.1.17.b5

A.2.22.39. tu₇ ubur#-ra bi₂-in-šu₂
#tr.en: they dine on the broth of the human breast.
#lem: tu[soup]; ubur[breast]; šuš[cover]
#etcsl: line-id=A.2.22.39

@end proverb

@div proverb 2.23

A.2.23.40. ukur₃-re dumu-ni tibir 1(DIŠ)-am₃ [šu nu-um-ma-ni-dug₄-ge]
#tr.en: @note{cf. @xref[t.6.1.17,t.6.1.17.b4]{6.1.17.b4}} The poor man does not strike his son a single blow;
#lem: ukur[poor]; dumu[child]; tibir[hand]; n; šu[hand]; dug[speak]
#etcsl: line-id=A.2.23.40

#etcsl#cf cf. 6.1.17.b4

A.2.23.41. gi₁₆-sa da-ri₂-še₃ nu-mu-[...]
#tr.en: he does not …… highly forever.
#lem: gilsa[treasure]; dari[eternal]; X
#etcsl: line-id=A.2.23.41

@end proverb

@div proverb 2.24

A.2.24.42. ukur₃-re niŋ₂-tuku-na sun₇-na [X X]
#tr.en: The poor man
#lem: ukur[poor]; niŋtuku[rich]; sun[authoritative]; X; X
#etcsl: line-id=A.2.24.42

A.2.24.43. [...] X X [X X]
#tr.en: …… arrogance toward his patron.
#lem: X; X; X; X; X
#etcsl: line-id=A.2.24.43

@end proverb

@div proverb 2.26

A.2.26.44. e₂-e₂ ukur₃#-ukur₃!-ra teš₂-e la-ba-gam-e
#tr.en: Not all the households of the poor will bow down together.
#lem: e[house]; ukur[poor]; teš[unity]; gurum[bend]
#etcsl: line-id=A.2.26.44

@end proverb

@div proverb 2.27

A.2.27.45. inim ukur₃-ra-še₃ šu la-ba-ši-in-ti
#tr.en: The word of a poor man is not accepted.
#lem: inim[word]; ukur[poor]; šu[hand]; teŋ[approach]
#etcsl: line-id=A.2.27.45

@end proverb

@div proverb 2.28

A.2.28.46. du-du nam-ukur₃-ra a₂ bi₂-ib-ŋar
#tr.en: @note{cf. @xref[t.6.1.02,t.6.1.02.34A]{2.34A}, @xref[t.6.1.22,]{6.1.22: l. 236}, @xref[t.6.2.3,]{6.2.3: UET 6/2 260 l. 1}} Moving about defeats poverty. He who knows how to move around becomes strong.
#lem: ŋen[go]; namukur[poverty]; a[arm]; ŋar[put]
#etcsl: line-id=A.2.28.46

#etcsl#cf cf. 2.34A, 6.1.22: l. 236, 6.2.3: UET 6/2 260 l. 1

A.2.28.47. lu₂ du-du zu in-kalag ugu lu₂ tuš-a nam-til₃ bi₂-ib-tah-e
#tr.en: He will live longer than the sedentary man.
#lem: lu[person]; ŋen[go]; zu[know]; kalag[strong]; ugu[skull]; lu[person]; tuš[sit (down)]; namtil[life]; tah[add]
#etcsl: line-id=A.2.28.47

@end proverb

@div proverb 2.29

A.2.29.48. ukur₃ a-na-am₃ al-tur-re
#tr.en: How lowly is the poor man!
#lem: ukur[poor]; ana[what?]; tur[small]
#etcsl: line-id=A.2.29.48

A.2.29.49. e₂-{na₄}kinkin-na gu₂ {im}šu-rin-na-ka
#tr.en: The area around the oven is a mill-house to him.
#lem: ekinkin[mill]; gu[neck]; šurin[oven]
#etcsl: line-id=A.2.29.49

A.2.29.50. tug₂ bir₇-ra-ni nu-kalag-ge-dam
#tr.en: His torn clothes will not be repaired.
#lem: tug[textile]; bir[shred]; kalag[strong]
#etcsl: line-id=A.2.29.50

A.2.29.51. niŋ₂ u₂-gu de₂-a-ni nu-mu-un-kiŋ₂-kiŋ₂-dam
#tr.en: That which he has lost will not be searched for.
#lem: niŋ[thing]; ugu[cvne]; de[pour]; kiŋ[seek]
#etcsl: line-id=A.2.29.51

@end proverb

@div proverb 2.30

A.2.30.52. ukur₃ ur₅-ra-am₃ al-tur-re
#tr.en: The poor man is this lowly:
#lem: ukur[poor]; ura[interest-bearing loan]; tur[small]
#etcsl: line-id=A.2.30.52

A.2.30.53. ka-ta kar-ra ur₅-ra ab-su-su
#tr.en: his debts are paid off with what is taken from his mouth.
#lem: kag[mouth]; kar[flee]; ura[interest-bearing loan]; sug[replace]
#etcsl: line-id=A.2.30.53

@end proverb

@div proverb 2.31

A.2.31.54. ukur₃ kug tukur₂
#tr.en: A poor man chewing at silver.
#lem: ukur[poor]; kug[metal]; tukur[chew]
#etcsl: line-id=A.2.31.54

@end proverb

@div proverb 2.32

A.2.32.55. ukur₃ si-ig kalam-ma-ka
#tr.en: The poor are the weak in the Land.
#lem: ukur[poor]; sig[weak]; kalam[the Land (of Sumer)]
#etcsl: line-id=A.2.32.55

@end proverb

@div proverb 2.33

A.2.33.56. gu₅-li ukur₃-ra-ka
#tr.en: It is the companion of the poor.
#lem: guli[friend]; ukur[poor]
#etcsl: line-id=A.2.33.56

A.2.33.57. niŋ₂ hu-hu-nu nu-mu-un-su-a-ka
#tr.en: It is the weakness of the widows.
#lem: niŋ[thing]; hunu[weak (of animals)]; numunkuš[widow]
#etcsl: line-id=A.2.33.57

@end proverb

@div proverb 2.34

A.2.34.58. muš₃-me ukur₃-ra-ka
#tr.en: The face of the poor man is set as though he
#lem: mušme[face]; ukur[poor]
#etcsl: line-id=A.2.34.58

A.2.34.59. gaba ud-da-kam i₃-tuš-tuš-u₃-de₃ i-ni-in-ŋar
#tr.en: were having to sit in the face of the storm.
#lem: gaba[breast]; ud[storm]; tuš[sit (down)]; ŋar[put]
#etcsl: line-id=A.2.34.59

@end proverb

@div proverb 2.34A

A.2.34A.60. du-du nam-ukur₃-re a₂ bi₂-ib₂-ŋar
#tr.en: @note{cf. @xref[t.6.1.02,t.6.1.02.28]{2.28}, @xref[t.6.1.22,]{6.1.22: l. 236}, @xref[t.6.2.3,]{6.2.3: UET 6/2 260 l. 1}} Moving about defeats poverty.
#lem: ŋen[go]; namukur[poverty]; a[arm]; ŋar[put]
#etcsl: line-id=A.2.34A.60

#etcsl#cf cf. 2.28, 6.1.22: l. 236, 6.2.3: UET 6/2 260 l. 1

@end proverb

@div proverb 2.35

A.2.35.61. lu₂ du-du-ra ninda ga-na-šum₂#
#tr.en: (A man speaks:) Were I to give food to the man who roves about,
#lem: lu[person]; du[go]; ninda[bread]; šum[give]
#etcsl: line-id=A.2.35.61

A.2.35.62. lu₂ nu-du-du-ra# me-ta ga-mu-na-ab-tum₃
#tr.en: how could I bring it to him who does not rove about?
#lem: lu[person]; du[go]; meta[where from? whence?]; tum[bring]
#etcsl: line-id=A.2.35.62

A.2.35.63. lu₂ %e di-di-ra %s ninda ga-na-ab-šum₂
#tr.en: (A woman speaks:) Were I to give food to the man who roves about,
#lem: lu[person]; de[go]; ninda[bread]; šum[give]
#etcsl: line-id=A.2.35.63

A.2.35.64. lu₂ %e nu-di-di-ra %s me-ta %e [da]-mu-na-i-ir
#tr.en: how could I bring it to him who does not rove about?
#lem: lu[person]; de[go]; meta[where from? whence?]; ir[bring]V/t
#etcsl: line-id=A.2.35.64

@end proverb

@div proverb 2.36

A.2.36.65. [...] šag₄# dub-ba [...]
#tr.en: …… a tablet
#lem: X; šag[heart]; dub[tablet]; X
#etcsl: line-id=A.2.36.65

A.2.36.66. dub-sar# ni₂-te#-a-ni# X X X [...]
#tr.en: …… a scribe himself …….
#lem: dubsar[scribe]; ni[self]; X; X; X; X
#etcsl: line-id=A.2.36.66

@end proverb

@div proverb 2.37

A.2.37.67. [dub-sar-me]-en mu ni₂-za nu-zu [igi ni₂-za] X-ge
#tr.en: @note{cf. @xref[t.6.1.11,t.6.1.11.146]{6.1.11.146}, @xref[t.6.2.3,]{6.2.3: UET 6/2 267 ll. 1-2}} You are a scribe and you do not know your own name? Shame (?) on you!
#lem: dubsar[scribe]; mu[name]; ni[self]; zu[know]; igi[eye]; ni[self]; X
#etcsl: line-id=A.2.37.67

#etcsl#cf cf. 6.1.11.146, 6.2.3: UET 6/2 267 ll. 1-2

@end proverb

@div proverb 2.38

A.2.38.68. [dub]-sar-re mu 1(DIŠ)-am₃ he₂-en-zu
