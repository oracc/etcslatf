#lem: ud[sun]; eš[shrine]; Agade[1]SN; kug[purify]; Inanak[1]DN
#tr.en: king of @wSN{Agade} -- at that time, 
#etcsl: line-id=1.7

1.8. ama₅ mah-a-ni-še₃ im-ma-an-du₃-du₃
#lem: emi[queen's household]; mah[great]; du[build]
#tr.en: holy @wDN{Inana} established the sanctuary of @wSN{Agade} as her celebrated woman's domain; 
#etcsl: line-id=1.8

1.9. ul-maš{ki}-a {ŋiš}gu-za ba-ni-in-gub
#lem: Ulmaš[1]SN; guza[chair]; gub[stand]
#tr.en: she set up her throne in @wSN{Ulmaš}. 
#etcsl: line-id=1.9

