#lem: e[house]; ki[place]; Unug[1]SN; gud[bull]; mah[great]; sahar[soil]; gaz[kill]
#tr.en: had slaughtered the house of the land of @wSN{Unug}  
#etcsl: line-id=1.3

1.4. ki ud-ba šar-ru-gen₆ lugal a-ga-de₃{ki}-ra
#lem: ki[place]; ud[sun]; Sargon[1]RN; lugal[king]; Agade[1]SN
#tr.en: in the dust as if it were a mighty bull, 
#etcsl: line-id=1.4

1.5. sig-ta igi-nim-še₃ {d}en-lil₂-le
#lem: sig[weak]; iginim[upper land]; Enlil[1]DN
#tr.en: and then @wDN{Enlil} had given the rulership and kingship  
#etcsl: line-id=1.5

1.6. nam-en nam-lugal-la mu-un-na-an-šum₂-ma-ta
#lem: namen[the office of en-priest]; namlugal[kingship]; šum[give]
#tr.en: from the south as far as the highlands to @wRN{Sargon}, 
#etcsl: line-id=1.6

