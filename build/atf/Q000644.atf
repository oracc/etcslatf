&Q000644 = A šir-namšub to Inana (Dumuzid-Inana M)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.4.08.13
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.4.08.13&display=Crit&charenc=gcirc#

@div segment A

A.1. u₄-ru-u₄-ru [...]
#lem: X; X
#tr.en: Belonging to @wDN{Inana} ……. 
#etcsl: line-id=A.1

A.2. %e aŋ₂ %e ga-ša-an-an-ka %s u₄-ru [...]
#lem: aŋ[thing]N; Gašanana[1]DN; X; X
#tr.en: Belonging to the gatherer (?) of divine powers ……. 
#etcsl: line-id=A.2

A.3. %e aŋ₂ %s me ur₃-ru# u₄-ru [...]
#lem: aŋ[thing]N; me[Being]; ur[gather]; X; X
#tr.en: Belonging to my good woman ……. 
#etcsl: line-id=A.3

A.4. %e aŋ₂ nu-nus %s zid-ŋu₁₀# [...]
#lem: aŋ[thing]N; nunus[woman]N; zid[right]; X
#tr.en: My good young woman ……. 
#etcsl: line-id=A.4

A.5. ki-sikil# zid-ŋu₁₀# [...]
#lem: kisikil[young woman]; zid[right]; X
#tr.en: Plenty …… @wDN{Dumuzid} ……. 
#etcsl: line-id=A.5

A.6. he₂-nun# [...] {d}dumu-zid-da# [...]
#lem: henun[plenty]; X; Dumuzid[1]DN; X
#tr.en: @wDN{Ušumgal-ana} ……. 
#etcsl: line-id=A.6

A.7. {d}ušumgal-an-na# [...]
#lem: Ušumgalana[1]DN; X
#tr.en: Belonging to the lady ……. 
#etcsl: line-id=A.7

A.8. %e aŋ₂ ga-ša-an %s gu [...]
#lem: aŋ[thing]N; gašan[lady]N; gu[cord]; X
#tr.en: @wDN{Ninegala} ……. 
#etcsl: line-id=A.8

A.9. %e ga-ša#-an-e₂-gal-la# [...]
#lem: Gašanegala[1]DN; X
#tr.en: 43=$ (@gap{1 line fragmentary} @gap{approx. 6 lines missing}) 
#etcsl: line-id=A.9

A.10. [...] X X IŠ [...]
#lem: X; X; X; X; X
#etcsl: line-id=A.10

$ (approx. 6 lines missing)
@end segment

@div segment B

B.1. [...] X X [...]
#lem: X; X; X; X
#tr.en: @gap{4 lines fragmentary}
#etcsl: line-id=B.1

B.2. [...] X GAN [...]
#lem: X; X; X; X
#etcsl: line-id=B.2

B.3. [...] X X [...]
#lem: X; X; X; X
#etcsl: line-id=B.3

B.4. [...] X X EN X [...]
#lem: X; X; X; X; X; X
#etcsl: line-id=B.4

@div trailer 

B.5. šir₃-nam-šub-ba-kam#
#lem: širnamšubak[subscript]
#tr.en: A @fsux{šir-namšub}. 
#etcsl: line-id=B.5

B.6. šir₃-nam-[šub ...]
#lem: širnamšubak[subscript]; X
#tr.en: A @fsux{širnamšub} of (?) ……. 
#etcsl: line-id=B.6

@end trailer

@end segment







