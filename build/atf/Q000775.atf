#lem: ne[strength]; ni[self]; e[house]; ušbar[father-in-law]; si[horn]; sa[equal]; ak[do]
#tr.en: Single-handed she keeps in order the house of her father-in-law. 
#etcsl: line-id=14

15. diŋir nin-a-ni-še₃ sun₅-na-še₃ gub-ba
#lem: diŋir[deity]; nin[lady]; sun[humble]; gub[stand]
#tr.en: She serves humbly before her divine mistress. 
#etcsl: line-id=15

