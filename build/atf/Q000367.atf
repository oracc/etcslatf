#etcsl: line-id=A.1

#etcsl#cite Cited in OB catalogue from Nibru, at Philadelphia, 0.2.01, line 38; OB catalogue in the Louvre, 0.2.02, line 22; OB catalogue from Urim (U2), 0.2.04, line 37

