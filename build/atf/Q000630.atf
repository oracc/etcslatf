&Q000630 = A šir-namšub to Inana (Inana I)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.4.07.9
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.4.07.9&display=Crit&charenc=gcirc#

@div segment A

A.1. %e ma-a-a %s u₅-ŋen-na X [X-ŋu₁₀-ne]
#lem: ma[ship]; u[ride]; X; X
#tr.en: When I …… as I travel by boat, 
#etcsl: line-id=A.1

A.2. %e ma-a-a %s u₅-ŋen-na sa#-[sa-ŋu₁₀-ne]
#lem: ma[ship]; u[ride]; sa[move about]
#tr.en: when I …… as I travel by boat, 
#etcsl: line-id=A.2

A.3. %e ga-ša-an-ŋen %s abzu-še₃ %e di-da-[ŋu₁₀-ne]
#lem: gašan[lady]N; abzu[(cosmic) underground water]; de[go]
#tr.en: when I, the queen, journey to the @fsux{abzu}, 
#etcsl: line-id=A.3

A.4. e₂  %e  {d}mu-ul-lil₂-la₂-še₃  %s  kur₉-ra-[ŋu₁₀-ne]
#lem: e[house]; Mullil[1]DN; kur[enter]
#tr.en: when I enter the house of @wDN{Enlil}, 
#etcsl: line-id=A.4

A.5. %e ga-ša-an %s kur-ra dirig-ga %e me-e-[ŋen-na]
#lem: gašan[lady]N; kur[mountain(s)]; dirig[make more than]; meʾe[I]
#tr.en: I am indeed the queen who is pre-eminent in the mountains. 
#etcsl: line-id=A.5

A.6. %e i-bi₂ %s  %e  {d}mu-ul-lil₂-la₂-še₃  %s  gub-ba-[ŋu₁₀-ne]
#lem: ibi[eye]N; Mullil[1]DN; gub[stand]
#tr.en: When I stand before the face of @wDN{Enlil}, 
#etcsl: line-id=A.6

A.7. ud zalag e₃-a %e me-e-[ŋen-na]
#lem: ud[sun]; zalag[bright]; e[leave]; meʾe[I]
#tr.en: I am indeed the emanating light. 
#etcsl: line-id=A.7

A.8. ka me₃-ka gub-ba-[ŋu₁₀-ne]
#lem: kag[mouth]; me[battle]; gub[stand]
#tr.en: When I stand in the mouth of the battle, 
#etcsl: line-id=A.8

A.9. maš₂-saŋ kur-kur-ra %e me-e %s ši-in-ga#-[ŋen-na]
#lem: mašsaŋ[leader]; kur[mountain(s)]; meʾe[I]IP; me[be]
#tr.en: I am indeed also the foremost one of all lands. 
#etcsl: line-id=A.9

A.10. murub₂ me₃-ka gub-ba-[ŋu₁₀-ne]
#lem: murub[middle]; me[battle]; gub[stand]
#tr.en: When I stand in the thick of the battle, 
#etcsl: line-id=A.10

A.11. lipiš me₃-a a₂ nam-ur-saŋ-ŋa₂ %e me-e %s ši-in#-[ga-ŋen-na]
#lem: lipiš[inner body]; me[battle]; a[arm]; namursaŋ[heroism]; meʾe[I]IP; me[be]
#tr.en: I am indeed also the very guts of battle, 
#etcsl: line-id=A.11

A.12. haš₂ me₃-ka %e di-da-[ŋu₁₀-ne]
#lem: haš[thigh]; me[battle]; de[go]
#tr.en: the heroic strength. When I walk about at the rear of the battle, 
#etcsl: line-id=A.12

A.13. mar-uru₅ ŠE₃ il₂-la %e me-e %s ši-in-[ga-ŋen-na]
#lem: marru[stormwind]; X; il[raise]; meʾe[I]IP; me[be]
#tr.en: I am indeed also the flood bearing ……. 
#etcsl: line-id=A.13

A.14. eŋer me₃-ka us₂-sa-[ŋu₁₀-ne]
#lem: egir[back]; me[battle]; us[accompany]
#tr.en: When I take my stand behind the battle, 
#etcsl: line-id=A.14

A.15. %e nu-nus %s du-a %e me-e{ba-e}-ŋen-[na]
#lem: nunus[woman]N; ŋen[go]; meʾe[I]
#tr.en: I am the woman who comes (?). 
#etcsl: line-id=A.15

A.16. e₂ kaš-a-ka tuš-a-[ŋu₁₀-ne]
#lem: e[house]; kaš[beer]; tuš[sit (down)]
#tr.en: When I sit in the alehouse, I am a woman, 
#etcsl: line-id=A.16

A.17. %e nu-nus-ŋen %s šul giri₁₇-zal-la %e me-e-ŋen-[na]
#lem: nunus[woman]N; šul[youth]; kirizal[joy]; meʾe[I]
#tr.en: and I am an exuberant young man. 
#etcsl: line-id=A.17

A.18. ki du₁₄! gub#-ba-ŋu₁₀-[ne]
#lem: ki[place]; dud[combat]; gub[stand]
#tr.en: When I am present at a place of quarrelling, 
#etcsl: line-id=A.18

A.19. munus dim₃-ma til₃-la %e me-e-ŋen-[na]
#lem: munus[woman]; dima[small object]; til[live (of a single person)]; meʾe[I]
#tr.en: I am a woman, a figurine brought to life. 
#etcsl: line-id=A.19

A.20. kan₄ eš₂-dam-ma-ka tuš-a-ŋu₁₀-[ne]
#lem: kan[gate]; ešdam[tavern]; tuš[sit (down)]
#tr.en: When I sit by the gate of the tavern, 
#etcsl: line-id=A.20

A.21. kar-ke₄ %e mu-lu mu!(NU) %s zu %e me-e-ŋen-[na]
#lem: karkid[prostitute]; mulu[person]N; meš[penis]; zu[know]; meʾe[I]
#tr.en: I am a prostitute familiar with the penis; 
#etcsl: line-id=A.21

A.22. %e mu-tin-na %s gu₅-li-ni munus-e ma-la-ga
#lem: mutin[male]; guli[friend]; munus[woman]; malag[female neighbor]
#tr.en: the friend of a man, the girlfriend of a woman. 
#etcsl: line-id=A.22

A.23. diŋir-ra ga-ŋen{mi} kur-ra dirig-ga-ŋen-[na]
#lem: diŋir[deity]; ga[milk]; kur[mountain(s)]; dirig[make more than]
#tr.en: I am milk of the god. I am pre-eminent in the mountains. 
#etcsl: line-id=A.23

A.24. diŋir-ra %e {d}du₅-mu-zid-da %s ga-ŋen{mi} kur-ra dirig-ga-ŋen-[na]
#lem: diŋir[deity]; Dumuzid[1]DN; ga[milk]; kur[mountain(s)]; dirig[make more than]
#tr.en: I am the milk of the god, of @wDN{Dumuzid}. 
#etcsl: line-id=A.24

A.25. kur šu-ŋu₁₀-še₃ kur %e me-ri-ŋu₁₀-[še₃]
#lem: kur[mountain(s)]; šu[hand]; kur[mountain(s)]; meri[foot]N
#tr.en: I am pre-eminent in the mountains. The mountains in my hands, 
#etcsl: line-id=A.25

A.26. elam{ki} šu-ŋu₁₀-še₃ [ŋiri₂] kiŋ₂#-a ur₂# ma-la-[ŋen]
#lem: Elam[1]GN; šu[hand]; ŋiri[dagger]; kiŋ[seek]; ur[loin]; malag[female neighbor]
#tr.en: the mountains at my feet, @wGN{Elam} in my hands; 
#etcsl: line-id=A.26

A.27. %e dim₃-me-er %s buru₅{mušen}-[me]-eš %e me-e %s mu-tin-[ŋen]
#lem: dimmer[deity]N; buru[sparrow]; meʾe[I]IP; surdu[falcon]
#tr.en: I have a pointed dagger in my belt. The gods are small birds, 
#etcsl: line-id=A.27

A.28. {d}a-nun-na du₇-du₇-me-eš %e me-e %s sumun₂-ŋen
#lem: Anunak[1]DN; du[push]; meʾe[I]IP; sumun[wild cow]
#tr.en: and I am the falcon. The @wDN{Anuna} gods butt each other, 
#etcsl: line-id=A.28

A.29. dumu mah-di-di  %e  {d}mu-ul-lil₂-la₂-[ŋen]  %s 
#lem: dumu[child]; mahdi[exalted]; Mullil[1]DN
#tr.en: but I am the wild cow. I am the grandiloquent daughter of @wDN{Enlil}. 
#etcsl: line-id=A.29

A.30. gal-di a-a-ŋu₁₀ {d}suen-na-[ŋen]
#lem: galdi[exalted]; aya[father]; Suen[1]DN
#tr.en: I am the formidable one of my father @wDN{Suen}. 
#etcsl: line-id=A.30

A.31. %e ga-ša-an-ŋen %s šu dug₄-ga {[d]}[nu-dim₂-mud-da-ŋen]
#lem: gašan[lady]N; šu[hand]; dug[speak]; Nudimmud[1]DN
#tr.en: I am the queen created by @wDN{Nudimmud}. 
#etcsl: line-id=A.31

A.32. %e i-bi₂-ŋu₁₀ %s il₂# [...]
#lem: ibi[eye]N; il[raise]; X
#tr.en: My eye ……. 
#etcsl: line-id=A.32

A.33. %e i-bi₂-ŋu₁₀ %s [...]
#lem: ibi[eye]N; X
#tr.en: My eye ……. 
#etcsl: line-id=A.33

A.34. X [...]
#lem: X; X
#etcsl: line-id=A.34

$ (unknown no. of lines missing)
@end segment

