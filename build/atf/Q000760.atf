#tr.en: fashioned by great strength, assembled by great hands,
#lem: ŋaʾe[I]; apin[(seed) plow]; a[arm]; gal[big]; dim[create]; šu[hand]; gal[big]; kešed[bind]
#etcsl: line-id=21

