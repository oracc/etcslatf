&Q000481 = A praise poem of Lipit-Eštar (Lipit-Eštar A)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.2.5.5.1
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.2.5.5.1&display=Crit&charenc=gcirc#

1. lugal mi₂ dug₄-ga šag₄-ta numun zid-me-en
#tr.en: I am a king treated with respect, good offspring from the womb.
#lem: lugal[king]; mi[cvne]; dug[speak]; šag[heart]; numun[seed]; zid[right]
#etcsl: line-id=1

#etcsl#cite Cited in OB catalogue from Nibru, at Philadelphia, 0.2.01, line 2; OB catalogue from Urim (U2), 0.2.04, line 5; OB catalogue at Andrews University, 0.2.11, line 8; OB catalogue at Yale, 0.2.12, Seg. A, line 2

2. {d}li-pi₂-it-eš₄-tar₂ dumu {d}en-lil₂-la₂-me-en
#tr.en: I am @wRN{Lipit-Eštar}, the son of @wDN{Enlil}.
#lem: Lipiteštar[1]RN; dumu[child]; Enlil[1]DN
#etcsl: line-id=2

3. {ŋiš}isimu₂{sar} {ŋiš}erin-na-gin₇ saŋ mu-il₂-la-ta
#tr.en: From the moment I lifted my head like a cedar sapling,
#lem: isimu[stalk]; eren[cedar]; saŋ[head]; il[raise]
#etcsl: line-id=3

4. nitah usu-tuku lirum-ma-me-en
#tr.en: I have been a man who possesses strength in athletic pursuits.
#lem: nita[male]; usutuku[strong]; lirum[strength]
#etcsl: line-id=4

5. nam-šul-la gu₂ gal peš-a-me-en
#tr.en: As a young man I grew very muscular (?).
#lem: namšul[manhood]; gu[neck]; gal[big]; peš[thick]
#etcsl: line-id=5

6. piriŋ (1:zag dib:1) gaba-ri nu-tuku-me-en
#tr.en: I am a lion @varh[t2551.v1]{in all respects } @vart[t2551.v2,t2551.v1]{@varn{3 mss. have instead:} to the extremes (?) }, having no equal.
#lem: piriŋ[lion]; zag[side]; dib[pass]; gabari[equal]; tuku[acquire]
#etcsl: line-id=6

:6v.1.1: ($3 mss. have instead:$) zag til
#lem: zag[side]; til[make complete]

7. ušumgal ka du₈-a ni₂ gal erin₂-na-me-en
#tr.en: I am a gaping dragon, a source of great awe for the soldiers.
#lem: ušumgal[great dragon]; kag[mouth]; du[spread]; ni[fear]; gal[big]; erin[people]
#etcsl: line-id=7

8. anzud{mušen} kur-šag₄-ga igi ŋal₂-me-en
#tr.en: I am like the Anzud bird, peering about in the heart of the mountains.
#lem: Anzud[1]DN; kuršag[center of the mountains]; igi[eye]; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=8

9. am su-ba saŋ nu-ŋa₂-ŋa₂-me-en
#tr.en: I am a wild bull whom nobody dare oppose in its anger.
#lem: am[wild bull]; su[flesh]; saŋ[head]; ŋar[put]
#etcsl: line-id=9

10. alim igi gun₃ šen-na-me-en
#tr.en: I am a bison, sparkling with beautiful eyes,
#lem: alim[bison]; igi[eye]; gunu[speckled]; šen[pure]
#etcsl: line-id=10

11. sun₄ {na₄}za-gin₃ e₃-a ŋir₂ keše₂-keše₂-du₃!-me-en
#tr.en: having a lapis-lazuli beard; I am …….
#lem: sum[beard]; zagin[lapis lazuli]; e[leave]; ŋir[flash]; kešed[bind]
#etcsl: line-id=11

12. igi sag₉ ka sag₉ šag₄ zal-le-me-en
#tr.en: With my kind eyes and friendly mouth, I lift people's spirits.
#lem: igi[eye]; sag[goodness]; kag[mouth]; sag[goodness]; šag[heart]; zal[pass time]
#etcsl: line-id=12

13. ulutim₂ huš-huš-a hi-li du₈-du₈-a-me-en
#tr.en: I have a most impressive figure, lavishly endowed with beauty.
#lem: uludin[form]; huš[reddish]; hili[attractiveness]; du[spread]
#etcsl: line-id=13

14. nundum inim-inim-ma he₂-du₇-me-en
#tr.en: I have lips appropriate for all words.
#lem: nundum[lip]; inim[word]; hedu[ornament]
#etcsl: line-id=14

15. a₂ il₂-la šu-si sag₉-sag₉-me-en
#tr.en: As I lift my arms, I have beautiful fingers.
#lem: a[arm]; il[raise]; šusi[finger]; sag[good]
#etcsl: line-id=15

16. šul sag₉-ga u₆ di dug₃-ga-me-en
#tr.en: I am a very handsome young man, fine to admire.
#lem: šul[youth]; sag[good]; u[admiration]; di[speak]; dug[good]
#etcsl: line-id=16

17. {d}li-pi₂-it-eš₄-tar₂ lugal kalam-ma-me-en
#tr.en: I am @wRN{Lipit-Eštar}, king of the Land.
#lem: Lipiteštar[1]RN; lugal[king]; kalam[the Land (of Sumer)]
#etcsl: line-id=17

18. saŋ gig₂-ga sipad zid-bi-me-en
#tr.en: I am the good shepherd of the black-headed.
#lem: saŋ[head]; giggig[black]; sipad[shepherd]; zid[right]
#etcsl: line-id=18

19. saŋ-kal kur-kur-ra kalam-ma il₂-la-me-en
#tr.en: I am the foremost in the foreign countries, and exalted in the Land.
#lem: saŋkal[foremost]; kur[mountain(s)]; kalam[the Land (of Sumer)]; il[raise]
#etcsl: line-id=19

20. diŋir nam-lu₂-ulu₃ nir-ŋal₂ uŋ₃ šar₂-ra-me-en
#tr.en: I am a human god, the lord of the numerous people.
#lem: diŋir[deity]; namlulu[humanity]; nirŋal[authoritative]; uŋ[people]; šar[numerous]V/i
#etcsl: line-id=20

21. ibila kalag-ga nam-lugal-la-me-en
#tr.en: I am the strong heir of kingship.
#lem: ibila[heir]; kalag[strong]; namlugal[kingship]
#etcsl: line-id=21

22. an-ta saŋ il₂-la ki-gub sig₁₀-ga-me-en
#tr.en: Holding my head high, I am established in my position.
#lem: an[sky]; saŋ[head]; il[raise]; kigub[station]; sig[put into]
#etcsl: line-id=22

23. išib an-na šu dadag-ga-me-en
#tr.en: I am @wDN{An's} purification priest with purified hands.
#lem: išib[purification priest]; an[sky]; šu[hand]; dadag[bright]
#etcsl: line-id=23

24. an-ne₂ aga zid mah saŋ-ŋa₂ mu-ni-in-ge-en
#tr.en: @wDN{An} placed the great and good crown firmly on my head.
#lem: An[1]DN; aga[tiara]; zid[right]; mah[great]; saŋ[head]; gin[confirm]
#etcsl: line-id=24

25. {d}en-lil₂-le dumu ki aŋ₂-ŋa₂-ni-me-en
#tr.en: @wDN{Enlil} gave the sceptre to me,
#lem: Enlil[1]DN; dumu[child]; ki[place]; aŋ[measure]
#etcsl: line-id=25

26. ki-ur₃-ra {ŋiš}ŋidru ma-ni-in-šum₂
#tr.en: his beloved son, in the @wTN{Ki-ur}.
#lem: Kiʾur[1]; ŋidru[scepter]; šum[give]
#etcsl: line-id=26

27. niŋ₂ ur₅ sag₉-sag₉ {d}nin-lil₂-la₂-me-en
#tr.en: I am what makes @wDN{Ninlil} happy:
#lem: niŋ[thing]; ur[liver]; sag[good]; Ninlil[1]DN
#etcsl: line-id=27

28. ŋa₂-ŋiš-šu₂-a-ka nam dug₃ mu-un-tar
#tr.en: she determined a good fate in the @wTN{Ŋa-ŋiš-šua}.
#lem: Ŋaŋiššua[1]TN; nam[fate]; dug[good]; tar[cut]
#etcsl: line-id=28

29. {d}nin-tur₅-re šeg₁₂ keš₃{ki}-a-ta
#tr.en: I have been made excellently beautiful by @wDN{Nintur},
#lem: Nintur[1]DN; šeg[brick]; Keš[1]SN
#etcsl: line-id=29

30. munus ul-la zid-de₃-eš gun₃-a-me-en
#tr.en: the joyful woman, in brick-built @wSN{Keš}.
#lem: munus[woman]; ul[swell]; zid[right]; gunu[speckled]
#etcsl: line-id=30

31. igi zid bar-ra {d}nanna-me-en
#tr.en: I am one looked on favourably by @wDN{Nanna}:
#lem: igi[eye]; zid[right]; bar[place outside]; Nanna[1]DN
#etcsl: line-id=31

32. urim₂{ki}-ma gu₃ zid-de₃-eš ma-an-de₂
#tr.en: he spoke to me affirmatively in @wSN{Urim}.
#lem: Urim[1]SN; gu[voice]; zid[right]; de[pour]
#etcsl: line-id=32

33. u₄-ta-u₁₈-lu lu₂ šag₄-ga-na-me-en
#tr.en: @wDN{Uta-ulu} imbued me, the man of his heart,
#lem: Utaʾulu[1]; lu[person]; šag[heart]
#etcsl: line-id=33

34. e₂-šu-me-ša₄-ta ni₂ gal mu-un-da-ri
#tr.en: with great awesomeness in @wTN{E-šu-me-ša}.
#lem: Ešumeša[1]TN; ni[fear]; gal[big]; ri[impose]
#etcsl: line-id=34

35. ŋeštug₂ ba₉-ra₂ {d}en-ki-kam-me-en
#tr.en: I am he on whom @wDN{Enki} has bestowed wisdom:
#lem: ŋeštug[ear]; bad[open]; Enkik[1]DN
#etcsl: line-id=35

36. eridug{ki}-ta nam-lugal ma-an-šum₂
#tr.en: he gave me kingship in @wSN{Eridug}.
#lem: Eridug[1]SN; namlugal[kingship]; šum[give]
#etcsl: line-id=36

37. nitalam ki aŋ₂ {d}inana-kam-me-en
#tr.en: As the beloved husband of @wDN{Inana},
#lem: ŋidlam[(equal ranking) spouse]; ki[place]; aŋ[measure]; Inanak[1]DN
#etcsl: line-id=37

38. ki unug{ki}-ga saŋ an-še₃ mi-ni-il₂
#tr.en: I lift my head high in the place @wSN{Unug}.
#lem: ki[place]; Unug[1]SN; saŋ[head]; an[sky]; il[raise]
#etcsl: line-id=38

39. dub-sar a-ra₂ zu {d}nisaba-kam-me-en
#tr.en: I am a proficient scribe of @wDN{Nisaba}.
#lem: dubsar[scribe]; ara[way]; zu[know]; Nisabak[1]DN
#etcsl: line-id=39

40. šul inim gen₆-na {d}utu-me-en
#tr.en: I am a young man whose word @wSN{Utu} confirms.
#lem: šul[youth]; inim[word]; gin[confirm]; Utu[1]DN
#etcsl: line-id=40

41. nam-lugal-la he₂-du₇-bi-me-en
#tr.en: I am the perfection of kingship.
#lem: namlugal[kingship]; hedu[ornament]
#etcsl: line-id=41

42. {d}li-pi₂-it-eš₄-tar₂ dumu {d}en-lil₂-la₂-me-en
#tr.en: I am @wRN{Lipit-Eštar}, @wDN{Enlil's} son.
#lem: Lipiteštar[1]RN; dumu[child]; Enlil[1]DN
#etcsl: line-id=42

43. buru₁₄ mah zig₃-ga zi kalam-ma-me-en
#tr.en: I am he who makes an abundant crop grow, the life of the Land.
#lem: buru[harvest]; mah[great]; zig[rise]; zi[life]; kalam[the Land (of Sumer)]
#etcsl: line-id=43

44. engar guru₇-ni dub-dub-ba-me-en
#tr.en: I am a farmer, piling up his grain piles.
#lem: engar[farmer]; guru[grain store]; dub[heap up]
#etcsl: line-id=44

45. sipad {e₂}tur₃-re i₃ ga mah-me-en
#tr.en: I am a shepherd making butter and milk abundant in the cow-pen.
#lem: sipad[shepherd]; tur[animal stall]; i[oil]; ga[milk]; mah[great]
#etcsl: line-id=45

46. ambar ku₆ mušen gal-gal-la-me-en
#tr.en: I am he who makes the fish and birds grow bigger in the marshes.
#lem: ambar[reed-bed]; kud[fish]; mušen[bird]; gal[big]
#etcsl: line-id=46

47. id₂ he₂-ŋal₂-la a zal-le tum₂-ma-me-en
#tr.en: I am a river of plenty, bringing flowing water.
#lem: id[river]; heŋal[plenty]; a[water]; zal[pass time]; tum[bring]
#etcsl: line-id=47

48. hur-saŋ gal giri₁₇-zal nun-na-me-en
#tr.en: I am he who increases the splendour of the great mountains.
#lem: hursaŋ[mountain]; gal[big]; kirizal[joy]; nun[prince]
#etcsl: line-id=48

49. a₂ mah šum₂-ma {d}en-lil₂-la₂-me-en
#tr.en: I have been given enormous strength by @wDN{Enlil}.
#lem: a[arm]; mah[great]; šum[give]; Enlil[1]DN
#etcsl: line-id=49

50. {d}li-pi₂-it-eš₄-tar₂ šul ni₂-tuku-ni-me-en
#tr.en: I am @wDN{Lipit-Eštar}, his young man who respects him.
#lem: Lipiteštar[1]RN; šul[youth]; nituku[pious]
#etcsl: line-id=50

51. diŋir-re-e-ne saŋ us₂-bi-me-en
#tr.en: I am the provider of the gods.
#lem: diŋir[deity]; saŋ[head]; us[accompany]
#etcsl: line-id=51

