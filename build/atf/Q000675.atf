#lem: anbar[mid-day]; Utu[1]DN; gub[stand]
#etcsl: line-id=8

9. a-a-ni inim#-ma-ni zid-da#
#tr.en: His father, whose word is true,
#lem: aya[father]; inim[word]; zid[right]
#etcsl: line-id=9

10. ud-de₃ ŋi₆-a inim# mu#-un-di-ni-ib₂-be₂
#tr.en: speaks with him day and night.
#lem: ud[sun]; ŋi[night]; inim[word]; e[speak]
#etcsl: line-id=10

11. {d}en-lil₂-le inim-[ma-ni] zid#-da
#tr.en: @wDN{Enlil}, whose word is true,
