#tr.en: cherished by the youth @wDN{Suen}, be praised!
#lem: ab[cow]; kug[purify]; Nanna[1]DN; mi[cvne]; dug[speak]; šul[youth]; Suen[1]DN; zamin[praise]
#etcsl: line-id=36

