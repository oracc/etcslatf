31. en-ra mu-un-i-i mu-un-ar₂-e-ne
#tr.en: They give praise to the lord,
#lem: en[lord]; e[bring out]; ar[celebrate]
#etcsl: line-id=31

32. ŋi₆-par₄-ra mu-ni-ib-sud-sud-u₃-ne
#tr.en: singing paeans (?) as they move into the @fsux{ŋipar} shrines.
#lem: ŋipar[cloister]; sud[distant]
#etcsl: line-id=32

33. šid gal-bi {d}nisaba-ke₄
#tr.en: @wDN{Nisaba} has taken their grand total; @wDN{Nisaba} has taken their count,
