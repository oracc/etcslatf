#lem: X; X; hili[attractiveness]; sud[distant]; Ekur[1]TN
#tr.en: …… whose seat (?) no other god ……! August ……, 
#etcsl: line-id=1.A.A.3

1.A.A.4. [...] MI# diŋir# gal#-gal-e-ne en gal mah an-na# [...]
#lem: X; X; diŋir[deity]; gal[big]; en[lord]; gal[big]; mah[great]; an[sky]; X
#tr.en: lord whose abode is the mountains, Father @wDN{Nanna} ……, 
#etcsl: line-id=1.A.A.4

