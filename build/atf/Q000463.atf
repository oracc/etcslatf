#lem: nam[fate]; tar[cut]; ara[way]; namenlil[Enlil-ship]; saŋ[head]; rig[donate]
#tr.en: He has presented you with the capacity to determine fates, the role of a supreme deity. 
#etcsl: line-id=1.B.D.4

