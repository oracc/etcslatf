@div kirugu E

A.E.18. ur-saŋ zid me-teš₂-e ga-i-i
#lem: ursaŋ[warrior]; zid[right]; meteš[praise]; e[bring out]
#tr.en: Trustworthy warrior, I will praise you! Lord @wDN{Lugal-era}, I will praise you! 
#etcsl: line-id=A.E.18

A.E.19. en {d}lugal-er₉-ra me-teš₂ ga-i-i
#lem: en[lord]; Lugalerra[1]; meteš[praise]; e[bring out]
#tr.en: You are the great and august neck-stock of the gods, 
#etcsl: line-id=A.E.19

A.E.20. {ŋiš}rab₃ gal mah diŋir-re-e-ne-me-en
#lem: raba[clamp]; gal[big]; mah[great]; diŋir[deity]
#tr.en: you are a great awesomeness resting heavily upon the Land, 
#etcsl: line-id=A.E.20

A.E.21. ni₂ gal kalam-ma ša-mu-ri-a-me-[en]
#lem: ni[fear]; gal[big]; kalam[the Land (of Sumer)]; ri[impose]
#tr.en: a heavy flood-wave covering the foreign land. Your river is a mighty river, 
#etcsl: line-id=A.E.21

A.E.22. ku-kur dugud kur-ra du₆-ul!(LU)-la-me-en
#lem: kurku[flood]; dugud[heavy]; kur[mountain(s)]; dul[cover]
#tr.en: the river which determines destinies, an august river where the sun rises, 
#etcsl: line-id=A.E.22

A.E.23. id₂-zu id₂ kalag-ga-am₃ id₂ nam tar-ra-am₃
#lem: id[river]; id[river]; kalag[strong]; id[river]; nam[fate]; tar[cut]
#tr.en: which nobody can bear to look upon. 
#etcsl: line-id=A.E.23

A.E.24. id₂ mah ki ud e₃ igi nu-bar-re-dam
#lem: id[river]; mah[great]; ki[place]; ud[sun]; e[leave]; igi[eye]; bar[place outside]
#tr.en: Great barge riding on the flood waters, 
#etcsl: line-id=A.E.24

A.E.25. ma₂-gur₈ mah a ku-kur-ra u₅-a
#lem: magur[barge]; mah[great]; a[water]; kurku[flood]; u[ride]
