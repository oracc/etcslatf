&Q000389 = Ur-Namma the canal-digger (Ur-Namma D)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.2.4.1.4
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.2.4.1.4&display=Crit&charenc=gcirc#

@div version 1 (A version from Nibru)

1.1. a-ba-a mu-un#-[ba]-al#-e a-ba-a mu-un-ba-al-e
#tr.en: Who will dig it? Who will dig it?
#lem: aba[who?]; bal[dig]; aba[who?]; bal[dig]
#etcsl: line-id=1.1

#etcsl#inc OB catalogue from Nibru (N4), 0.2.08, Seg. D, line 3

1.2. {id₂}asila-kug [a]-ba# mu-un-ba-al-e
#tr.en: Who will dig the @wWN{Asila-kug} canal?
#lem: Asilakug[1]WN; aba[who?]; bal[dig]
#etcsl: line-id=1.2

1.3. {id₂}pa₅-bi-[luh a]-ba mu-un-ba-al-e
#tr.en: Who will dig the @wWN{Pabi-luḫ} canal?
#lem: Pabiluh[1]WN; aba[who?]; bal[dig]
#etcsl: line-id=1.3

1.4. X ur#-{d#}[namma ...] tuku# mu-un-ba-al-e
#tr.en: …… @wRN{Ur-@wDN{Namma}} will dig it.
#lem: X; Urnamma[1]RN; X; tuku[acquire]; bal[dig]
#etcsl: line-id=1.4

1.5. [...] tuku# mu-un-ba-al-e
#tr.en: …… will dig it.
#lem: X; tuku[acquire]; bal[dig]
#etcsl: line-id=1.5

1.6. [...]-za {d}en-lil₂#-le [...] {d}dil-im₂-babbar
#tr.en: ……, …… @wDN{Ašimbabbar} you are on your …… because of @wDN{Enlil}.
#lem: X; Enlil[1]DN; X; Dilimbabbar[1]DN
#etcsl: line-id=1.6

1.7. [... a]-ra₂#-bi ku₆-<a> dal-bi mušen-a
#tr.en: The watercourse of …… is full of fish, and the air above is full of birds.
#lem: X; ara[way]; kud[fish]; dal[fly]; mušen[bird]
#etcsl: line-id=1.7

1.8. [...] a dug₃-bi ku₆-a [dal]-bi mušen-a
#tr.en: The fresh water of …… is full of fish, the air above is full of birds.
#lem: X; a[water]; dug[good]; kud[fish]; dal[fly]; mušen[bird]
#etcsl: line-id=1.8

1.9. [... u₂]-lal₃-a mu-un-du suhur#{ku₆} am₃-gur-gur
#tr.en: …… honey-plants are planted, and the carp grow fat.
#lem: X; ulal[plant]; du[build]; suhur[carp]; gur[thick]
#etcsl: line-id=1.9

1.10. [... u₂]-lal₃-a mu-un-du [suhur]{ku₆#} am₃-gur-gur
#tr.en: …… honey-plants are planted, and the carp grow fat.
#lem: X; ulal[plant]; du[build]; suhur[carp]; gur[thick]
#etcsl: line-id=1.10

1.11. [... gi]-zi-bi lal₃-am₃ ku₆ ha-ma-gu₇-e
#tr.en: The @fsux{gizi} reed of …… is so sweet that the fish eat them.
#lem: X; gizi[fresh reed]; lal[syrup]; kud[fish]; gu[eat]
#etcsl: line-id=1.11

1.12. [...] gi-zi-bi lal₃-am₃ ku₆ ha-ma-gu₇-e
#tr.en: The @fsux{gizi} reed of …… is so sweet that the fish eat them.
#lem: X; gizi[fresh reed]; lal[syrup]; kud[fish]; gu[eat]
#etcsl: line-id=1.12

1.13. [...]-ŋu₁₀# ki ŋar-ra-bi-ta ku₆ mušen sug₄-ga-am₃
#tr.en: Since my …… was founded, it is teeming with fish and birds.
#lem: X; ki[place]; ŋar[put]; kud[fish]; mušen[bird]; sug[full]
#etcsl: line-id=1.13

1.14. [...] X ki ŋar-ra-bi-ta ku₆ mušen sug₄-ga-am₃
#tr.en: Since …… was founded, it is teeming with fish and birds.
#lem: X; X; ki[place]; ŋar[put]; kud[fish]; mušen[bird]; sug[full]
#etcsl: line-id=1.14

1.15. [...]-bi# lugal eridug{ki}-ga uₓ(PA)#-a-zu sug₄-ga-am₃
#tr.en: Its …… is the master of @wSN{Eridug} -- your provider (?) @noteref{Ur-Namma} is exultant.
#lem: X; lugal[king]; Eridug[1]SN; ua[provisioner]; sug[full]
#etcsl: line-id=1.15

1.16. {[d]}[nu-dim₂]-mud lugal eridug{ki}-ga uₓ(PA)-a-zu sug₄-ga-am₃
#tr.en: @wDN{Nudimmud}, the master of @wSN{Eridug} -- your provider (?) is exultant.
#lem: Nudimmud[1]DN; lugal[king]; Eridug[1]SN; ua[provisioner]; sug[full]
#etcsl: line-id=1.16

1.17. [...] a dug₃ hu-mu-un-tum₂-mu {[ŋiš]}dusu-e ha-ma-la₂-e
#tr.en: May the fresh water bring ……; may they be carried in baskets to me.
#lem: X; a[water]; dug[good]; tum[bring]; dupsik[basket (for carrying earth and bricks)]; la[hang]
#etcsl: line-id=1.17

1.18. [...] X a dug₃ hu-mu-un-tum₂-mu {[ŋiš]}dusu-e ha-ma-la₂-e
#tr.en: May the fresh water bring ……; may they be carried in baskets to me.
#lem: X; X; a[water]; dug[good]; tum[bring]; dupsik[basket (for carrying earth and bricks)]; la[hang]
#etcsl: line-id=1.18

@end version

@div version 2 (A version of unknown provenance)

2.1. [a-ba-a mu-un]-ba#-al-e a-ba-a# mu#-[un-ba-al-e id₂] a-ba-a mu-un#-[ba-al-e]
#tr.en: Who will dig it? Who will dig it?
#lem: aba[who?]; bal[dig]; aba[who?]; bal[dig]; id[river]; aba[who?]; bal[dig]
#etcsl: line-id=2.1

2.2. {[id₂]}[keše₂-kug] a-ba-a mu-un-ba-[al-e] id₂# a-ba-a mu-un-ba-al-e
#tr.en: Who will dig the canal? Who will dig the @wWN{Keše-kug} canal?
#lem: Kešekug[1]WN; aba[who?]; bal[dig]; id[river]; aba[who?]; bal[dig]
#etcsl: line-id=2.2

2.3. {[id₂]}[pa₅-bi]-luh a-ba-a mu-un-ba-al-e id₂# a-ba-a mu-un-ba-al-e
#tr.en: Who will dig the canal? Who will dig the @wWN{Pabi-luḫ} canal?
#lem: Pabiluh[1]WN; aba[who?]; bal[dig]; id[river]; aba[who?]; bal[dig]
#etcsl: line-id=2.3

2.4. {d}ur-{d}namma kug tuku mu-un-ba-al-e
#tr.en: Who will dig the canal? Wealthy @wRN{Ur-@wDN{Namma}} will dig it.
#lem: Urnamma[1]RN; kug[purify]; tuku[acquire]; bal[dig]
#etcsl: line-id=2.4

2.5. šul zid niŋ₂-tuku# mu-un-ba-al-e#
#tr.en: The trustworthy, prosperous youth will dig it.
#lem: šul[youth]; zid[right]; niŋtuku[rich]; bal[dig]
#etcsl: line-id=2.5

2.6. lugal-ŋu₁₀ barag-za {d}en-lil₂-le en {d}dil-im₂-babbar
#tr.en: My king, Lord @wDN{Ašimbabbar}, you are on your throne because of @wDN{Enlil}.
#lem: lugal[king]; barag[sanctum]; Enlil[1]DN; en[lord]; Dilimbabbar[1]DN
#etcsl: line-id=2.6

2.7. šul {d}suen barag-za {d}en-lil₂-le en {d}dil-im₂-babbar
#tr.en: Youthful @wDN{Suen}, Lord @wDN{Ašimbabbar}, you are on your throne because of @wDN{Enlil}.
#lem: šul[youth]; Suen[1]DN; barag[sanctum]; Enlil[1]DN; en[lord]; Dilimbabbar[1]DN
#etcsl: line-id=2.7

2.8. lugal šag₄ zid-ta nam tar-ra nam-nir-ra saŋ il₂
#tr.en: I, the king, whose fate was already decreed in the true womb,
#lem: lugal[king]; šag[heart]; zid[right]; nam[fate]; tar[cut]; namnir[supremacy]; saŋ[head]; il[raise]
#etcsl: line-id=2.8

2.9. {d}ur-{d}namma šul igi il₂-la kur gal# {d}en-lil₂-le
#tr.en: who raises his head in authority, @wRN{Ur-@wDN{Namma}},
#lem: Urnamma[1]RN; šul[youth]; igi[eye]; il[raise]; kur[mountain(s)]; gal[big]; Enlil[1]DN
#etcsl: line-id=2.9

2.10. {d}nu-nam-nir-re ki-en-gi ki-uri-a# ŋe₂₆-e mu-un-suh-en
#tr.en: the youth who caught the eyes of the Great Mountain @wDN{Enlil},
#lem: Nunamnir[1]DN; Kengir[1]; Akkad[1 Akkad]; ŋaʾe[I]; suh[choose]
#etcsl: line-id=2.10

2.11. nibru{ki}-a hur-saŋ nam-til₃-la-ka# nam-ŋu₁₀ im-mi-in-tar
#tr.en: was chosen by @wDN{Nunamnir} in @wGN{Sumer} and @wGN{Akkad}.
#lem: Nibru[1]SN; hursaŋ[mountain]; namtil[life]; nam[fate]; tar[cut]
#etcsl: line-id=2.11

2.12. saŋ-ki zalag-ga-ni mu-un-ši-in-bar nam#-lugal ma!(BA)-an-šum₂#
#tr.en: He decreed my fate in @wSN{Nibru}, in the mountain of life.
#lem: saŋki[forehead]; zalag[bright]; bar[place outside]; namlugal[kingship]; šum[give]
#etcsl: line-id=2.12

2.13. urim₂{ki}-ma e₂-mud-kur-ra-ka
#tr.en: He beamed at me approvingly and bestowed the kingship on me.
#lem: Urim[1]SN; Emudkurak[1]TN
#etcsl: line-id=2.13

2.14. {ŋiš#}[gu]-za#-ŋa₂ suhuš-[bi ...]-ge#-en
#tr.en: In @wSN{Urim}, in the @wTN{E-mud-kura}, he made the foundation of my throne firm.
#lem: guza[chair]; suhuš[foundation]; X
#etcsl: line-id=2.14

2.15. ŋidru kug uŋ₃ šar₂ si# sa₂-sa₂#-e# šu#-[ŋa₂ ...]
#tr.en: He …… the holy sceptre to guide the numerous people in my hand.
#lem: ŋidru[scepter]; kug[purify]; uŋ[people]; šar[numerous]V/i; si[horn]; sa[equal]; šu[hand]; X
#etcsl: line-id=2.15

2.16. šibir ešgiri₂ uŋ₃ daŋal lu-a X he₂#-em#-[...]
#tr.en: He …… the staff and the shepherd's crook to …… the expanding and teeming people.
#lem: šibir[shepherd's staff]; ešgiri[staff]; uŋ[people]; daŋal[wide]; lu[abundant]; X; X
#etcsl: line-id=2.16

2.17. en {d}dil-im₂-babbar-ke₄# zi ud sud-sud# [...]
#tr.en: Lord @wDN{Ašimbabbar} …… a long-lasting life.
#lem: en[lord]; Dilimbabbar[1]DN; zi[life]; ud[sun]; sud[distant]; X
#etcsl: line-id=2.17

2.18. {d}en-lil₂-le# ub-da 4-ba X X [...]
#tr.en: @wDN{Enlil} …… of the four quarters of the world.
#lem: Enlil[1]DN; ub[corner]; n; X; X; X
#etcsl: line-id=2.18

2.19. mu da-ri₂ mu ka-ge ba-ab-du₇# [...]
#tr.en: He …… a lasting name, a name worthy to be praised.
#lem: mu[name]; dari[eternal]; mu[name]; kag[mouth]; du[perfect]; X
#etcsl: line-id=2.19

2.20. {d}en-ki-ke₄# ŋeštug₂ daŋal-la-ŋu₁₀# saŋ#-e-eš mu#-[rig₇]
#tr.en: @wDN{Enki} presented me with my broad wisdom.
#lem: Enkik[1]DN; ŋeštug[ear]; daŋal[wide]; saŋ[head]; rig[donate]
#etcsl: line-id=2.20

2.21. ŋe₂₆#-e iri{ki}-ŋa₂ id₂# he₂-ŋal₂-la# mu#-ba-al {id₂}keše₂-kug mu-sa₄
#tr.en: ln my city I dug a canal of abundance and named it the @wWN{Keše-kug} canal;
#lem: ŋaʾe[I]; iri[city]; id[river]; heŋal[plenty]; bal[dig]; Kešekug[1]WN; še[call by name]
#etcsl: line-id=2.21

2.22. urim₂{ki}-ma id₂# he₂-ŋal₂#-la mu-ba-al {id₂}keše₂#-kug mu-sa₄
#tr.en: in @wSN{Urim}, I dug a canal of abundance and named it the @wWN{Keše-kug} canal.
#lem: Urim[1]SN; id[river]; heŋal[plenty]; bal[dig]; Kešekug[1]WN; še[call by name]
#etcsl: line-id=2.22

2.23. mu da-ri₂ ka-ge ba-ab-du₇-am₃ {id₂}pa₅-bi-luh mušen-am₃
#tr.en: I named it the @wWN{Pabi-luḫ} canal, a lasting name worthy to be praised.
#lem: mu[name]; dari[eternal]; kag[mouth]; du[perfect]; Pabiluh[1]WN; mušen[bird]
#etcsl: line-id=2.23

