@div proverb 24.2

24.2.2. šah₂# [niga] ab#-šum-de₃ niŋ₂!# [i₃-gu₇-a-ŋu₁₀ ga-ab-sug₆-e-še]
#lem: šah[pig]; niga[fattened]; šum[slaughter]; niŋ[thing]; gu[eat]; sug[replace]
#tr.en: @note{cf. @xref[t.6.1.09,t.6.1.09.a12]{6.1.09.a12-13}, @xref[t.6.1.19,t.6.1.19.b1]{6.1.19.b1-2}, @xref[t.6.1.21,t.6.1.21.b4]{6.1.21.b4-5}, @xref[t.6.2.5,]{6.2.5: YBC 4677 ll. 1-4}} When a fattened pig is about to be slaughtered, one says @q{“I must replace what I eat.”} 
#etcsl: line-id=24.2.2

#etcsl#cf cf. 6.1.09.a12-13, 6.1.19.b1-2, 6.1.21.b4-5, 6.2.5: YBC 4677 ll. 1-4

24.2.3. šah₂-ze₂#-eh-tur-e šu# [al-gu₄-ud-gu₄-ud-de₃] sag₉-ga-aš-am₃ ŋe₂₆-e# [nu-gu₇-e-še]
#lem: šahzehtur[piglet]; šu[hand]; gud[jump (on)]; sag[good]; ŋaʾe[I]; gu[eat]
#tr.en: As the piglet snuffles around, it says @q{“I can no longer take pleasure in eating.”} 
#etcsl: line-id=24.2.3

@end proverb

@div proverb 24.3

24.3.4. e₂ gul-gul-e [kug i₃-gul-e]
#lem: e[house]; gul[destroy]; kug[metal]; gul[destroy]
#tr.en: @note{cf. @xref[t.6.1.02,t.6.1.02.135]{6.1.02.135}, @xref[t.6.1.19,t.6.1.19.b4]{6.1.19.b4}} He who annihilates a house destroys silver. 
#etcsl: line-id=24.3.4

#etcsl#cf cf. 6.1.02.135, 6.1.19.b4

24.3.5. e₂ gul-e kug-sig₁₇# [i₃-gul-e]
#lem: e[house]; gul[destroy]; kugsig[gold]; gul[destroy]
#tr.en: He who destroys a house destroys gold. 
#etcsl: line-id=24.3.5

@end proverb

@div proverb 24.4

24.4.6. dam %e u₃#-mu-un-si# %s gam-[am₃ geme₂ ug₅-ga-am₃]
#lem: dam[spouse]; umunsik[ruler]N; gurum[bend]; geme[female worker]; ug[kill]
#tr.en: @note{cf. @xref[t.6.1.09,t.6.1.09.a14]{6.1.09.a14}, @xref[t.6.1.19,t.6.1.19.b5]{6.1.19.b5}} The lord's wife kneels, the slave girl dies. 
#etcsl: line-id=24.4.6

#etcsl#cf cf. 6.1.09.a14, 6.1.19.b5

24.4.7. %e u₃-mu-un-si# %s gam-[am₃ arad ug₅-ga-am₃]
#lem: umunsik[ruler]N; gurum[bend]; arad[slave]; ug[kill]
#tr.en: The lord kneels, the slave dies. 
#etcsl: line-id=24.4.7

@end proverb

@div proverb 24.5

24.5.8. ga-gid₂ mu#-un-da#-[ku₅-ru šu-bi bar edin-na mu-da-an-DU]
#lem: gid[long]; kud[cut]; šu[hand]; bar[outside]; eden[back]; X
#tr.en: @note{cf. @xref[t.6.1.03,t.6.1.03.71]{6.1.03.71}, @xref[t.6.1.11,t.6.1.11.19]{6.1.11.19}, @xref[t.6.1.19,t.6.1.19.b6]{6.1.19.b6}} …… its hands …… to the edge of the desert. 
#etcsl: line-id=24.5.8

#etcsl#cf cf. 6.1.03.71, 6.1.11.19, 6.1.19.b6

@end proverb

@div proverb 24.6

24.6.9. im-ba am₃-ŋa₂-ŋa₂# [...]
#lem: imba[deficit]; ŋar[put]; X
#tr.en: There will be losses ……. 
#etcsl: line-id=24.6.9

24.6.10. ba-ab-ak i₃-[...]
#lem: ak[do]; X
#tr.en: It will be done ……. 
#etcsl: line-id=24.6.10

@end proverb

@div proverb 24.7

24.7.11. saŋ bul-e id₂#-[da bal-e]
#lem: saŋ[head]; bul[shake]; id[river]; bala[turn]
#tr.en: @note{cf. @xref[t.6.1.03,t.6.1.03.88]{6.1.03.88}, @xref[t.6.1.18,t.6.1.18.14]{6.1.18.14}} He who tosses his head succeeds in crossing the river. 
#etcsl: line-id=24.7.11

#etcsl#cf cf. 6.1.03.88, 6.1.18.14

@end proverb

@div proverb 24.8

24.8.12. {kuš}ummud zi# [lu₂-kam] {kuš}e-sir₂ [igi lu₂-kam]
#lem: ummud[waterskin]; zi[life]; lu[person]; esir[sandal(s)]; igi[eye]; lu[person]
#tr.en: @note{cf. @xref[t.6.1.19,t.6.1.19.c7]{6.1.19.c7}, @xref[t.6.1.21,t.6.1.21.c1]{6.1.21.c1}, @xref[t.6.1.23,t.6.1.23.18]{6.1.23.18}} A man's waterskin is his life. A man's sandals are his eyes. 
#etcsl: line-id=24.8.12

#etcsl#cf cf. 6.1.19.c7, 6.1.21.c1, 6.1.23.18

24.8.13. dam dim₄-ma lu₂#-[kam] dumu-nitah# ŋissu lu₂#-[kam]
#lem: dam[spouse]; dim[check]; lu[person]; dumunita[son]; ŋissu[shade]; lu[person]
#tr.en: A man's wife is his supervisor (?). A man's son is his protective shade. 
#etcsl: line-id=24.8.13

24.8.14. dumu-munus saŋ šu ŋar lu₂-kam e₂-gi₄-a gal₅-la₂ lu₂#-[kam]
#lem: dumumunus[daughter]; saŋ[head]; šu[hand]; ŋar[put]; lu[person]; egia[bride]; galla[policeman]; lu[person]
#tr.en: A man's daughter is his eager servant (?). A man's daughter-in-law is his policeman. 
#etcsl: line-id=24.8.14

@end proverb

@div proverb 24.9

24.9.15. {d}utu bar-ra šu he₂-en-ne#-[šu₂] ni₂-zu šu nu-zu-a kur₉#-ni-[ib]
#lem: Utu[1]DN; bar[outside]; šu[hand]; šuš[cover]; ni[self]; šu[hand]; zu[know]; kur[enter]
#tr.en: @note{cf. @xref[t.6.1.03,t.6.1.03.26]{6.1.03.26}, @xref[t.6.1.19,t.6.1.19.c2]{6.1.19.c2}} When the sun is setting outside so that you cannot see a hand in front of you, go inside! 
#etcsl: line-id=24.9.15

#etcsl#cf cf. 6.1.03.26, 6.1.19.c2

@end proverb

@div proverb 24.10

24.11.x. kaš %e ga-an-ze₂-eb-ba %s ušur!(UKUR₃) [nu]-mu#-un-kal-[e]
#lem: kaš[beer]; zeb[good]V/i; usar[(female) neighbor]; kal[rare]
#tr.en: @note{cf. @xref[t.6.1.21,t.6.1.21.c4]{6.1.21.c4}} I would make the beer sweet but my neighbour would not appreciate it. 
#etcsl: line-id=24.10.16

#etcsl#cf cf. 6.1.21.c4

@end proverb

