&Q000483 = An adab to An for Lipit-Eštar (Lipit-Eštar C)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.2.5.5.3
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.2.5.5.3&display=Crit&charenc=gcirc#

@div barsud A

A.1. [en] mah zag dib me galam u₁₈-ru
#lem: en[lord]; mah[great]; zag[side]; dib[pass]; me[Being]; galam[skilful]; urun[exalted]
#tr.en: The august lord, pre-eminent, 
#etcsl: line-id=A.1

A.2. pa#-bil₂-ga en-en-e-ne
#lem: pabilga[kinship term]; en[lord]
#tr.en: with the most complex divine powers, almighty grandfather of all the lords -- 
#etcsl: line-id=A.2

@div trailer 

A.3. bar-sud-am₃
#lem: barsud[musical notation]
#tr.en: @fsux{barsud}. 
#etcsl: line-id=A.3

@end trailer

@end barsud

@div šagbatuku B

B.4. saŋ il₂ dirig ninda₂ numun i-i
#lem: saŋ[head]; il[raise]; dirig[make more than]; ninda[breeding bull]; numun[seed]; e[bring out]
#tr.en: -- head high, surpassing everyone, breed-bull, who makes the seeds sprout, whose name is respected, spreading great terror, whose august commands cannot be countermanded, who is imbued with awesomeness on the mountain of pure divine powers, who has taken his seat on the great throne-dais, @wDN{An}, the king of the gods -- 
#etcsl: line-id=B.4

B.5. mu idim ni₂ gal-le-eš ri-a
#lem: mu[name]; idim[heavy]; ni[fear]; gal[big]; ri[impose]
#etcsl: line-id=B.5

B.6. mah dug₄-ga-ni sag₂ di nu-zu
#lem: mah[great]; dug[speak]; sag[scatter]; di[speak]; zu[know]
#etcsl: line-id=B.6

B.7. kur me sikil-la ni₂ mu-ni-in-guru₃
#lem: kur[mountain(s)]; me[Being]; sikil[pure]; ni[fear]; gur[lift]
#etcsl: line-id=B.7

B.8. barag gal-la dur₂ im-mi-in-ŋar
#lem: barag[sanctum]; gal[big]; dur[buttocks]; ŋar[put]
#etcsl: line-id=B.8

B.9. an lugal diŋir-re-e-ne-ke₄
#lem: An[1]DN; lugal[king]; diŋir[deity]
#etcsl: line-id=B.9

@div trailer 

B.10. šag₄-ba-tuku-am₃
#lem: šagbatuku[liturgical rubric]
#tr.en: @fsux{šagbatuku}. 
#etcsl: line-id=B.10

@end trailer

@end šagbatuku

@div šagbatuku C

C.11. igi zid su₃-ra₂-še₃ mu-un-ši-in-bar
#lem: igi[eye]; zid[right]; sud[distant]; bar[place outside]
#tr.en: -- has looked at him with long-lasting favour, 
#etcsl: line-id=C.11

C.12. nun {d}li-pi₂-it-eš₄-tar₂-ra igi zid mu-ši-in-bar
#lem: nun[prince]; Lipiteštar[1]RN; igi[eye]; zid[right]; bar[place outside]
#tr.en: has looked at prince @wRN{Lipit-@wDN{Eštar}} with favour. 
#etcsl: line-id=C.12

C.13. nam-til₃ su₃-ra₂-še₃ mu-na-an-šum₂
#lem: namtil[life]; sud[distant]; šum[give]
#tr.en: He has bestowed on him a long life, 
#etcsl: line-id=C.13

C.14. nun {d}li-pi₂-it-eš₄-tar₂-ra nam-til₃ <su₃-ra₂-še₃ mu-na-an-šum₂>
#lem: nun[prince]; Lipiteštar[1]RN; namtil[life]; sud[distant]; šum[give]
#tr.en: he has bestowed on prince @wRN{Lipit-@wDN{Eštar}} a long life. 
#etcsl: line-id=C.14

C.15. an-na dug₄-ga-ni inim ki-bi-še₃ ŋar-ra
#lem: An[1]DN; dug[speak]; inim[word]; ki[place]; ŋar[put]
#tr.en: The words of what @wDN{An} says are firmly established; 
#etcsl: line-id=C.15

C.16. diŋir na-me saŋ la-ba-ab-šum₂-mu
#lem: diŋir[deity]; name[any]; saŋ[head]; šum[give]
#tr.en: no god would oppose them. 
#etcsl: line-id=C.16

C.17. {d}a-nun-na diŋir kilib₃-ba-bi
#lem: Anunak[1]DN; diŋir[deity]; kilib[total]
#tr.en: At the place where the destinies are to be decided, 
#etcsl: line-id=C.17

C.18. ki nam tar-re-da gu₂ mu-na-si-si-eš
#lem: ki[place]; nam[fate]; tar[cut]; gu[neck]; si[fill]
#tr.en: all the @wDN{Anuna} gods gather around him. 
#etcsl: line-id=C.18

@div trailer 

C.19. šag₄-ba-tuku-am₃
#lem: šagbatuku[liturgical rubric]
#tr.en: @fsux{šagbatuku}. 
#etcsl: line-id=C.19

@end trailer

@end šagbatuku

@div barsud D

D.20. me gal-gal-la pa mu-ni-in-e₃
#lem: me[Being]; gal[big]; pa[branch]; e[leave]
#tr.en: He has made all the great divine powers manifest; 
#etcsl: line-id=D.20

D.21. diŋir an-na mu-na-sug₂-ge-eš
#lem: diŋir[deity]; an[sky]; sug[stand]
#tr.en: the gods of heaven stand around him. 
#etcsl: line-id=D.21

@div trailer 

D.22. bar-sud 2-kam-ma
#lem: barsud[musical notation]; n
#tr.en: 2nd @fsux{barsud}. 
#etcsl: line-id=D.22

@end trailer

@end barsud

@div sa-gida E

E.23. ŋiš-hur-bi si mu-ni-ib-sa₂-sa₂
#lem: ŋešhur[plan]; si[horn]; sa[equal]
#tr.en: He has implemented their divine plans properly; 
#etcsl: line-id=E.23

E.24. diŋir ki-a (1:mu-na-gam-e-eš:1)
#lem: diŋir[deity]; ki[place]; gurum[bend]
#tr.en: the gods of the earth @varh[t2553.v1]{submit themselves to  
#etcsl: line-id=E.24

:24v.1.1: ($1 ms. has instead:$) mu-na#-dur₂-ru-ne#-[eš]
#lem: durun[sit]

E.25. me mah-a me saŋ-ki-a-ba
#lem: me[Being]; mah[great]; me[Being]; saŋki[forehead]
#tr.en: him } @vart[t2553.v2,t2553.v1]{@varn{1 ms. has instead:} sit around him }. With august and foremost (?) divine powers, 
#etcsl: line-id=E.25

E.26. nam-lugal niŋ₂ kal-kal-la-am₃
#lem: namlugal[kingship]; niŋ[thing]; kal[rare]
#tr.en: great @wDN{An} has bestowed on @wRN{Lipit-@wDN{Eštar}}, 
#etcsl: line-id=E.26

E.27. {d}li-pi₂-it-eš₄-tar₂ dumu {d}en-lil₂-la₂-ra
#lem: Lipiteštar[1]RN; dumu[child]; Enlil[1]DN
#tr.en: son of @wDN{Enlil}, 
#etcsl: line-id=E.27

E.28. an gal-e saŋ-e-eš mu-ni-in-rig₇
#lem: An[1]DN; gal[big]; saŋ[head]; rig[donate]
#tr.en: a kingship which is very precious. 
#etcsl: line-id=E.28

@div trailer 

E.29. sa-<<bar>>-gid₂-da-am₃
#lem: sagida[musical notation]
#tr.en: @fsux{sa-gida}. 
#etcsl: line-id=E.29

@end trailer

@end sa-gida

@div ŋišgiŋal F

F.30. an gal-am₃ diŋir pa e₃ gal-am₃
#lem: An[1]DN; gal[big]; diŋir[deity]; pa[branch]; e[leave]; gal[big]
#tr.en: @wDN{An}, the great, the great god shining forth, @wDN{An}, 
#etcsl: line-id=F.30

F.31. an (1:u₁₈-ru:1) lugal {d}li-pi₂-it-eš₄-tar₂-ra ŋiškim-til₃-la-ni na-nam
#lem: An[1]DN; urun[exalted]; lugal[king]; Lipiteštar[1]RN; ŋeškimtil[trust]; me[be]
#tr.en: @varh[t2553.v3]{the almighty } @vart[t2553.v4,t2553.v3]{@varn{1 ms. has instead:} eminent }, is indeed the support of King @wRN{Lipit-@wDN{Eštar}}. 
#etcsl: line-id=F.31

:31v.1.1: ($1 ms. has instead:$) mah-di
#lem: mahdi[exalted]

@div trailer 

F.32. (1:ŋiš-gi₄-ŋal₂-bi-im:1)
#lem: ŋešgiŋal[musical refrain]
#tr.en: @varh[t2553.v5]{Its @fsux{ŋišgiŋal} } @vart[t2553.v6,t2553.v5]{@varn{1 ms. has instead:} Its @fsux{ŋišgiŋal} of the @fsux{sa-gida} }. 
#etcsl: line-id=F.32

:32v.1.1: ($1 ms. has instead:$) ŋiš-gi₄-ŋal₂ sa-gid₂-da-bi-im
#lem: ŋešgiŋal[musical refrain]; sagida[musical notation]

@end trailer

@end ŋišgiŋal

@div sa-ŋara G

G.33. an-e šag₄ gu₂-bi gi₄-a-na lugal mu-ni-in-pad₃
#lem: An[1]DN; šag[heart]; gu[neck]; gi[turn]; lugal[king]; pad[find]
#tr.en: In the overflowing of his heart, @wDN{An} has chosen him as king and blessed the royal descendant: 
#etcsl: line-id=G.33

G.34. šag₄-bal-bal nam-lugal-la-ra gu₃ zid mu-na-an-de₂
#lem: šabalbal[descendent]; namlugal[kingship]; gu[voice]; zid[right]; de[pour]
#tr.en: @q{“@wRN{Lipit-@wDN{Eštar}}, on whom I bestowed power, may you lift your head high! 
#etcsl: line-id=G.34

G.35. {d}li-pi₂-it-eš₄-tar₂ a₂ šum₂-ma-ŋu₁₀-me-en gu₂ an-še₃ he₂-zig₃
#lem: Lipiteštar[1]RN; a[arm]; šum[give]; gu[neck]; an[sky]; zig[rise]
#tr.en: May you spread fearsome radiance as if you were the front of a rising tempest! 
#etcsl: line-id=G.35

G.36. ud gu₃ di saŋ-bi zi-zi-gin₇ su zig₃ he₂-me-da-ri
#lem: ud[storm]; gu[voice]; di[speak]; saŋ[head]; zig[rise]; su[flesh]; zig[rise]; ri[impose]
#tr.en: May your storm cover the enemy territories, the disobedient countries! 
#etcsl: line-id=G.36

G.37. gu₂-erim₂-ŋal₂ kur nu-še-ga-zu u₁₈-lu-zu he₂-em-dul
#lem: guʾerimŋal[hostile]; kur[mountain(s)]; šeg[agree]; ulu[south wind]; dul[cover]
#tr.en: You have established justice in @wGN{Sumer} and @wGN{Akkad}, 
#etcsl: line-id=G.37

G.38. niŋ₂-si-sa₂ ki-en-gi ki-uri mu-ni-ŋar su kalam-ma mu-dug₃
#lem: niŋsisa[justice]; Kengir[1]; Akkad[1 Akkad]; ŋar[put]; su[flesh]; kalam[the Land (of Sumer)]; dug[good]
#tr.en: and made the Land feel content. 
#etcsl: line-id=G.38

G.39. {d}li-pi₂-it-eš₄-tar₂ dumu {d}en-lil₂-la₂ ud-gin₇ dalla he₂-ni-e₃
#lem: Lipiteštar[1]RN; dumu[child]; Enlil[1]DN; ud[sun]; dalla[(to be) bright]; e[leave]
#tr.en: @wRN{Lipit-@wDN{Eštar}}, son of @wDN{Enlil}, may you shine as brilliantly as the sunlight! 
#etcsl: line-id=G.39

G.40. iri a₂-dam maš-gana₂ ki ŋar-ra gu₃ teš₂ hu-mu-ra-ab-sig₁₀
#lem: iri[city]; adam[habitation]; mašgana[settlement]; ki[place]; ŋar[put]; gu[voice]; teš[unity]; sig[put into]
#tr.en: May concord be created under you in the established cities, settlements and dwellings! 
#etcsl: line-id=G.40

G.41. uŋ₃ saŋ gig₂-ga u₈-gin₇ lu-a us₂ zid hu-mu-ra-ab-sig₉-ge₅
#lem: uŋ[people]; saŋ[head]; giggig[black]; u[sheep]; lu[abundant]; us[accompany]; zid[right]; sig[put into]
#tr.en: May the black-headed people, numerous as flocks, follow the right path under you! 
#etcsl: line-id=G.41

G.42. {d}li-pi₂-<it-eš₄-tar₂> kur ki su₃-ra₂-še₃ lugal-bi he₂-me-en
#lem: Lipiteštar[1]RN; kur[mountain(s)]; ki[place]; sud[distant]; lugal[king]; me[be]
#tr.en: @wRN{Lipit-@wDN{Eštar}}, even in far-away foreign countries, you will be the king! 
#etcsl: line-id=G.42

G.43. {ŋiš}gu-za mah nam-nun-na he₂-du₇ gi₁₆-sa nam-lugal-la
#lem: guza[chair]; mah[great]; namnun[magnificence]; hedu[ornament]; gilsa[treasure]; namlugal[kingship]
#tr.en: @wDN{Enlil} has faithfully bestowed on you the princely august throne, 
#etcsl: line-id=G.43

G.44. {d}en-lil₂-le zid-de₃-eš ma-ra-an-šum₂ suhuš-bi hu-mu-ra-ab-sig₁₀
#lem: Enlil[1]DN; zid[right]; šum[give]; suhuš[foundation]; sig[put into]
#tr.en: the eternal ornament of kingship; he has made it firm for you. 
#etcsl: line-id=G.44

G.45. {d}suen aga saŋ-za mi-ni-in-ga-na muš₃ nam-ba-an-tum₂-mu
#lem: Suen[1]DN; aga[tiara]; saŋ[head]; gin[confirm]; muš[face]; tum[bring]
#tr.en: May you never cease to wear the crown that @wDN{Suen} has placed firmly on your head! 
#etcsl: line-id=G.45

G.46. {d}en-ki-ke₄ me nam-nun-na-ka še-er-ka-an hu-mu-<ra>-ni-in-dug₄
#lem: Enkik[1]DN; me[Being]; namnun[magnificence]; šerkan[ornament]; dug[speak]
#tr.en: @wDN{Enki} has adorned you with princely divine powers. 
#etcsl: line-id=G.46

G.47. {d}inana tug₂ nam-nun-na-ka za-e-da hu-mu-X-de₃-gub
#lem: Inanak[1]DN; tug[textile]; namnun[magnificence]; zaʾe[you]; gub[stand]
#tr.en: @wDN{Inana} escorts (?) you with the garment of princeship. 
#etcsl: line-id=G.47

G.48. {d}udug sag₉-ga {d}lamma e₂-kur-ra he₂-me-da-sug₂-sug₂-ge-eš
#lem: udug[demon]; sag[good]; lammar[(female) tutelary deity]; Ekur[1]TN; sug[stand]
#tr.en: The friendly guardians and the protecting genii of the @wTN{E-kur} stand by you. 
#etcsl: line-id=G.48

G.49. nidba {ŋiš}ŋeštin ga# il₂-la-zu šu he₂-em-da-ŋal₂-ŋal₂
#lem: nindaba[(food) offering]; ŋeštin[vine]; ga[milk]; il[raise]; šu[hand]; ŋal[⟦be⟧ to be (there]
#tr.en: May the food offerings, wine, and milk that you bring ……! 
#etcsl: line-id=G.49

G.50. dumu niŋ₂-dim₂-ma {[d]}en-lil₂-la₂-me-en niŋ₂ hu-<mu>-ra-ab-dug₃-dug₃
#lem: dumu[child]; niŋdimdima[form]; Enlil[1]DN; niŋ[thing]; dug[good]
#tr.en: Son and creature of @wDN{Enlil}, may everything be pleasant for you!”} 
#etcsl: line-id=G.50

