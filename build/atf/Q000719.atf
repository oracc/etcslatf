&Q000719 = A tigi to Nintur (Nintur A)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.4.26.1
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.4.26.1&display=Crit&charenc=gcirc#

@div sa-gida A

A.1. nin {d}a-ru-ru e₂ keš₃{ki}-a
#tr.en: Lady @wDN{Aruru} of the house @wSN{Keš}, born in the mountains, the pure place!
#lem: nin[lady]; Aruru[1]DN; e[house]; Keš[1]SN
#etcsl: line-id=A.1

A.2. hur-saŋ ki sikil-la u₃-tud-da
#tr.en: @wDN{Nintur}, supreme mother of all lands, Mother @wDN{Nintur}, Lady @wDN{Aruru} of the house @wSN{Keš},
#lem: hursaŋ[mountain]; ki[place]; sikil[pure]; utud[give birth (to)]
#etcsl: line-id=A.2

A.3. {d}nin-tur₅ ama mah kur-kur-ra-[ka]
#tr.en: born in the mountains, the pure place! @wDN{Nintur}, supreme mother of all lands,
#lem: Nintur[1]DN; ama[mother]; mah[great]; kur[mountain(s)]
#etcsl: line-id=A.3

A.4. ama {d}nin-tur₅ nin {d}a-ru-ru e₂ keš₃{ki}-a
#tr.en: has appeared with the hair-raising fearsomeness of a lion.
#lem: ama[mother]; Nintur[1]DN; nin[lady]; Aruru[1]DN; e[house]; Keš[1]SN
#etcsl: line-id=A.4

A.5. hur-saŋ ki sikil-la u₃-tud-da
#tr.en: She has given birth to the @fsux{en} priest, has given birth to the @fsux{lagar} priest.
#lem: hursaŋ[mountain]; ki[place]; sikil[pure]; utud[give birth (to)]
#etcsl: line-id=A.5

A.6. {d}nin-tur₅ ama mah kur-kur-ra-ka
#tr.en: On the holy throne-dais,
#lem: Nintur[1]DN; ama[mother]; mah[great]; kur[mountain(s)]
#etcsl: line-id=A.6

A.7. su zig₃ piriŋ-ŋa₂-ka ši-mi-ni-in-e₃
#tr.en: @wDN{Nintur} has given birth to the king.
#lem: su[flesh]; zig[rise]; piriŋ[lion]; e[leave]
#etcsl: line-id=A.7

A.8. en mu-un-u₃-tud lagar mu-un-u₃-tud
#tr.en: @wDN{Nintur} has appeared with the hair-raising fearsomeness of a lion.
#lem: en[priest]; utud[give birth (to)]; lagar[priest]; utud[give birth (to)]
#etcsl: line-id=A.8

A.9. lugal barag kug-ga {d}nin-tur₅-re bi₂-in-u₃-tud
#tr.en: She has given birth to the @fsux{en} priest,
#lem: lugal[king]; barag[sanctum]; kug[pure]; Nintur[1]DN; utud[give birth (to)]
#etcsl: line-id=A.9

A.10. {d}nin-tur₅ su zig₃ piriŋ-ŋa₂-ka ši-mi-ni-in-e₃
#tr.en: has given birth to the @fsux{lagar} priest.
#lem: Nintur[1]DN; su[flesh]; zig[rise]; piriŋ[lion]; e[leave]
#etcsl: line-id=A.10

A.11. [en] mu-un-u₃-tud lagar mu-un-u₃-tud
#tr.en: On the holy throne-dais,
#lem: en[priest]; utud[give birth (to)]; lagar[priest]; utud[give birth (to)]
#etcsl: line-id=A.11

A.12. lugal# barag kug-ga {d}nin-tur₅-re bi₂-in-u₃-tud
#tr.en: @wDN{Nintur} has given birth to the king.
#lem: lugal[king]; barag[sanctum]; kug[pure]; Nintur[1]DN; utud[give birth (to)]
#etcsl: line-id=A.12

A.13. [...] X ZU niŋ₂ saŋ-bi-še₃ e₃-a
#tr.en: @wDN{Nintur} has placed upon his head the …… that excels all;
#lem: X; X; X; niŋ[thing]; saŋ[head]; e[leave]
#etcsl: line-id=A.13

A.14. {[d]}nin#-tur₅-re saŋ-ŋa₂ ša-mi-ni-in-ŋal₂
#tr.en: ……,
#lem: Nintur[1]DN; saŋ[head]; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=A.14

A.15. [... hi]-li#-a tud ki us₂-sa
#tr.en: who has established giving birth in joy.
#lem: X; hili[attractiveness]; utud[give birth (to)]; ki[place]; us[accompany]
#etcsl: line-id=A.15

A.16. [ama] {[d]}nin-tur₅# X ZU niŋ₂ saŋ-bi-še₃ e₃-a
#tr.en: Mother @wDN{Nintur}, @wDN{Nintur},
#lem: ama[mother]; Nintur[1]DN; X; X; niŋ[thing]; saŋ[head]; e[leave]
#etcsl: line-id=A.16

A.17. {[d]}nin#-tur₅-<re> saŋ-ŋa₂ ša-mi-ni-in-[ŋal₂]
#tr.en: has placed upon his head the …… that excels all;
#lem: Nintur[1]DN; saŋ[head]; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=A.17

A.18. {[d]}[nin-tur₅] X hi-li-a tud ki us₂-sa
#tr.en: @wDN{Nintur}, who has established giving birth in joy.
#lem: Nintur[1]DN; X; hili[attractiveness]; utud[give birth (to)]; ki[place]; us[accompany]
#etcsl: line-id=A.18

@div trailer 

A.19. sa-gid₂-da-am₃
#tr.en: @fsux{Sa-gida}.
#lem: sagida[musical notation]
#etcsl: line-id=A.19

@end trailer

@end sa-gida

@div sa-ŋara B

B.20. [nin gaba]-ŋal₂ nam-nun an ki-a
#tr.en: Forceful lady with the nobility of heaven and earth,
#lem: nin[lady]; gabaŋal[forceful]; namnun[magnificence]; an[sky]; ki[place]
#etcsl: line-id=B.20

B.21. [...] {d}nin-tur₅ u₃-tud-da
#tr.en: …… born …… @wDN{Nintur}! ……,
#lem: X; Nintur[1]DN; utud[give birth (to)]
#etcsl: line-id=B.21

B.22. [...] abzu-ta nun-e ŋar-ra
#tr.en: which the prince has put in the @fsux{abzu},
#lem: X; abzu[(cosmic) underground water]; nun[prince]; ŋar[put]
#etcsl: line-id=B.22

B.23. kur gal {d}en-lil₂-da šu sa₂-a
#tr.en: she who has contended with the Great Mountain @wDN{Enlil}!
#lem: kur[mountain(s)]; gal[big]; Enlil[1]DN; šu[hand]; sa[equal]
#etcsl: line-id=B.23

B.24. {d}nin-tur₅ nin gaba-ŋal₂ nam-nun [an ki-a]
#tr.en: @wDN{Nintur}, forceful lady with the nobility of heaven and earth,
#lem: Nintur[1]DN; nin[lady]; gabaŋal[forceful]; namnun[magnificence]; an[sky]; ki[place]
#etcsl: line-id=B.24

B.25. [...] {d}nin-tur₅ u₃-[tud-da]
#tr.en: …… born …… @wDN{Nintur}!
#lem: X; Nintur[1]DN; utud[give birth (to)]
#etcsl: line-id=B.25

B.26. [...] abzu#-ta nun-e [ŋar-ra]
#tr.en: ……, which the prince has put in the @fsux{abzu},
#lem: X; abzu[(cosmic) underground water]; nun[prince]; ŋar[put]
#etcsl: line-id=B.26

B.27. [kur gal] {[d]}[en-lil₂-da šu sa₂-a]
#tr.en: she who has contended with the Great Mountain @wDN{Enlil}!
#lem: kur[mountain(s)]; gal[big]; Enlil[1]DN; šu[hand]; sa[equal]
#etcsl: line-id=B.27

B.28. [ab₂] amar#-bi-ta gu₃ nun mu-na-ab-be₂
#tr.en: The cow cries aloud to her about her calf and,
#lem: ab[cow]; amar[calf]; gu[voice]; nun[prince]; e[speak]
#etcsl: line-id=B.28

B.29. ama# {d}nin-tur₅-re i-lu-bi-ta mu-un-na-an-kiŋ₂-e
#tr.en: because of her distress, Mother @wDN{Nintur} looks for him,
#lem: ama[mother]; Nintur[1]DN; ilu[lament]; kiŋ[seek]
#etcsl: line-id=B.29

B.30. ama {d}nin-tur₅ nin mah keš₃{ki}-a
#tr.en: Mother @wDN{Nintur}, the august lady of @wSN{Keš},
#lem: ama[mother]; Nintur[1]DN; nin[lady]; mah[great]; Keš[1]SN
#etcsl: line-id=B.30

B.31. kur gal {d}en-lil₂-da šu sa₂-a
#tr.en: she who has contended with the Great Mountain @wDN{Enlil}.
#lem: kur[mountain(s)]; gal[big]; Enlil[1]DN; šu[hand]; sa[equal]
#etcsl: line-id=B.31

B.32. {d}nin-tur₅ ab₂ amar-bi-ta gu₃ nun mu-na-ab-be₂
#tr.en: The cow cries aloud to her about her calf and,
#lem: Nintur[1]DN; ab[cow]; amar[calf]; gu[voice]; nun[prince]; e[speak]
#etcsl: line-id=B.32

B.33. [ama] {[d]}[nin-tur₅-re i-lu-bi-ta mu]-un#-na-kiŋ₂-e
#tr.en: because of her distress, @wDN{Nintur} -- Mother @wDN{Nintur} -- looks for him,
#lem: ama[mother]; Nintur[1]DN; ilu[lament]; kiŋ[seek]
#etcsl: line-id=B.33

B.34. ama {d}nin-tur₅ nin mah keš₃{ki}-a
#tr.en: Mother @wDN{Nintur}, the august lady of @wSN{Keš},
#lem: ama[mother]; Nintur[1]DN; nin[lady]; mah[great]; Keš[1]SN
#etcsl: line-id=B.34

B.35. kur gal {d}en-lil₂-da šu sa₂-a
#tr.en: she who has contended with the Great Mountain @wDN{Enlil}.
#lem: kur[mountain(s)]; gal[big]; Enlil[1]DN; šu[hand]; sa[equal]
#etcsl: line-id=B.35

B.36. <ki>-tuš kug giri₁₇-zal-la ki-tuš niŋ₂ lu-lu-a
#tr.en: When Mother @wDN{Nintur} sat upon the throne-dais on the holy seat of joy,
#lem: kituš[dwelling place]; kug[purify]; kirizal[joy]; kituš[dwelling place]; niŋ[thing]; lu[abundant]
#etcsl: line-id=B.36

B.37. ama {d}nin-tur₅ barag tuš-a-ni
#tr.en: the seat from which she has made everything numerous, it was then that the highest divine powers,
#lem: ama[mother]; Nintur[1]DN; barag[sanctum]; tuš[sit (down)]
#etcsl: line-id=B.37

B.38. me mah kug-sig₁₇-ga-am₃ me-te uŋ₃ lu-a
#tr.en: which are golden,
#lem: me[Being]; mah[great]; kugsig[gold]; mete[appropriate thing]; uŋ[people]; lu[abundant]
#etcsl: line-id=B.38

B.39. nam-en nam-lugal {d}en-lil₂-še₃ ŋal₂-la
#tr.en: the glory of the numerous people -- the @fsux{en} priesthood and the kingship -- were created for @wDN{Enlil}.
#lem: namen[the office of en-priest]; namlugal[kingship]; Enlil[1]DN; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=B.39

B.40. {d}nin-tur₅ ki-tuš [giri₁₇]-zal-la ki-tuš niŋ₂ lu-lu-a
#tr.en: When @wDN{Nintur}, Mother @wDN{Nintur}, sat upon the throne-dais on the seat of joy,
#lem: Nintur[1]DN; kituš[dwelling place]; kirizal[joy]; kituš[dwelling place]; niŋ[thing]; lu[abundant]
#etcsl: line-id=B.40

B.41. ama {d}nin-tur₅ barag tuš-a-ni
#tr.en: the seat from which she has made everything numerous, it was then that the highest divine powers,
#lem: ama[mother]; Nintur[1]DN; barag[sanctum]; tuš[sit (down)]
#etcsl: line-id=B.41

B.42. me mah kug-sig₁₇ me-te uŋ₃ lu-a
#tr.en: which are golden,
#lem: me[Being]; mah[great]; kugsig[gold]; mete[appropriate thing]; uŋ[people]; lu[abundant]
#etcsl: line-id=B.42

B.43. [nam]-en nam-lugal {d}en-lil₂-še₃ ŋal₂-la
#tr.en: the glory of the numerous people -- the @fsux{en} priesthood and the kingship -- were created for @wDN{Enlil}.
#lem: namen[the office of en-priest]; namlugal[kingship]; Enlil[1]DN; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=B.43

@div trailer 

B.44. sa-ŋar-ra-am₃
#tr.en: @fsux{Sa-ŋara}.
#lem: saŋara[musical notation]
#etcsl: line-id=B.44

@end trailer

@end sa-ŋara

@div trailer 

B.45. tigi {[d]}nin-tur₅-ra-kam
#tr.en: A @fsux{tigi} of @wDN{Nintur}.
#lem: tigi[drum or other musical instrument]; Nintur[1]DN
#etcsl: line-id=B.45

