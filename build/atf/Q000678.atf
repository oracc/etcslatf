#tr.en: where have you tended the people, Lord @wDN{Ašimbabbar}?”}
#lem: dumusaŋ[first-born]; Enlil[1]DN; uŋ[people]; mea[where?]; lu[abundant]; en[lord]; Dilimbabbar[1]DN
#etcsl: line-id=B.21

