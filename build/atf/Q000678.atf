&Q000678 = A tigi to Suen (Nanna I)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.4.13.09
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.4.13.09&display=Crit&charenc=gcirc#

@div sa-gida A

A.1. lugal-ŋu₁₀ sug-ga-na mu-un-X
#tr.en: My king …… in his reed marshes.
#lem: lugal[king]; sug[reed-bed]; X
#etcsl: line-id=A.1

A.2. e-ne sug sig₉-ga mu-un-X X X
#tr.en: He …… in the silent (?) reed marshes.
#lem: ane[he]; sug[reed-bed]; sig[put into]; X; X; X
#etcsl: line-id=A.2

A.3. sug gal sug muš-a e₂-a-ni ba-ni-in-la₂
#tr.en: He extended his house over a huge reed marsh,
#lem: sug[reed-bed]; gal[big]; sug[reed-bed]; muš[snake]; e[house]; la[hang]
#etcsl: line-id=A.3

A.4. X X sig₇-ga-bi na-nam AB KA a ba-du₃
#tr.en: over a …… reed marsh. Its …… is green (?);
#lem: X; X; sissig[green-yellow]; me[be]; X; X; a[water]; du[build]
#etcsl: line-id=A.4

A.5. iri-ni eš₃ urim₂{ki} mu-še₃ ba-an-sa₄
#tr.en: he has built …… by the water.
#lem: iri[city]; eš[shrine]; Urim[1]SN; mu[name]; še[call by name]
#etcsl: line-id=A.5

A.6. en ud su₃-ra₂-ke₄ iri-ni-ta
#tr.en: He called his city the shrine @wSN{Urim}. In his city,
#lem: en[lord]; ud[sun]; sud[distant]; iri[city]
#etcsl: line-id=A.6

A.7. {d}suen-e dur₂ ki ba-ni-in-ŋar
#tr.en: the lord of the long days, @wDN{Suen}, founded a dwelling-place.
#lem: Suen[1]DN; dur[buttocks]; ki[place]; ŋar[put]
#etcsl: line-id=A.7

A.8. urim₂{ki} iri šag₄-ge pad₃-da-na
#tr.en: In @wSN{Urim}, the city chosen in his heart,
#lem: Urim[1]SN; iri[city]; šag[heart]; pad[find]
#etcsl: line-id=A.8

A.9. e₂ gud-gin₇ ar₂ im-me
#tr.en: bull-like the house gives praise.
#lem: e[house]; gud[bull]; ar[celebrate]; dug[speak]
#etcsl: line-id=A.9

A.10. lugal-ŋu₁₀ ki girin-na-ni
#tr.en: My king's splendid place is indeed an august place,
#lem: lugal[king]; ki[place]; girim[flower]
#etcsl: line-id=A.10

A.11. ki mah ki kal-kal he₂-en-na-nam-ma-am₃
#tr.en: a most precious place. @wDN{Suen} …… his beloved city,
#lem: ki[place]; mah[great]; ki[place]; kal[rare]; me[be]
#etcsl: line-id=A.11

A.12. {d}suen-e iri ki aŋ₂-ŋa₂-ni
#tr.en: the shrine @wSN{Urim},
#lem: Suen[1]DN; iri[city]; ki[place]; aŋ[measure]
#etcsl: line-id=A.12

A.13. eš₃ urim₂{ki} me kug-kug-ga iri-ni X X
#tr.en: the pure divine powers …… his city.
#lem: eš[shrine]; Urim[1]SN; me[Being]; kug[pure]; iri[city]; X; X
#etcsl: line-id=A.13

A.14. lugal-ŋu₁₀ barag kug X UD X [...]
#tr.en: My king …… the holy dais.
#lem: lugal[king]; barag[sanctum]; kug[purify]; X; X; X; X
#etcsl: line-id=A.14

A.15. en {d}dil-im₂-babbar U₃ X X ŋar-ra X
#tr.en: Lord @wDN{Ašimbabbar} …….
#lem: en[lord]; Dilimbabbar[1]DN; X; X; X; ŋar[put]; X
#etcsl: line-id=A.15

@div trailer 

A.16. sa-gid₂-da-am₃
#tr.en: @fsux{Sa-gida}.
#lem: sagida[musical notation]
#etcsl: line-id=A.16

@end trailer

@end sa-gida

@div sa-ŋara B

B.17. e {d}nanna {d}nanna ab₂-zu me-a mu-u₈-lu en {d}dil-im₂-babbar
#tr.en: @q[,Suen]{“O @wDN{Nanna}, @wDN{Nanna},
#lem: e[vocative interjection]; Nanna[1]DN; Nanna[1]DN; ab[cow]; mea[where?]; lu[abundant]; en[lord]; Dilimbabbar[1]DN
#etcsl: line-id=B.17

B.18. iri igi il₂ eš₃ šag₄ ŋal₂ ul ti-a i₃-ra
#tr.en: where have you tended your cows, Lord @wDN{Ašimbabbar}?”}
#lem: iri[city]; igi[eye]; il[raise]; eš[shrine]; šag[heart]; ŋal[⟦be⟧ to be (there]; ul[swell]; teŋ[approach]; rah[beat]
#etcsl: line-id=B.18

B.19. aratta-gin₇-nam [...] gud-e ŋal₂-la-bi
#tr.en: @q[Suen,]{“In the chosen city, the shrine of my heart which I have founded in joy like @wSN{Aratta} …….
#lem: Aratta[1]GN; X; gud[bull]; ŋal[⟦be⟧ to be (there]
#etcsl: line-id=B.19

B.20. eš₃-e urim₂{ki}-ŋu₁₀ [ab₂]-ŋu₁₀ ba-ši-in-lu
#tr.en: In my shrine @wSN{Urim} I have tended my cows.”} @q[,Suen]{“First-born son of @wDN{Enlil},
#lem: eš[shrine]; Urim[1]SN; ab[cow]; lu[abundant]
#etcsl: line-id=B.20

