&Q000795 = Proverbs: collection 1
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.6.1.01
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.6.1.01&display=Crit&charenc=gcirc#

@div segment A

@div proverb 1.1

A.1.1.1. niŋ₂-gen₆-na-da a-ba in-da-sa₂ nam-til₃ i₃-u₃-tud
#lem: niŋgina[truth]; aba[who?]; sa[equal]; namtil[life]; utud[give birth (to)]
#tr.en: @note{cf. @xref[t.6.2.3,]{6.2.3: UET 6/2 291 ll. 1-2}, @xref[t.6.2.5,]{6.2.5: YBC 8713 ll. 1-2}} Who can compete with righteousness? It creates life. 
#etcsl: line-id=A.1.1.1

#etcsl#cf cf. 6.2.3: UET 6/2 291 ll. 1-2, 6.2.5: YBC 8713 ll. 1-2

@end proverb

@div proverb 1.2

A.1.2.2. niŋ₂-erim₂-e a₂-bi he₂-bi₂-ib₂-kuš₂-u₃ {d}utu me-da tum₃
#lem: niŋerim[evil]; a[arm]; kušu[tired]; Utu[1]DN; meta[where from? whence?]; tum[bring]
#tr.en: @note{cf. @xref[t.6.2.3,]{6.2.3: UET 6/2 291 l. 3}, @xref[t.6.2.5,]{6.2.5: YBC 8713 l. 3}} If wickedness exerts itself, how will @wDN{Utu} succeed? 
#etcsl: line-id=A.1.2.2

#etcsl#cf cf. 6.2.3: UET 6/2 291 l. 3, 6.2.5: YBC 8713 l. 3

@end proverb

@div proverb 1.3

A.1.3.3. niŋ₂ gu₂ kud-ku₅-ra₂ gu₂ nam-ba-e-ku₅-re₆
#lem: niŋ[thing]; gu[neck]; kud[cut]; gu[neck]; kud[cut]
#tr.en: You should not cut the throat of that which has already had its throat cut. 
#etcsl: line-id=A.1.3.3

@end proverb

@div proverb 1.4

A.1.4.4. {d}nin-ŋiš-zid-da-ra ga-til₃ na-an-na-ab-be₂-en
#lem: Ninŋešzidak[1]; til[live (of a single person)]; e[speak]
#tr.en: You should not say to @wDN{Ninŋišzida}: @q{“Let me live!”} 
#etcsl: line-id=A.1.4.4

@end proverb

@div proverb 1.5

A.1.5.5. kan₄#-na nam-mu-e-ni-dib-be₂
#lem: kan[gate]; dib[pass]
#tr.en: Do not make me pass through the gate! 
#etcsl: line-id=A.1.5.5

@end proverb

@div proverb 1.6

A.1.6.6. niŋ₂ gu₂ ŋar-ra niŋ₂ gaba ŋar-ra
#lem: niŋ[thing]; gu[neck]; ŋar[put]; niŋ[thing]; gaba[breast]; ŋar[put]
#tr.en: @note{cf. @xref[t.6.2.3,]{6.2.3: UET 6/2 265 l. 1}} What has submitted will exhibit resistance. 
#etcsl: line-id=A.1.6.6

#etcsl#cf cf. 6.2.3: UET 6/2 265 l. 1

@end proverb

@div proverb 1.7

A.1.7.7. niŋ₂ ha-lam-ma diŋir-ra-kam šu ku₄-ku₄ nu-ub-zu
#lem: niŋ[thing]; halam[forsake]; diŋir[deity]; šu[hand]; kur[enter]; zu[know]
#tr.en: @note{cf. @xref[t.6.2.5,]{6.2.5: YBC 4677 ll. 6-7}} What has been destroyed belongs to a god. No one is able to take it away. 
#etcsl: line-id=A.1.7.7

#etcsl#cf cf. 6.2.5: YBC 4677 ll. 6-7

@end proverb

@div proverb 1.8

A.1.8.8. ninda-ŋu₁₀ he₂-ŋal₂ ninda-zu ga-gu₇
#lem: ninda[bread]; heŋal[plenty]; ninda[bread]; gu[eat]
#tr.en: @q{“Though I still have bread left over, I will eat your bread!”} Will this endear a man to the household of his friend? 
#etcsl: line-id=A.1.8.8

A.1.8.9. e₂ dub₃-sa-na-ka lu₂ ba-ni-ib-kal-le
#lem: e[house]; dusa[friend]; lu[person]; kal[rare]
#etcsl: line-id=A.1.8.9

@end proverb

@div proverb 1.9

A.1.9.10. ninda he₂-ŋal₂-e {d}nin-kilim ib₂-gu₇
#lem: ninda[bread]; heŋal[plenty]; ninkilim[mongoose]; gu[eat]
#tr.en: @note{cf. @xref[t.6.1.22,]{6.1.22: ll. 140-145}, @xref[t.6.2.3,t623.h3]{6.2.3: UET 6/2 239}, @xref[t.6.2.3,t623.h4]{6.2.3: UET 6/2 320}, @xref[t.6.2.3,]{6.2.3: UET 6/2 339 + UET 6/3 235 Seg. B l. 2}} If bread is left over, the mongoose eats it. 
#etcsl: line-id=A.1.9.10

#etcsl#cf cf. 6.1.22: ll. 140-145, 6.2.3: UET 6/2 239, 6.2.3: UET 6/2 320, 6.2.3: UET 6/2 339 + UET 6/3 235 Seg. B l. 2

A.1.9.11. ninda ha-ma-ŋal₂-e lu₂-kur₂-ra ib₂-gu₇
#lem: ninda[bread]; ŋal[⟦be⟧ to be (there]; lukur[stranger]; gu[eat]
#tr.en: If I have any bread left over, then a stranger will eat it. 
#etcsl: line-id=A.1.9.11

@end proverb

@div proverb 1.10

A.1.10.12. niŋ₂-ŋu₁₀ niŋ₂ am₃-kur₂
#lem: niŋ[thing]; niŋ[thing]; kur[different]
#tr.en: My things changed things. 
#etcsl: line-id=A.1.10.12

@end proverb

@div proverb 1.11

A.1.11.13. niŋ₂ i₃-pad₃-da-zu nu-ub-be₂-en
#lem: niŋ[thing]; pad[find]; e[speak]
#tr.en: You don't speak of that which you have found. 
#etcsl: line-id=A.1.11.13

A.1.11.14. niŋ₂ u₂-gu de₂-a-zu ab-be₂-en
#lem: niŋ[thing]; ugu[cvne]; de[pour]; e[speak]
#tr.en: You talk only about what you have lost. 
#etcsl: line-id=A.1.11.14

@end proverb

@div proverb 1.12

A.1.12.15. niŋ₂ ud-bi-ta la-ba-ŋal₂-la
#lem: niŋ[thing]; ud[sun]; ŋal[⟦be⟧ to be (there]
#tr.en: Something which has never occurred since time immemorial: 
#etcsl: line-id=A.1.12.15

A.1.12.16. ki-sikil tur ur₂ dam-ma-na-ka še₁₀ nu-ub-dur₂-re
#lem: kisikil[young woman]; tur[small]; ur[loin]; dam[spouse]; šed[excrement]; dur[sit]
#tr.en: a young woman did not fart in her husband's embrace. 
#etcsl: line-id=A.1.12.16

@end proverb

@div proverb 1.13

A.1.13.17. niŋ₂ ud tur-ra-kam
#lem: niŋ[thing]; ud[sun]; tur[small]
#tr.en: It is a thing of short duration. 
#etcsl: line-id=A.1.13.17

@end proverb

@div proverb 1.14

A.1.14.18. niŋ₂-hul dim₂-ma-zu a-na-am₃ na-an-na-ab-be₂-en
#lem: niŋhulu[evil]; dim[create]; ana[what?]; e[speak]
#tr.en: Whatever it is that hurts you, don't talk to anyone about it. 
#etcsl: line-id=A.1.14.18

@end proverb

@div proverb 1.15

A.1.15.19. niŋ₂-tuku#-tuku al-su₃-ud
#lem: niŋtuku[rich]; sud[distant]
#tr.en: Wealth is far away, 
#etcsl: line-id=A.1.15.19

A.1.15.20. nam-ukur₃-ra al-ku-nu
#lem: namukur[poverty]; kunu[approach]
#tr.en: poverty is close at hand. 
#etcsl: line-id=A.1.15.20

@end proverb

@div proverb 1.16

A.1.16.21. niŋ₂ am₃-da-tuku-tuku igi am₃-da-uru₃-e
#lem: niŋ[thing]; tuku[acquire]; igi[eye]; uru[guard]
#tr.en: @note{cf. @xref[t.6.2.5,]{6.2.5: YBC 4677 l. 5}} He who possesses many things is constantly on guard. 
#etcsl: line-id=A.1.16.21

#etcsl#cf cf. 6.2.5: YBC 4677 l. 5

@end proverb

@div proverb 1.17

A.1.17.22. [niŋ₂]-gur₁₁# niŋ₂#-ŋiškim-til₃# ši-dugud-dugud#
#lem: niŋgur[property]; niŋŋeškimtil[trust]; dugud[heavy]
#tr.en: Possessions make trust of crucial importance. 
#etcsl: line-id=A.1.17.22

@end proverb

@div proverb 1.18

A.1.18.23. niŋ₂-gur₁₁ buru₅{mušen} dal-dal
#lem: niŋgur[property]; buru[sparrow]; dal[fly]
#tr.en: Possessions are flying birds --  
#etcsl: line-id=A.1.18.23

A.1.18.24. ki-tuš nu-pad₃-de₃-dam
#lem: kituš[dwelling place]; pad[find]
#tr.en: they never find a place to settle. 
#etcsl: line-id=A.1.18.24

@end proverb

@div proverb 1.19

A.1.19.25. da-ga nam-kug-zu {d}lamma (1:ib₂-da-nu₂:1)
#lem: X; namkugzu[wisdom]; lammar[(female) tutelary deity]; nud[lie down]
#tr.en: Good fortune @varh[t6101.v1]{is embedded in } @vart[t6101.v2,]{@note{3 mss. have instead:} reinforces } organisation and wisdom. 
#etcsl: line-id=A.1.19.25

:25v.1.1: ($3 mss. have instead:$) a₂ bi₂-ib-ŋar
#lem: a[arm]; ŋar[put]

@end proverb

@div proverb 1.20

A.1.20.26. niŋ₂ ud-de₃ gu₇ ur-re ba-an-ŋar
#lem: niŋ[thing]; ud[sun]; gu[eat]; ur[dog]; ŋar[put]
#tr.en: What is eaten for today (?) was put there by the dog. 
#etcsl: line-id=A.1.20.26

A.1.20.27. niŋ₂ ur-re gu₇ ud-de₃ ba-an-ŋar
#lem: niŋ[thing]; ur[dog]; gu[eat]; ud[sun]; ŋar[put]
#tr.en: What is eaten by the dog was put there for today (?). 
#etcsl: line-id=A.1.20.27

@end proverb

@div proverb 1.21

A.1.21.28. ninda hul ba-ŋal₂-la (1:gu₂-zu:1) la-ba-ši-šub
#lem: ninda[bread]; hulu[bad]; ŋal[⟦be⟧ to be (there]; gu[neck]; šub[fall]
#tr.en: @varh[t6101.v3]{One shouldn't } @vart[t6101.v4,]{@note{1 ms. has instead:} I will not } scorn bread which has turned bad. 
#etcsl: line-id=A.1.21.28

:28v.1.1: ($1 ms. has instead:$) gu₂-ŋu₁₀
#lem: gu[neck]

@end proverb

@div proverb 1.22

A.1.22.29. ninda MAŠ šag₄-da zig₃-ga-ab
#lem: ninda[bread]; n; šag[heart]; zig[rise]
#tr.en: Give out only half a loaf voluntarily! 
#etcsl: line-id=A.1.22.29

@end proverb

@div proverb 1.23

A.1.23.30. niŋ₂-tuku al di keše₂-re niŋ₂-gig-ga-am₃
#lem: niŋtuku[rich]; al[cvne]; di[speak]; kešed[bind]; niŋgig[that which is bad]
#tr.en: @note{cf. @xref[t.6.2.3,t623.h5]{6.2.3: UET 6/2 261 and UET 6/2 262}, @xref[t.6.2.3,]{6.2.3: UET 6/2 339 + UET 6/3 235 Seg. B l. 3}, @xref[t.4.14.1,]{4.14.1: l. 144}} To be wealthy and insist (?) on demanding more is abominable. 
#etcsl: line-id=A.1.23.30

#etcsl#cf cf. 6.2.3: UET 6/2 261 and UET 6/2 262, 6.2.3: UET 6/2 339 + UET 6/3 235 Seg. B l. 3, 4.14.1: l. 144

@end proverb

@div proverb 1.24

A.1.24.31. [...] UG ŋeštug₂-zu [...] RI#-re
#lem: X; X; ŋeštug[ear]; X; X
#tr.en: @gap{1 line fragmentary}
#etcsl: line-id=A.1.24.31

@end proverb

@div proverb 1.25

A.1.25.32. niŋ₂#-hul kuš₂#-kuš₂ nidba tag-ga#
#lem: niŋhulu[evil]; kušu[tired]; nindaba[(food) offering]; tag[touch]
#tr.en: @gap{1 line unclear}
#etcsl: line-id=A.1.25.32

@end proverb

@div proverb 1.26

A.1.26.33. niŋ₂ ak-zu gu₇ nam he₂-eb-tar
#lem: niŋ[thing]; ak[do]; gu[eat]; nam[fate]; tar[cut]
#tr.en: Let him decree the fates while consuming what you have made. 
#etcsl: line-id=A.1.26.33

@end proverb

@div proverb 1.27

A.1.27.34. niŋ₂ nu-dug₃ ga-dug₄-dug₄
#lem: niŋ[thing]; dug[good]; dug[speak]
#tr.en: I always seem to be speaking about unpleasant things. 
#etcsl: line-id=A.1.27.34

@end proverb

@div proverb 1.28

A.1.28.35. niŋ₂-sam₂-ma sig₁₀-ga šag₄-ta ib₂-ta-e₃
#lem: niŋšama[purchase]; sig[put into]; šag[heart]; e[leave]
#tr.en: When a purchase is settled it is soon out of mind. 
#etcsl: line-id=A.1.28.35

@end proverb

@div proverb 1.29

A.1.29.36. niŋ₂ igi nu-du₈-a-gin₇ mu-un-ak
#lem: niŋ[thing]; igi[eye]; du[spread]; ak[do]
#tr.en: He did something never seen before. 
#etcsl: line-id=A.1.29.36

@end proverb

@div proverb 1.30

A.1.30.37. [niŋ₂] u₂# nu-gu₇ am kur-ra-ka
#lem: niŋ[thing]; u[plant(s)]; gu[eat]; am[wild bull]; kur[mountain(s)]
#tr.en: @note{cf. @xref[t.6.1.07,t.6.1.07.82]{6.1.07.82}} That which does not eat grass is a wild bull of the mountains. 
#etcsl: line-id=A.1.30.37

#etcsl#cf cf. 6.1.07.82

A.1.30.38. [niŋ₂] a nu-naŋ maš-da₃ kur-ra-ka
#lem: niŋ[thing]; a[water]; naŋ[drink]; mašda[gazelle]; kur[mountain(s)]
#tr.en: That which does not drink water is a gazelle of the mountains. 
#etcsl: line-id=A.1.30.38

@end proverb

@div proverb 1.31

A.1.31.39. [ninda] šu-a ti-a li-bi₂#-in-gur-ra
#lem: ninda[bread]; šu[hand]; teŋ[approach]; gur[turn]
#tr.en: @note{cf. @xref[t.6.1.07,t.6.1.07.37]{6.1.07.37}} One does not return borrowed bread. 
#etcsl: line-id=A.1.31.39

#etcsl#cf cf. 6.1.07.37

@end proverb

@div proverb 1.32

A.1.32.40. niŋ₂ e₂# zig₃-ga niŋir-e an-hul₂
#lem: niŋ[thing]; e[house]; zig[rise]; niŋir[herald]; hul[rejoice]
#tr.en: The herald rejoices when the estate makes expenditures. 
#etcsl: line-id=A.1.32.40

@end proverb

@div proverb 1.33

A.1.33.41. [niŋ₂] e₂# degₓ(RI)-degₓ(RI)-ga# aŋrig#-e an-hul₂
#lem: niŋ[thing]; e[house]; deg[gather up]; agrig[steward]; hul[rejoice]
#tr.en: The steward rejoices when the estate increases its income. 
#etcsl: line-id=A.1.33.41

@end proverb

@div proverb 1.34

A.1.34.42. [niŋ₂] arad X X ba-e-sam₂
#lem: niŋ[thing]; arad[slave]; X; X; sa[pay for]
#tr.en: …… slave …… bought ……. 
#etcsl: line-id=A.1.34.42

@end proverb

@div proverb 1.35

A.1.35.43. niŋ₂ nam-til-til-de₃-en egir-bi ga-ra-an-da-am₃
#lem: niŋ[thing]; til[complete]; egir[back]; garan[bunch (of fruit)]
#tr.en: Don't pick things now; they will bear fruit later. 
#etcsl: line-id=A.1.35.43

@end proverb

@div proverb 1.36

A.1.36.44. niŋ₂ inim bal-e-en-na-zu
#lem: niŋ[thing]; inim[word]; bala[turn]
#tr.en: Who will listen  
#etcsl: line-id=A.1.36.44

A.1.36.45. a-ba-am₃ ŋiš mu-ra-an-tuku-tuku
#lem: aba[who?]; ŋeš[tree]; tuku[acquire]
#tr.en: to your translations? 
#etcsl: line-id=A.1.36.45

@end proverb

@div proverb 1.37

A.1.37.46. niŋ₂ ab-ak-ak-na-zu niŋ₂ ak tur lu₂ ne in-nu
#lem: niŋ[thing]; ak[do]; niŋ[thing]; ak[do]; tur[small]; lu[person]; nen[this]; nu[not]
#tr.en: What you are doing is a small accomplishment. That man is not doing a man's work. 
#etcsl: line-id=A.1.37.46

@end proverb

@div proverb 1.38

A.1.38.47. ninda i₃-sig₁₀ šu nu-un-gur
#lem: ninda[bread]; sig[put into]; šu[hand+=wipe]; gur[turn]
#tr.en: Bread is served but it is not used for wiping. 
#etcsl: line-id=A.1.38.47

A.1.38.48. a ib₂-ta-de₂ ki-in-du ba-ab-naŋ
#lem: a[water]; de[pour]; kindu[earth]; naŋ[drink]
#tr.en: Water is poured out, and then drunk by the ground. 
#etcsl: line-id=A.1.38.48

A.1.38.49. kur-ra ki kal-la-kal-la-ba
#lem: kur[mountain(s)]; ki[place]; kal[rare]
#tr.en: In the nether world, the most honoured place, since it is water and food, 
#etcsl: line-id=A.1.38.49

A.1.38.50. a-am₃ u₂-am₃ a-de₂-da mu-pad₃-de₃-dam
#lem: a[water]; u[plant(s)]; de[pour]; pad[find]
#tr.en: it is called a water libation. 
#etcsl: line-id=A.1.38.50

@end proverb

@div proverb 1.39

A.1.39.51. ninda-gin₇ an-pad [...]-da-an-šar₂
#lem: ninda[bread]; pad[break (into bits)]; šar[mix]
#tr.en: He broke it like bread and mixed it with ……. 
#etcsl: line-id=A.1.39.51

@end proverb

@div proverb 1.40

A.1.40.52. ninda-ni niŋ₂-u₂-zug₄ he₂-a
#lem: ninda[bread]; niŋmuzug[impure thing]; me[be]
#tr.en: @note{cf. @xref[t.6.1.19,t.6.1.19.f4]{6.1.19.f4}, @xref[t.6.2.1,]{6.2.1: Ni 4469 Seg. A ll. 1-4}} Let his bread be foul food; 
#etcsl: line-id=A.1.40.52

#etcsl#cf cf. 6.1.19.f4, 6.2.1: Ni 4469 Seg. A ll. 1-4

A.1.40.53. lu₂ nam-bi₂-in-šu₂-šu₂
#lem: lu[person]; šuš[cover]
#tr.en: no man should eat it. 
#etcsl: line-id=A.1.40.53

@end proverb

@div proverb 1.41

A.1.41.54. ninda-ni ninda nunuz dalla he₂-a zi-ni he₂-am₃-su-ub {{%akk a-ka-<al>-šu %akk lu %akk pe-lu-[u₂]-ma %akk [...]}}
#lem: ninda[bread]; ninda[bread]; nunuz[egg]; dalla[(to be) bright]; me[be]; zi[life]; sub[rub]; L; L; L; L
#tr.en: Let his food be bread and …… eggs, so that it clogs his throat. 
#etcsl: line-id=A.1.41.54

@end proverb

@div proverb 1.42

A.1.42.55. ninda-ni ŋiri₃-pad-ra₂ dalla he₂-a zi-ni he₂-keše₂ {{%akk a-ka-<al>-šu %akk lu %akk da-du-ma %akk li-ip-ši₂!-iq-šu}}
#lem: ninda[bread]; ŋiripadra[bone]; dalla[(to be) bright]; me[be]; zi[life]; kešed[bind]; L; L; L; L
#tr.en: Let his food be …… bones, so that it sticks in his throat. 
#etcsl: line-id=A.1.42.55

@end proverb

@div proverb 1.43

A.1.43.56. ninda-ni uzu dalla# [he₂-a] zi-ni he₂-en#-[...]
#lem: ninda[bread]; uzu[flesh]; dalla[(to be) bright]; me[be]; zi[life]; X
#tr.en: Let his food be …… meat, so that it …… his throat. 
#etcsl: line-id=A.1.43.56

@end proverb

@div proverb 1.44

A.1.44.57. niŋ₂ mah gu₇-gu₇# [...] RI# nu-KU
#lem: niŋ[thing]; mah[great]; gu[eat]; X; X; X
#tr.en: @note{cf. @xref[t.6.1.01,t.6.1.01.103]{1.103}} He who eats too much …… cannot ……. 
#etcsl: line-id=A.1.44.57

#etcsl#cf cf. 1.103

@end proverb

@div proverb 1.45

A.1.45.58. niŋ₂-zu₂-gub-zu X-ra-gin₇ pad-ma-an-de₃-eb
#lem: niŋzugub[meal]; X; pad[break (into bits)]
#tr.en: Break a bit of your lunch off for me like a ……. 
#etcsl: line-id=A.1.45.58

@end proverb

@div proverb 1.46

A.1.46.59. ninda tun₃-pad daŋal-le X i₃-ta ab-ta-šar₂
#lem: ninda[bread]; tunpad[piece]; daŋal[wide]; X; i[oil]; šar[mix]
#tr.en: …… a thick piece of bread …… mixed it with fat. 
#etcsl: line-id=A.1.46.59

@end proverb

@div proverb 1.47

A.1.47.60. zid₂-gu ama-a-tud#-X-ka! lal₃ i₃-nun-ta he₂-eb₂-ta-hi a-nir-bi nu-gul-e
#lem: zidgu[type of flour]; amaʾatud[house-born slave]; lal[syrup]; inun[ghee]; hi[mix (up)]; anir[lament]; gul[destroy]
#tr.en: Although the chickpea-flour of the home-born slaves …… is mixed with honey and ghee, there is no end to their lamentations. 
#etcsl: line-id=A.1.47.60

@end proverb

@div proverb 1.48

A.1.48.61. dabin a-šag₄-ga {uzu}suš₂-am₃
