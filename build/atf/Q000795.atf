#lem: ur[that]; ama[mother]; nin[sister]; banda[junior]; ak[do]
#tr.en: @note{cf. @xref[t.6.2.3,t623.h11]{6.2.3: UET 6/2 301}} Thus my mother and my younger sister act toward me; 
#etcsl: line-id=D.1.143.7

#etcsl#cf cf. 6.2.3: UET 6/2 301

