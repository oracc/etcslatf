1. i₃-a lum-lum u₃-luh-ha sud-sud
#lem: ia[(an exclamation)]; lum[fruit]; uluh[scepter]; sud[distant]
#tr.en: @q[Enkidu (?,Gilgamec]{“So come on now, you heroic bearer of a sceptre of wide-ranging power! Noble glory of the gods, angry bull standing ready for a fight! Young Lord @wRN{Gilgameš}, cherished in @wSN{Unug}!”} 
#etcsl: line-id=1

