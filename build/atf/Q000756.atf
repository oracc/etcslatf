&Q000756 = The advice of a supervisor to a younger scribe (E-dub-ba-a C)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.5.1.3
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.5.1.3&display=Crit&charenc=gcirc#

1. dumu e₂-dub-ba-a ud ul-la ŋa₂-nu ki-ŋu₁₀-še₃
#lem: dumu[child]; edubbaʾa[scribal school]; ud[sun]; ul[distant time]; ŋen[go]; ki[place]
#tr.en: @q[supervisor,younger scribe]{“One-time member of the school, come here to me, 
#etcsl: line-id=1

2. niŋ₂ um-mi-a-ŋu₁₀ mu-un-pad₃-da za-e ga-ra-pad₃-pad₃
#lem: niŋ[thing]; ummia[expert]; pad[find]; zaʾe[you]; pad[find]
#tr.en: and let me explain to you what my teacher revealed.”} 
#etcsl: line-id=2

3. za-e-gin₇-nam nam-lu₂-tur i₃-ak šeš-gal i₃-tuku-am₃
#lem: zaʾe[you]; namlutur[status as child]; ak[do]; šešgal[kinship term]; tuku[acquire]
#tr.en: @q{“Like you, I was once a youth and had a mentor. 
#etcsl: line-id=3

4. um-mi-a lu₂-ta kiŋ₂-ŋa₂-am₃ a₂ aŋ₂-ŋa₂ ŋiš bi₂-in-ŋar
#lem: ummia[expert]; lu[person]; kiŋ[work]; a[arm]; aŋ[measure]; ŋeš[tree]; ŋar[put]
#tr.en: The teacher assigned a task to me -- it was man's work. 
#etcsl: line-id=4

5. gi al-gu₄-ud-da-gin₇ i₃-gu₄-ud-de₃-en kiŋ₂-ŋa₂ bi₂-in-sig₁₀-ge-en
#lem: gi[reed]; gud[jump (on)]; gud[jump (on)]; kiŋ[work]; sig[put into]
#tr.en: Like a springing reed, I leapt up and put myself to work. 
#etcsl: line-id=5

6. inim um-mi-a-ŋu₁₀ nu-un-taka₄ niŋ₂ ni₂-ŋa₂ li-bi₂-ak
#lem: inim[word]; ummia[expert]; taka[set aside]; niŋ[thing]; ni[self]; ak[do]
#tr.en: I did not depart from my teacher's instructions, and I did not start doing things on my own initiative. 
#etcsl: line-id=6

7. šeš-gal-ŋu₁₀ a₂ ŋiš ŋar-ra-ŋa₂ šag₄-ga-ni i-ni-in-dug₃
#lem: šešgal[kinship term]; a[arm]; ŋeš[tree]; ŋar[put]; šag[heart]; dug[good]
#tr.en: My mentor was delighted with my work on the assignment. 
#etcsl: line-id=7

8. i₃-sun₅-ne na-mu-da-ši-hul₂ silim-ŋa₂ i-ni-in-dug₄
#lem: sun[humble]; hul[rejoice]; silim[healthy]; dug[speak]
#tr.en: He rejoiced that I was humble before him and he spoke in my favour.”} 
#etcsl: line-id=8

9. ŋiš ma-an-hur-ra na-an-dim₂ ki-bi-še₃ al-ŋar-ŋar
#lem: ŋeš[tree]; hur[scratch]; dim[create]; ki[place]; ŋar[put]
#tr.en: @q{“I just did whatever he outlined for me -- everything was always in its place. 
#etcsl: line-id=9

10. na degₓ(RI)-ga-ni-ta lu₂ hu-ru-um šu bar dib-ba-e
#lem: na[cvne]; deg[gather up]; lu[person]; hurum[junior]; šu[hand]; bar[place outside]; dib[pass]
#tr.en: Only a fool would have deviated from his instructions. 
#etcsl: line-id=10

11. im-ma šu-ŋu₁₀ si ba-ni-in-sa₂ us₂ zid mu-un-dab₅
#lem: im[clay]; šu[hand]; si[horn]; sa[equal]; us[path]; zid[right]; dab[seize]
#tr.en: He guided my hand on the clay and kept me on the right path. 
#etcsl: line-id=11

12. ka-ŋu₁₀ inim-ma ŋal₂ ba-ni-in-taka₄ ad gi₄-gi₄ ma-an-pad₃
#lem: kag[mouth]; inim[word]; ŋal[open]; taka[set aside]; ad[voice]; gi[turn]; pad[find]
#tr.en: He made me eloquent with words and gave me advice. 
#etcsl: line-id=12

13. ŋiš-hur lu₂ a₂ aŋ₂-ŋa₂ si sa₂-e igi ma-ni-in-si-si
#lem: ŋešhur[plan]; lu[person]; a[arm]; aŋ[measure]; si[horn]; sa[equal]; igi[eye]; si[fill]
#tr.en: He focused my eyes on the rules which guide a man with a task: 
#etcsl: line-id=13

14. gu₂ zi-zi-i ha-la a₂ aŋ₂-ŋa₂-kam ud zal-le niŋ₂-gig-ga
#lem: gu[neck]; zig[rise]; hala[inheritance share]; a[arm]; aŋ[measure]; ud[sun]; zal[pass time]; niŋgig[that which is bad]
#tr.en: zeal is proper for a task, time-wasting is taboo; 
#etcsl: line-id=14

15. lu₂ ki a₂ aŋ₂-ŋa₂-ni-še₃ ud zal-la a₂ aŋ₂-ŋa₂-ni ab-taka₄
#lem: lu[person]; ki[place]; a[arm]; aŋ[measure]; ud[sun]; zal[pass time]; a[arm]; aŋ[measure]; taka[set aside]
#tr.en: anyone who wastes time on his task is neglecting his task.”} 
#etcsl: line-id=15

16. niŋ₂-zu-a-ni pa nu-um-e₃ ka-ga₁₄-ni ba-an-la₂
#lem: niŋzu[knowledge]; pa[branch]; e[leave]; kag[mouth]; la[hang]
#tr.en: @q{“He did not vaunt his knowledge: his words were modest. If he had vaunted his knowledge, people would have frowned. 
#etcsl: line-id=16

17. tukum-bi niŋ₂-zu-a-ni pa ba-an-e₃ igi mu-un-suh-suh-u₃-ne
#lem: tukumbi[if]; niŋzu[knowledge]; pa[branch]; e[leave]; igi[eye]; suh[extract]
#tr.en: Do not waste time, do not rest at night -- get on with that work! 
#etcsl: line-id=17

18. ud na-ab-zal-e-en ŋi₆ na-ab-sed₄-e-en a₂-bi-še₃ ŋen-na
#lem: ud[sun]; zal[pass time]; ŋi[night]; sed[cold]; a[arm]; ŋen[go]
#tr.en: Do not reject the pleasurable company of a mentor or his assistant: 
#etcsl: line-id=18

19. šeš-gal šeš-ban₃-da hi-li-a-bi na-an-na-ni-ib-gi₄-gi₄
#lem: šešgal[kinship term]; šešbanda[kinship term]; hili[attractiveness]; gi[turn]
#tr.en: once you have come into contact with such great brains, 
#etcsl: line-id=19

20. saŋ-ki gal-gal-la um-ma-te inim-zu ba-dugud-de₃-en
#lem: saŋki[forehead]; gal[big]; teŋ[approach]; inim[word]; dugud[heavy]
#tr.en: you will make your own words more worthy.”} 
#etcsl: line-id=20

21. 2-kam-ma-še₃ igi keše₂-da-zu-še₃ nu-ra-ni-ib-gi₄-gi₄
#lem: n; igi[eye]; kešed[bind]; gi[turn]
#tr.en: @q{“And another thing: you will never return to your blinkered vision; 
#etcsl: line-id=21

22. ki za-za teš₂ lu₂-u₁₈-lu-ka mah-bi gu₂ he₂-ri-du₃
#lem: ki[place]; zaza[bow down]; teš[(sense of) shame]; lulu[man]; mah[great]; gu[neck]; du[build]
#tr.en: that would be greatly to demean due deference, the decency of mankind. 
#etcsl: line-id=22

23. u₂ teš₂-a-ka šag₄ ab-sed₄-de₃ nam-tag-ga al-du₈-e
#lem: u[plant(s)]; teš[(sense of) shame]; šag[heart]; sed[cold]; namtaga[sin]; du[spread]
#tr.en: Worthy plants calm the heart, and sins are absolved. 
#etcsl: line-id=23

24. lu₂ šu sug₄-ga-ka kadra-ni ur₅-še₃ nir mu-un-ŋal₂
#lem: lu[person]; šu[hand]; sug[empty]; kadra[greeting gift]; ur[that]; nir[lordly]; ŋal[⟦be⟧ to be (there]
#tr.en: An empty-handed man's gifts are respected as such. 
#etcsl: line-id=24

25. lu₂ niŋ₂ nu-tuku maš₂ gur-ra-na gaba-na i-im-tab
#lem: lu[person]; niŋ[thing]; tuku[acquire]; maš[goat]; gur[turn]; gaba[breast]; tab[double]
#tr.en: Even a poor man clutches a kid to his chest as he kneels. 
#etcsl: line-id=25

26. lu₂-ŋarza₂-ra ki he₂-en-ne-za he₂-keše₂ ba-sed₄-de₃
#lem: luŋarza[an official]; ki[place]; zaza[bow down]; kešed[bind]; sed[cold]
#tr.en: You should defer to the powers that be and …… -- that will calm you.”} 
#etcsl: line-id=26

27. niŋ₂ um-mi-a-ŋu₁₀ mu-un-pad₃-de₃ e-ra-šid nu-mu-ra-ab-taka₄
#lem: niŋ[thing]; ummia[expert]; pad[find]; šid[count]; taka[set aside]
#tr.en: @q{“There, I have recited to you what my teacher revealed, 
#etcsl: line-id=27

28. ŋizzal he₂-bi₂-ak šag₄-še₃ gid₂-i-de₃ sag₉-ge-zu mu-da-an-ŋal₂
#lem: ŋizzal[hearing]; ak[do]; šag[heart]; gid[long]; sag[good]; ŋal[⟦be⟧ to be (there]
#tr.en: and you will not neglect it. You should pay attention -- taking it to heart will be to your benefit!”} 
#etcsl: line-id=28

29. dub-sar umun₂ ak sun₅-na-bi ugula-a-ni mu-un-na-ni-ib-gi₄-gi₄
#lem: dubsar[scribe]; umun[knowledge]; ak[do]; sun[humble]; ugula[overseer]; gi[turn]
#tr.en: The learned scribe humbly answered his supervisor: 
#etcsl: line-id=29

30. ud mu₇-mu₇-gin₇ ab-šid-en-na-a ba-an-gi₄-bi a-ra-ab-ha-za-an
#lem: ud[sun]; mu[incantation]; šid[count]; bangi[response]; haza[hold]
#tr.en: @q[younger scribe,supervisor]{“I shall give you a response to what you have just recited like a magic spell, 
#etcsl: line-id=30

31. mu gud-gin₇ i-lu dug₃-ga-zu-še₃ ŋiš i₃-la₂-a-bi
#lem: mu[noise]; gud[bull]; ilu[lament]; dug[good]; ŋeš[tree]; la[hang]
#tr.en: and a rebuttal to your charming ditty delivered in a bellow. 
#etcsl: line-id=31

32. lu₂ nu-zu nam-mu-ni-ib-ku₄-ku₄ 1(DIŠ)-am₃ ga-ra-ni-ib-gi₄
#lem: lu[person]; zu[know]; kur[enter]; n; gi[turn]
#tr.en: Do not make me out to be an ignoramus -- I will answer you once and for all! 
#etcsl: line-id=32

#etcsl#ms 1 ms. inserts lines 60A and 60B here instead of after line 60

33. ur-gir₁₅ tur-gin₇ igi mu-e-bad-bad nam-lu₂-ulu₃ mu-e-ak
#lem: urgir[(domestic) dog]; tur[small]; igi[eye]; bad[open]; namlulu[humanity]; ak[do]
#tr.en: You opened my eyes like a puppy's and you made me into a human being. 
#etcsl: line-id=33

34. a-na-aš-am₃ lu₂ ŋa₂-la dag-ga-gin₇ ŋiš ma-ab-hur-hur-re-en
#lem: anaš[why?]; lu[person]; ŋala[cvne]; dag[roam around]; ŋeš[tree]; hur[scratch]
#tr.en: But why do you go on outlining rules for me as if I were a shirker? 
#etcsl: line-id=34

35. lu₂ inim-zu ŋiš ba-ni-in-tuku-a šu am₃-ma-kar₂-kar₂
#lem: lu[person]; inim[word]; ŋeš[tree]; tuku[acquire]; šu[hand]; kar[blow]
#tr.en: Anyone hearing your words would feel insulted!”} 
#etcsl: line-id=35

36. nam-dub-sar-ra a-na mu-e-pad₃-da-zu šu-za ba-ni-in-šum₂
#lem: namdubsar[the scribal arts]; ana[what?]; pad[find]; šu[hand]; šum[give]
#tr.en: @q{“Whatever you revealed of the scribal art has been repaid to you. 
#etcsl: line-id=36

37. e₂-za he₂-bi₂-gub-be₂-en ud na-me niŋ₂ ŋa₂-la dag-ga-ŋu₁₀-uš sa₂ ba-ra-am₃-mu-ri-ib-dug₄
#lem: e[house]; gub[stand]; ud[sun]; name[any]; niŋ[thing]; ŋala[cvne]; dag[roam around]; sa[equal]; dug[speak]
#tr.en: You put me in charge of your household and I have never served you by shirking. 
#etcsl: line-id=37

38. geme₂ arad₂ ŋiri₃-sig₁₀-ga e₂-za kiŋ₂-gi₄-a he₂-bi₂-ne-gi₄
#lem: geme[female worker]; arad[slave]; ŋirsiga[an attendant]; e[house]; kiŋgia[messenger]; gi[turn]
#tr.en: I have assigned duties to the slave girls, slaves and subordinates in your household. I have kept them happy with rations, 
#etcsl: line-id=38

39. šukur₂-bi tug₂-bi u₃ i₃-ba-bi šag₄-bi ha-ma-dug₃-ga
#lem: šukur[food allocation]; tug[textile]; u[and]; ba[allot]; šag[heart]; dug[good]
#tr.en: clothing and oil rations, and I have assigned the order of their duties to them, 
#etcsl: line-id=39

40. a-ra₂-bi-še₃ kiŋ₂-gi₄-a he₂-bi₂-in-ne-gi₄ e₂ lugal-ka arad₂ ba-ra-bi₂-in-us₂
#lem: ara[way]; kiŋgia[messenger]; gi[turn]; e[house]; lugal[king]; arad[slave]; us[accompany]
#tr.en: so that you do not have to follow the slaves around in the house of their master. 
#etcsl: line-id=40

41. gaba ud-ŋa₂ he₂-bi₂-ak udu-gin₇ he₂-eb-us₂-u₃-nam
#lem: gaba[breast]; ud[sun]; ak[do]; udu[sheep]; us[accompany]
#tr.en: I do this as soon as I wake up, and I chivvy them around like sheep.”} 
#etcsl: line-id=41

42. sizkur₂ sa gi₄-gi₄-da he₂-mu-e-dug₄ ud-bi sa₂ he₂-ri-ib-dug₄
#lem: siškur[prayer]; sa[sinew]; gi[turn]; dug[speak]; ud[sun]; sa[equal]; dug[speak]
#tr.en: @q{“When you have ordered offerings to be prepared, I have performed them for you on the appropriate days. 
#etcsl: line-id=42

43. udu-bi u₂-gu₇-bi ha-ma-sag₉-sag₉ diŋir-zu he₂-hul₂
#lem: udu[sheep]; ugu[food]; sag[good]; diŋir[deity]; hul[rejoice]
#tr.en: I have made the sheep and banquets attractive, so that your god is overjoyed. When the boat of your god arrives, people should greet it with respect. 
#etcsl: line-id=43

44. ud ma₂ diŋir-za us₂-sa-bi giri₁₇ šu ha-ra-ab-tag-ge-ne
#lem: ud[sun]; ma[ship]; diŋir[deity]; us[accompany]; kiri[nose]; šu[hand]; tag[touch]
#tr.en: When you have ordered me to the edge of the fields, I have made the men work there. 
#etcsl: line-id=44

45. gaba a-šag₄-ga-še₃ a₂ he₂-mu-e-da-a-a-aŋ₂ erin₂-e kiŋ₂ he₂-bi₂-ak
#lem: gaba[breast]; ašag[field]; a[arm]; aŋ[measure]; erin[people]; kiŋ[work]; ak[do]
#tr.en: It is challenging work which permits no sleep either at night or in the heat of day, 
#etcsl: line-id=45

46. kiŋ₂ a-da-min₃-na ŋi₆ an-bar₇-ba u₃ ba-ra-bi₂-ku-am₃
#lem: kiŋ[work]; adamin[contest]; ŋi[night]; anbar[mid-day]; u[sleep]; ku[place]
#tr.en: if the cultivators are to do their best at the field-borders. 
#etcsl: line-id=46

47. us₂-a-DU dumu engar-ra-ke₄-e-ne saŋ hu-mu-un-kal-le-ne
#lem: us₂.a.DU[border]; dumu[child]; engar[farmer]; saŋ[head]; kal[rare]
#tr.en: I have restored quality to your fields, so people admire you. 
#etcsl: line-id=47

48. a-šag₄-za šu nam-sag₉-ga he₂-bi₂-gi₄ uŋ₃-e u₆ di he₂-ri-ib-dug₄
#lem: ašag[field]; šu[hand]; namsag[pleasure]; gi[turn]; uŋ[people]; u[admiration]; di[speak]; dug[speak]
#tr.en: Whatever your task for the oxen, 
#etcsl: line-id=48

49. gud-de₃ a-na-am₃ gub-zu dirig he₂-em-tum₃ gu₂-un-bi ha-ra-ab-silim-ma-am₃
#lem: gud[bull]; ana[what?]; gub[stand]; dirig[make more than]; tum[bring]; gun[load]; silim[healthy]
#tr.en: I have exceeded it and have fully completed their loads for you.”} 
#etcsl: line-id=49

50. tur-ra-ŋu₁₀-ta he₂-em-ma-dim₄-e-en a-ra₂-ŋu₁₀ igi he₂-bi₂-du₈
#lem: tur[small]; dim[check]; ara[way]; igi[eye]; du[spread]
#tr.en: @q{“Since my childhood you have scrutinised me and kept an eye on my behaviour, 
#etcsl: line-id=50

51. kug sag₉-ga-gin₇ kurum₇ he₂-bi₂-ak ki-šer₁₁ la-ba-an-tuku
#lem: kug[metal]; sag[good]; gurum[inspection]; ak[do]; kišer[limit]; tuku[acquire]
#tr.en: inspecting it like fine silver -- there is no limit to it! 
#etcsl: line-id=51

52. gal-bi nu-di niŋ₂-gig-zu-gin₇ e-ra-da-tuš-u₃-nam
#lem: gal[big]; di[speak]; niŋgig[that which is bad]; tuš[sit (down)]
#tr.en: Without speaking grandly -- as is your shortcoming -- I serve before you. 
#etcsl: line-id=52

53. ni₂ tur-tur-re e-ra-da-sah₆-sah₆-na pa ga-ra-ab-e₃ zu-a
#lem: ni[self]; tur[small]; zah[disappear]; pa[branch]; e[leave]; zu[know]
#tr.en: But those who undervalue themselves are ignored by you -- know that I want to make this clear to you.”} 
#etcsl: line-id=53

54. ud-bi-ta lu₂-tur he₂-me-en-na i₃-ne-eš₂ saŋ-zu il₂
#lem: ud[sun]; lutur[child]; me[be]; ineš[now]; saŋ[head]; il[raise]
#tr.en: @q[supervisor,younger scribe]{“Raise your head now, you who were formerly a youth. 
#etcsl: line-id=54

55. šu-zu lu₂-ra mu-da-an-gi₄-gi₄-in a-ra₂-bi-še₃ DU-mu-un
#lem: šu[hand]; lu[person]; gi[turn]; ara[way]; X
#tr.en: You can turn your hand against any man, so act as is befitting.”} 
#etcsl: line-id=55

56. šudu₃ he₂-mu-e-ša₄ nam mu-tar-ra
#lem: šud[prayer]; ša[cvve]; nam[fate]; tar[cut]
#tr.en: @q[younger scribe,supervisor]{“Through you who offered prayers and so blessed me, 
#etcsl: line-id=56

57. na degₓ(RI)-ga ga i₃ gu₇-a-gin₇ su-ŋa₂ i-ni-in-kur₉-ra
#lem: na[cvne]; deg[gather up]; ga[milk]; i[oil]; gu[eat]; su[flesh]; kur[enter]
#tr.en: who instilled instruction into my body as if I were consuming milk and butter, 
#etcsl: line-id=57

58. gub-bu ŋa₂-la nu-dag-ge pad₃-da-zu
#lem: gub[stand]; ŋala[cvne]; dag[roam around]; pad[find]
#tr.en: who showed his service to have been unceasing, 
#etcsl: line-id=58

59. ki sag₉-ga-bi sa₂ he₂-ri-ib-dug₄ niŋ₂-hul-bi li-bi₂-in-ak
#lem: ki[place]; sag[good]; sa[equal]; dug[speak]; niŋhulu[evil]; ak[do]
#tr.en: I have experienced success and suffered no evil.”} 
#etcsl: line-id=59

