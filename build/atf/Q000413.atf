&Q000413 = An adab (?) to Nergal for Šulgi (?) (Šulgi U)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.2.4.2.21
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.2.4.2.21&display=Crit&charenc=gcirc#

@div šagbatuku A

$ (unknown no. of lines missing)
A.1. {d}nergal# [...]
#lem: Nergal[1]DN; X
#etcsl: line-id=A.1

A.2. ni₂ gal i ganzer X IGI X X [...]
#lem: ni[fear]; gal[big]; e[bring out]; Ganzer[1]GN; X; X; X; X; X
#etcsl: line-id=A.2

A.3. ni₂ me-lem₄-ma-bi sa-bar-ra# AN X [...] DU
#lem: ni[fear]; melim[frightening splendor]; sabar[net]; X; X; X; X
#etcsl: line-id=A.3

A.4. an-ne₂ ki-e ni₂-bi ba-ni#-[X X]
#lem: an[sky]; ki[place]; ni[fear]; X; X
#etcsl: line-id=A.4

@div trailer 

A.5. šag₄-ba-tuku 2-[kam-ma-am₃]
#tr.en: 2nd @fsux{šagbatuku}.
#lem: šagbatuku[liturgical rubric]; n
#etcsl: line-id=A.5

@end trailer

@end šagbatuku

@div barsud B

B.6. ur-saŋ am a₂ gur-gur ab₂-gin₇ in#-[...]
#tr.en: Hero, wild bull with thick horns, …… like a cow,
#lem: ursaŋ[warrior]; am[wild bull]; a[arm]; gur[thick]; ab[cow]; X
#etcsl: line-id=B.6

B.7. mu huš-zu ni₂ su zig₃ bar-re-dam
#tr.en: your terrifying name lets loose awe and fear.
#lem: mu[name]; huš[reddish]; ni[fear]; su[flesh]; zig[rise]; bar[place outside]
#etcsl: line-id=B.7

B.8. ulu₃-gin₇-nam ki-bal šub-šub-bu-[me-en]
#tr.en: You fall on the rebel lands like the south wind.
#lem: ulu[south wind]; kibala[rebel land]; šub[fall]
#etcsl: line-id=B.8

B.9. kur niŋ₂-daŋal-ba si-ŋar-bi-me-en
#tr.en: You are a bolt on the broad extent of the mountains.
#lem: kur[mountain(s)]; niŋdaŋala[vastness]; siŋar[bolt]
#etcsl: line-id=B.9

B.10. e₂-meš₃-lam za-e tuš-a-zu-ne
#tr.en: When you sit in @wTN{E-mešlam},
#lem: Emeslam[1]TN; zaʾe[you]; tuš[sit (down)]
#etcsl: line-id=B.10

B.11. hul₂-hul₂-le šag₄-ge₈ guru₆ SUD-me-en₃
#tr.en: your desires are joyously fulfilled (?).
#lem: hul[rejoice]; šag[heart]; guru[grain heap]; X
#etcsl: line-id=B.11

B.12. uŋ₃-e gu₂ ši-im-si ŋiri₃-zu-še₃
#tr.en: The people assemble at your feet.
#lem: uŋ[people]; gu[neck]; si[fill]; ŋiri[foot]
#etcsl: line-id=B.12

@div trailer 

B.13. bar-sud 2-kam-ma-am₃
#tr.en: 2nd @fsux{barsud}.
#lem: barsud[musical notation]; n
#etcsl: line-id=B.13

@end trailer

@end barsud

@div sa-gida C

C.14. [ki-bal]-e nam-nir-ŋal₂-zu {d}meš₃!-lam!-ta-e₃-a
#tr.en: @wDN{Mešlamta-ea}, your supremacy in the rebel lands!
#lem: kibala[rebel land]; namnirŋal[authority]; Meslamtaea[1]
#etcsl: line-id=C.14

C.15. [ki-bal]-e šul ši-im-mi-niŋin₂-niŋin₂
#tr.en: You have encircled the rebel lands, O youth.
#lem: kibala[rebel land]; šul[youth]; niŋin[encircle]
#etcsl: line-id=C.15

C.16. {[d]}nergal# nam-nir-ŋal₂-zu ki-bal-e
#tr.en: @wDN{Nergal}, your supremacy in the rebel lands!
#lem: Nergal[1]DN; namnirŋal[authority]; kibala[rebel land]
#etcsl: line-id=C.16

C.17. [a-a]-zu# ki gal-bi ši-im-ma-an-aŋ₂
#tr.en: Your father loves you greatly.
#lem: aya[father]; ki[place]; gal[big]; aŋ[measure]
#etcsl: line-id=C.17

C.18. nam-ur-saŋ#-zu uŋ₃-e im-mi-zu-<<me>>
#tr.en: He has made your heroism known among the people.
#lem: namursaŋ[heroism]; uŋ[people]; zu[know]
#etcsl: line-id=C.18

C.19. a-a-zu {d}en-lil₂-le ki gal-bi ši-im-ma-an-aŋ₂
#tr.en: Your father @wDN{Enlil} loves you greatly.
#lem: aya[father]; Enlil[1]DN; ki[place]; gal[big]; aŋ[measure]
#etcsl: line-id=C.19

C.20. nam-ur-saŋ-zu uŋ₃-e im-mi-zu
#tr.en: He has made your heroism known among the people.
#lem: namursaŋ[heroism]; uŋ[people]; zu[know]
#etcsl: line-id=C.20

C.21. ur-saŋ uŋ₃-e TAR-TAR diŋir kur-ra niŋin
#tr.en: Hero …… for the people, god roaming the mountains!
#lem: ursaŋ[warrior]; uŋ[people]; X; diŋir[deity]; kur[mountain(s)]; niŋin[encircle]
#etcsl: line-id=C.21

C.22. ki-bal-e X-da ba-ni-dug₄
#tr.en: You have …… the rebel lands.
#lem: kibala[rebel land]; X; dug[speak]
#etcsl: line-id=C.22

C.23. {d}nergal uŋ₃-e TAR-TAR diŋir kur-ra niŋin
#tr.en: @wDN{Nergal} …… for the people, god roaming the mountains!
#lem: Nergal[1]DN; uŋ[people]; X; diŋir[deity]; kur[mountain(s)]; niŋin[encircle]
#etcsl: line-id=C.23

C.24. ki# dib-ba-zu erin₂ teš₂-bi-še₃ hul mi#-[ni-X ...]
#tr.en: Wherever you stride, all their troops suffer.
#lem: ki[place]; dib[pass]; erin[people]; teš[unity]; hulu[bad]; X; X
#etcsl: line-id=C.24

C.25. an-ša₄-an!{ki} ti-da-nu-um-ma# [...]
#tr.en: …… @wGN{Anšan} and @wGN{Tidnum}, @wDN{Nergal},
#lem: Anšan[1]GN; Tidnum[1 Tidnum]; X
#etcsl: line-id=C.25

C.26. {d}nergal ki dib-ba erin₂ teš₂-bi-še₃# [hul mi-ni-X ...]
#tr.en: wherever you stride, all their troops suffer.
#lem: Nergal[1]DN; ki[place]; dib[pass]; erin[people]; teš[unity]; hulu[bad]; X; X
#etcsl: line-id=C.26

@div trailer 

C.27. sa-gid₂-[da-am₃]
#tr.en: @fsux{Sa-gida}.
#lem: sagida[musical notation]
#etcsl: line-id=C.27

@end trailer

@end sa-gida

@div ŋišgiŋal D

D.28. ur-saŋ šul!-gi#-ra zi# [...]
#tr.en: May you prolong the life of the hero @wRN{Šulgi}.
#lem: ursaŋ[warrior]; Šulgir[1]RN; zi[life]; X
#etcsl: line-id=D.28

D.29. a₂ ši-im-ši-X [...]
#tr.en: …… to his strength, …….
#lem: a[arm]; X; X
#etcsl: line-id=D.29

@div trailer 

E.x. ŋiš#-[gi₄-ŋal₂-bi-im]
#tr.en: Its @fsux{ŋišgiŋal}.
#lem: ŋešgiŋal[musical refrain]
#etcsl: line-id=D.30

@end trailer

@end ŋišgiŋal

