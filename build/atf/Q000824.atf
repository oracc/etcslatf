@div version 1 (VAT 21604 (+) 21605 (AUWE 23 120-121))

@div segment A

1.A.1. [... mu]-un#-na#-de₂-e
#lem: X; de[pour]
#tr.en: @gap{4 lines fragmentary}
#etcsl: line-id=1.A.1

1.A.2. [...] X X
#lem: X; X; X
#etcsl: line-id=1.A.2

1.A.3. [...] X X
#lem: X; X; X
#etcsl: line-id=1.A.3

1.A.4. [...] X
#lem: X; X
#etcsl: line-id=1.A.4

@end segment

@div segment B

1.B.1. [...] X X [...]
#lem: X; X; X; X
#tr.en: @gap{1 line fragmentary}
#etcsl: line-id=1.B.1

1.B.2. [an an-guru₃ ki] šu-ni-še₃ an-[la₂]
#lem: an[sky]; gur[lift]; ki[place]; šu[hand]; la[hang]
#tr.en: @note{cf. @xref[t.6.1.03,t.6.1.03.167]{6.1.03.167}, @xref[t.6.1.04,t.6.1.04.4]{6.1.04.4}, @xref[t.6.1.22,t6122.p35]{6.1.22: l. 189}} He holds up the sky, letting the earth dangle from his hands. 
#etcsl: line-id=1.B.2

#etcsl#cf cf. 6.1.03.167, 6.1.04.4, 6.1.22: l. 189

1.B.3. {d#}[en-lil₂-le] šer₇#-da gu-la-[ni] šag₄#-[ŋar]-ra#-am₃
#lem: Enlil[1]DN; šerda[crime]; gal[big]; šaŋar[starvation]
#tr.en: @note{cf. @xref[t.6.1.03,t.6.1.03.93]{6.1.03.93}} @wDN{Enlil's} greatest punishment is hunger. 
#etcsl: line-id=1.B.3

#etcsl#cf cf. 6.1.03.93

1.B.4. šul-a-lum-bi al-il₂-il₂#
#lem: šulalum[punishment]; il[raise]
#tr.en: @note{cf. @xref[t.6.1.04,t.6.1.04.5]{6.1.04.5}} He bears the responsibility for it. 
#etcsl: line-id=1.B.4

#etcsl#cf cf. 6.1.04.5

1.B.5. lu₂ ga-šum lu₂ BA# X X [...] X
#lem: lu[person]; gašum[assassin]; lu[person]; X; X; X; X; X
#tr.en: @note{cf. @xref[t.6.1.04,t.6.1.04.8]{6.1.04.8}} When he …… the man's assassin, 
#etcsl: line-id=1.B.5

#etcsl#cf cf. 6.1.04.8

1.B.6. al-me-a [lu₂] du₁₄-de₃-ka-[na ba-an-kur₉]
#lem: me[be]; lu[person]; dud[combat]; kur[enter]
#tr.en: he became his opponent. 
#etcsl: line-id=1.B.6

1.B.7. u₂-a-gin₇# [saŋ]-gu₂#-ni-ka#-[ra ...]
#lem: ua[provisioner]; saŋguŋal[proud]; X
#tr.en: @note{cf. @xref[t.6.1.04,t.6.1.04.6]{6.1.04.6}} As a provisioner, …… upon those who speak proudly (?). 
#etcsl: line-id=1.B.7

#etcsl#cf cf. 6.1.04.6

1.B.8. tum₉# [X X] X [...] X
#lem: tumu[wind]; X; X; X; X; X
#tr.en: @note{cf. @xref[t.6.1.04,t.6.1.04.9]{6.1.04.9}} The … 
#etcsl: line-id=1.B.8

#etcsl#cf cf. 6.1.04.9

1.B.9. [...] X [... sig₁₀]-ga#-am₃
#lem: X; X; X; sig[put into]
#tr.en: … wind …… harmful (?). 
#etcsl: line-id=1.B.9

1.B.10. {[tum₉]}[sa₁₂-ti]-um# tum₉ šeŋ₁₄-ŋa₂-kam
#lem: satium[east wind]; tumu[wind]; šeŋ[rain]
#tr.en: The east wind is a rain-bearing wind; 
#etcsl: line-id=1.B.10

1.B.11. {[tum₉]}[mar-tu] lu₂# <til₃>-ba dirig-ga
#lem: MAR.TU[westerner]; lu[person]; til[live (of a single person)]; dirig[make more than]
#tr.en: the west wind is greater than those who live there. 
#etcsl: line-id=1.B.11

1.B.12. {[tum₉]}[sa₁₂-ti-um] tum₉ he₂-ŋal₂-la
#lem: satium[east wind]; tumu[wind]; heŋal[plenty]
#tr.en: The east wind is a wind of prosperity, 
#etcsl: line-id=1.B.12

1.B.13. [gu₅-li] {d}na-ra-am-{d}suen
#lem: guli[friend]; Naramsuen[1]RN
#tr.en: the friend of @wRN{Naram-@wDN{Suen}}. 
#etcsl: line-id=1.B.13

@end segment

@end version

@div version 2 (VAT 21587 (AUWE 23 117))

2.1. [...] X X NU X [X X X]
#lem: X; X; X; X; X; X; X; X
#tr.en: @gap{1 line fragmentary}
#etcsl: line-id=2.1

2.2. [X X X] MU DI NA MA X X X
#lem: X; X; X; X; X; X; X; X; X; X
#tr.en: @gap{1 line fragmentary}
#etcsl: line-id=2.2

2.3. [mu]-un#-na-de₂ A ŠEŠ na-an-e₃#
#lem: de[pour]; X; X; e[leave]
#tr.en: …… poured it out for him ……. 
#etcsl: line-id=2.3

2.4. [X X] AN šar₂-ra LU HU NI hul [X X]
#lem: X; X; X; X; X; X; X; hulu[bad]; X; X
#tr.en: @gap{1 line fragmentary}
#etcsl: line-id=2.4

2.5. [X X]-ni#-in-tu-ud-[...]-ud
#lem: X; utud[give birth (to)]
#tr.en: …… gave birth …… like a @fsux{nindiŋir} priestess, 
#etcsl: line-id=2.5

2.6. [X X] PA# HI# nin#-diŋir-gin₇ ki-sikil X X-a-ni
#lem: X; X; X; X; erešdiŋir[priestess]; kisikil[young woman]; X; X
#tr.en: the young girl …… coming out, 
#etcsl: line-id=2.6

2.7. [...] RI GAG ed₂-da-ni ki-sikil TUR-ŋa₂#
#lem: X; X; X; e[leave]; kisikil[young woman]; X
#tr.en: the young girl  
#etcsl: line-id=2.7

2.8. [...] X ba-ši-in-gi₄
#lem: X; X; gi[turn]
#tr.en: …… returned it ……. 
#etcsl: line-id=2.8

2.9. [X X] X A X DUB PAD X GA uŋ₃-e
#lem: X; X; X; X; X; X; X; X; X; uŋ[people]
#tr.en: @gap{1 line fragmentary}
#etcsl: line-id=2.9

@end version

