#etcsl: line-id=B.B.16

B.B.17. arahₓ(|UŠ.GID₂.DA|) ŋeštin! lal₃-za
#lem: arah[storehouse]; ŋeštin[vine]; lal[syrup]
#tr.en: the quay of the barges, 
#etcsl: line-id=B.B.17

B.B.18. kar-zid-da kar ma₂-gur₈-ra-[za]
#lem: Karzida[1]TN; kar[harbor]; magur[barge]
#tr.en: in your house of heaven, 
#etcsl: line-id=B.B.18

B.B.19. e₂ an-na-za e₂ ki aŋ₂-za ŋe₂₆-e mu-un-til₃#-[le]
#lem: e[house]; an[sky]; e[house]; ki[place]; aŋ[measure]; ŋaʾe[I]; til[live (of a single person)]
#tr.en: in your beloved house, I will live!”} 
#etcsl: line-id=B.B.19

B.B.20. {d}nanna igi-nim-ta kur šim {ŋiš}erin-na-za ŋe₂₆-[e mu-un-til₃-le]
#lem: Nanna[1]DN; iginim[upper land]; kur[mountain(s)]; šim[aromatic substance]; eren[cedar]; ŋaʾe[I]; til[live (of a single person)]
#tr.en: @q{“@wDN{Nanna}, in the upper lands I will live on your mountain of fragrant cedars. 
#etcsl: line-id=B.B.20

B.B.21. %e u₃-mu-un %s {d}nanna %e uru₂-za-a %s mu-un-[til₃-le]
#lem: umun[lord]N; Nanna[1]DN; uru[city]; til[live (of a single person)]
#tr.en: Lord @wDN{Nanna}, I will live in your city. I will live where your cows are numerous, 
#etcsl: line-id=B.B.21

B.B.22. ab₂ i₃-lu amar i₃-lu mu-un#-[til₃-le]
#lem: ab[cow]; lu[abundant]; amar[calf]; lu[abundant]; til[live (of a single person)]
#tr.en: where your calves are numerous. @wDN{Nanna}, I will live in your @wSN{Urim}. 
#etcsl: line-id=B.B.22

B.B.23. {d}nanna urim₂{ki}-ma-za mu#-[un-til₃-le]
#lem: Nanna[1]DN; Urim[1]SN; til[live (of a single person)]
#tr.en: Lord, the bed is already …… there. 
#etcsl: line-id=B.B.23

B.B.24. %e u₃-mu-un mu-nu₂ %s ba-ši-in-ga-an-[... %s ...]
#lem: umun[lord]N; munud[bed]N; X; X
#tr.en: Lord, ……, lord, king, 
#etcsl: line-id=B.B.24

B.B.25. %e u₃-mu-un %s lil₂ zid an-edin RA U₃ [...]
#lem: umun[lord]N; lil[ghost]; zid[right]; aneden[the high steppe]; X; X; X
#tr.en: son of @wDN{An}, 
