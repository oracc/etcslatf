#lem: dusa[friend]; inim[word]; gin[confirm]; e[speak]
#etcsl: line-id=A.37

A.38. gu₅-li-ŋu₁₀ inim zid dug₄-ga-ŋu₁₀-uš lul ma-ši-ŋa₂-ŋa₂
#tr.en: My companion does not say a true word to me.
#lem: guli[friend]; inim[word]; zid[right]; dug[speak]; lul[false]; ŋar[put]
#etcsl: line-id=A.38

A.39. lu₂-lul-la-ke₄ inim teš₂ mu-un-dug₄
#tr.en: My friend falsifies my truthfully spoken words.
#lem: lulul[liar]; inim[word]; teš[(sense of) shame]; dug[speak]
#etcsl: line-id=A.39

A.40. diŋir-ŋu₁₀ nu-mu-na-ni-ib-gi₄-gi₄-in
#tr.en: A man of deceit has spoken insulting words to me while you,
#lem: diŋir[deity]; gi[turn]
#etcsl: line-id=A.40

A.41. umuš-ŋu₁₀ ba-an-ta-DU-un
#tr.en: my god, do not respond to him and you carry off my understanding.
