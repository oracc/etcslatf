&Q002338 = Public announcement of the loss of a seal
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.5.7.a
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.5.7.a&display=Crit&charenc=gcirc#

1. kišib mu sar ur-DUN dam-gar₃-ra u₂-gu ba-an-de₂
#lem: kišib[cylinder seal]; mu[name]; sar[write]; UrDUN[1]PN; damgar[merchant]; ugu[cvne]; de[pour]
#tr.en: A seal inscribed with the name of @wPN{Ur-DUN}, the merchant, 
#etcsl: line-id=1

2. inim pu-uh₂-ru-um-ma-ta
#lem: inim[word]; puhrum[assembly]
#tr.en: was lost. In accordance with the word of the assembly, 
#etcsl: line-id=2

3. niŋir-e sila-sila-a si gu₃ ba-ni-in-ra
#lem: niŋir[herald]; sila[street]; si[horn]; gu[voice]; rah[beat]
#tr.en: the herald has sounded the horn throughout all the streets: 
#etcsl: line-id=3

4. lu₂ na-me niŋ₂ na-me ugu-na li-bi₂-in-tuku
#lem: lu[person]; name[any]; niŋ[thing]; name[any]; ugu[skull]; tuku[acquire]
#tr.en: no one now has any claim against him. 
#etcsl: line-id=4

5. (1:{m}lu₂-{d}suen-na:1) šagina
#lem: Lusuena[1]PN; šakkanak[general]
#tr.en: @varh[t57a.v1]{@wPN{Lu-Suena} } @vart[t57a.v2,t57a.v1]{@varn{1 ms. has instead:} @wPN{Lu-gena} } , the governor-general; 
#etcsl: line-id=5

:5v.1.1: ($1 ms. has instead:$) lu₂-gen₆-na
#lem: Lugena[1]PN

6. {m}lugal-me-lem₄ ensi₂ saŋŋa
#lem: Lugalmelem[1]; ensik[ruler]; saŋŋa[an official]
#tr.en: @wPN{Lugal-melem}, 
#etcsl: line-id=6

@variants

#etcsl#ms 1 ms. adds the line:
6A. KA-KA-ne-ne ba-an-me-eš kišib-ba-ne-ne in-X-eš
#lem: X; me[be]; kišib[cylinder seal]; X
#tr.en: the governor and temple administrator @vart[t57a.v3,t57a.v3]{@varn{1 ms. adds:} were their …… and …… their seals } ; @wPN{Zuzu}, 
#etcsl: line-id=6A

@endvariants
7. {m}zu-zu um-mi-a
#lem: Zuzu[1]PN; ummia[expert]
#tr.en: the scholar; @wPN{Si-du}, the scribe; 
#etcsl: line-id=7

8. {m}si-du₃ dub-sar
#lem: Sidu[1]PN; dubsar[scribe]
#tr.en: @wPN{Allub}, the steward; @wPN{Bansagen}, 
#etcsl: line-id=8

9. {m}al-lub aŋrig#
#lem: Allub[1]PN; agrig[steward]
#tr.en: the lament singer; @wPN{Ullia}, 
#etcsl: line-id=9

10. {m}ba-an-sag₉-ge-en gala
#lem: Bansagen[1]PN; gala[lamentation singer]
#tr.en: the mayor; 
#etcsl: line-id=10

11. {m}ul-li₂-a ha-za-nu-um
#lem: Ullia[1]PN; hazanum[mayor]
#tr.en: and the herald are the witnesses. 
#etcsl: line-id=11

12. niŋir lu₂-ki-inim-ma-[me]
#lem: niŋir[herald]; lukiʾinimak[witness]
#etcsl: line-id=12




