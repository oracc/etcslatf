&Q000545 = Letter from Šulgi to Aradŋu about Aba-indasa's letter
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.3.1.06.1
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.3.1.06.1&display=Crit&charenc=gcirc#

@div version 1 (Version A)

1.1. {m}arad-ŋu₁₀-ra u₃-na-a-dug₄
#lem: Aradŋu[1]PN; dug[speak]
#tr.en: Say to @wPN{Aradŋu}: 
#etcsl: line-id=1.1

1.2. {m}{d}šul-gi lugal-zu na-ab-be₂-a
#lem: Šulgir[1]RN; lugal[king]; e[speak]
#tr.en: This is what your lord @wRN{Šulgi} says: 
#etcsl: line-id=1.2

1.3. ud# {m}a-ba-an-da-sa₂ ugula erin₂ zu₂ keše₂
#lem: ud[sun]; Abaindasa[1]PN; ugula[overseer]; erin[people]; zu[tooth]; kešed[bind]
#tr.en: Because @wPN{Aba-indasa}, the captain of the pledged troops, had sent a letter concerning ……, 
#etcsl: line-id=1.3

1.4. [X X] u₃-na-a-dug₄-bi šu-ni mu-un-taka₄-a
#lem: X; X; unadug[letter]; šu[hand]; taka[set aside]
#tr.en: he (?) indeed insisted on clamping down heavily, when you have borne (?) the offence. 
#etcsl: line-id=1.4

1.5. [...] šu dugud ri-de₃ šer₇-da il₂-la-zu hu-mu-un-ši-in-gen₆
#lem: X; šu[hand]; dugud[heavy]; ri[impose]; šerda[crime]; il[raise]; gin[confirm]
#tr.en: Why do they (?) let him rise up from among their troops and make him enter …… of my guard? 
#etcsl: line-id=1.5

1.6. [a-na]-aš#-am₃ erin₂-bi-ta mu-un-zi-zi
#lem: anaš[why?]; erin[people]; zig[rise]
#tr.en: Carry (?) it (?), 
#etcsl: line-id=1.6

1.7. [...] en#-nu-uŋ₃-ŋa₂ mu-ni-in-kur₉
#lem: X; ennuŋ[watch]; kur[enter]
#tr.en: and have your heart bear (?) the offence, 
#etcsl: line-id=1.7

1.8. [a-ba]-e-tum₃-tum₃-ma šer₇-da šag₄-zu a-ba-e-ši-il₂-la
#lem: tum[bring]; šerda[crime]; šag[heart]; il[raise]
#tr.en: …… the enemy has departed, 
#etcsl: line-id=1.8

1.9. [X X] kur₂-ra ba-ra-e₃-a erin₂-bi-ta gi₄-gi₄-[mu]-un#-na-ab
#lem: X; X; kur[different]; e[leave]; erin[people]; gi[turn]
#tr.en: and then return him to (?) their troops! 
#etcsl: line-id=1.9

1.10. [...] X X [...] ugu-ŋu₁₀-ta
#lem: X; X; X; X; ugu[skull]
#tr.en: From  
#etcsl: line-id=1.10

1.11. [... ha]-ra#-an-kalag [...]-nam
#lem: X; harrankalag[stronghold]; X
#tr.en: my own  
#etcsl: line-id=1.11

$ (approx. 2 lines fragmentary)
1.14. [...]-ŋar#-re-en HA# [...]
#lem: ŋar[put]; X; X
#tr.en:  
#etcsl: line-id=1.14

1.15. [...] X ha-ra-an-[kalag ...]-nam ha#-ba-zu-[...] X
#lem: X; X; harrankalag[stronghold]; X; zu[know]; X
#tr.en: ……, 
#etcsl: line-id=1.15

1.16. [...] u₃-na-a-dug₄-ŋu₁₀ šu-ni šu tak₄
#lem: X; unadug[letter]; šu[hand]; šu[hand]; taka[set aside]
#tr.en:  
#etcsl: line-id=1.16

1.17. [...] erin₂#-bi-še₃ gi₄-gi₄-mu-un-na-ab
#lem: X; erin[people]; gi[turn]
#tr.en: … 
#etcsl: line-id=1.17

1.18. [...]-bi sag₉-ga-zu# pad₃-de₃
#lem: X; sag[good]; pad[find]
#tr.en: …… when you have made good by appointing (?) ……, 
#etcsl: line-id=1.18

1.19. [...] X [X-pe]-el#-le-en
#lem: X; X; pel[defile]
#tr.en: …… you …… ruin ……! 
#etcsl: line-id=1.19

1.20. [...]-ab#-ŋar mu-ra-ab-kuš₂
#lem: ŋar[put]; kušu[tired]
#tr.en: …… was set, it was …… for you. 
#etcsl: line-id=1.20

1.21. X ki-saŋ#-ŋal₂#-[...] igi-zu-še₃ {ŋiš}gu-za ha-ra-ab-tuš-de₃-en
#lem: X; kisaŋŋala[stronghold]; igi[eye]; guza[chair]; tuš[sit (down)]
#tr.en: In a safe place where …… before you, you should take your seat on a throne. 
#etcsl: line-id=1.21

1.22. [a]-ma-ru-kam
#lem: amaru[flood]
#tr.en: This is urgent! 
#etcsl: line-id=1.22

@end version

@div version 2 (Version B)

$ (unknown no. of lines missing)
2.1. [X X] mu-un#-[...]
#lem: X; X; X
#tr.en: …… @wRN{Ur-@wDN{Namma}}, my own father, 
#etcsl: line-id=2.1

2.2. {[m]}[ur]-{d}namma a-a ugu-ŋu₁₀ [...]
#lem: Urnamma[1]RN; aya[father]; ugu[bear]; X
#tr.en: …… the fortress ……. 
#etcsl: line-id=2.2

2.3. [X X] X RA ha-ra-kalag X [...]
#lem: X; X; X; X; harrankalag[stronghold]; X; X
#tr.en: …… I have set up for their ……. 
#etcsl: line-id=2.3

2.4. [...]-bi-še₃ ab-ŋar-re#-[...]
#lem: X; ŋar[put]
#tr.en: From …… the fortress ……. 
#etcsl: line-id=2.4

2.5. X TA X ha-ra-[kalag ...] ha-ba-[...]
#lem: X; X; X; harrankalag[stronghold]; X; X
#tr.en: After …… my letter, 
#etcsl: line-id=2.5

2.6. ud u₃-na-dug₄-ŋu₁₀ ab-[...]
#lem: ud[sun]; unadug[letter]; X
#tr.en: return …… to their troops! 
#etcsl: line-id=2.6

2.7. erin₂-bi-še₃ gi₄-gi₄# [...]
#lem: erin[people]; gi[turn]; X
#etcsl: line-id=2.7

2.8. iri{ki}-bi nam-ba-an-pe-el-[...]
#lem: iri[city]; pel[defile]
#tr.en: May …… not ruin their city! 
#etcsl: line-id=2.8

2.9. nam-gur₄-bi erin₂-bi-še₃ X [...]
#lem: namgur[thickness]; erin[people]; X; X
#tr.en: Its pride …… for their troops. 
#etcsl: line-id=2.9

2.10. ki saŋ! ki-ŋal₂-la igi-zu#-[...] {ŋiš}gu-za-am₃ he₂#-[...]
#lem: ki[place]; saŋ[head]; kiŋal[uncultivated land]; igi[eye]; guza[chair]; X
#tr.en: ……, may you …… on a throne. 
#etcsl: line-id=2.10

@end version







