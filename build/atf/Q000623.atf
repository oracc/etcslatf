&Q000623 = The exaltation of Inana (Inana B)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.4.07.2
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.4.07.2&display=Crit&charenc=gcirc#

1. nin me šar₂-ra ud dalla e₃-a
#lem: nin[lady]; me[Being]; šar[numerous]V/i; ud[sun]; dalla[(to be) bright]; e[leave]
#tr.en: Lady of all the divine powers, resplendent light, righteous woman clothed in radiance, beloved of @wDN{An} and @wDN{Uraš}! 
#etcsl: line-id=1

#etcsl#cite Cited in OB catalogue from Nibru, at Philadelphia, 0.2.01, line 4; OB catalogue from Urim (U2), 0.2.04, line 8; OB catalogue at Andrews University, 0.2.11, line 3; OB catalogue at Yale, 0.2.12, Seg. A, line 4

2. munus zid me-lem₄ gur₃-ru ki aŋ₂ an uraš-a
#lem: munus[woman]; zid[right]; melim[frightening splendor]; gur[lift]; ki[place]; aŋ[measure]; An[1]DN; Uraš[1]DN
#tr.en: Mistress of heaven, with the great diadem, 
#etcsl: line-id=2

3. nu-gig an-na suh-gir₁₁ gal-gal-la
#lem: nugig[midwife]; an[sky]; suhgir[diadem]; gal[big]
#tr.en: who loves the good headdress befitting the office of @fsux{en} priestess, 
#etcsl: line-id=3

4. aga zid-de₃ ki aŋ₂ nam-en-na tum₂-ma
#lem: aga[tiara]; zid[right]; ki[place]; aŋ[measure]; namen[the office of en-priest]; tum[suitable]
#tr.en: who has seized all seven of its divine powers! My lady, 
#etcsl: line-id=4

5. me 7-bi šu sa₂ dug₄-ga
#lem: me[Being]; n; šu[hand]; sa[equal]; dug[speak]
#tr.en: you are the guardian of the great divine powers! You have taken up the divine powers, 
#etcsl: line-id=5

6. nin-ŋu₁₀ me gal-gal-la saŋ keše₂-bi za-e-me-en
#lem: nin[lady]; me[Being]; gal[big]; saŋ[head]; kešed[bind]; zaʾe[you]
#tr.en: you have hung the divine powers from your hand. You have gathered up the divine powers, 
#etcsl: line-id=6

7. me mu-e-il₂ me šu-zu-še₃ mu-e-la₂
#lem: me[Being]; il[raise]; me[Being]; šu[hand]; la[hang]
#tr.en: you have clasped the divine powers to your breast. 
#etcsl: line-id=7

8. me mu-e-ur₄ me gaba-za bi₂-tab
#lem: me[Being]; ur[gather]; me[Being]; gaba[breast]; tab[double]
#tr.en: Like a dragon you have deposited venom on the foreign lands. 
#etcsl: line-id=8

9. ušumgal-gin₇ kur-re uš₁₁ ba-e-šum₂
#lem: ušumgal[great dragon]; kur[mountain(s)]; uš[poison]; šum[give]
#tr.en: When like @wDN{Iškur} you roar at the earth, 
#etcsl: line-id=9

10. {d}iškur-gin₇ ki šegₓ(|KA×LI|) gi₄-a-za {d}ezina₂ la-ba-e-ši-ŋal₂
#lem: Iškur[1]DN; ki[place]; šeg[voice]; gi[turn]; Ezina[1]DN; ŋal[⟦be⟧ to be (there]
#tr.en: no vegetation can stand up to you. 
#etcsl: line-id=10

11. a-ma-ru kur-bi-ta ed₃-de₃
#lem: amaru[flood]; kur[mountain(s)]; ed[go up]
#tr.en: As a flood descending upon (?) those foreign lands, 
#etcsl: line-id=11

12. saŋ-kal an ki-a {d}inana-bi-me-en
#lem: saŋkal[foremost]; an[sky]; ki[place]; Inanak[1]DN
#tr.en: powerful one of heaven and earth, you are their @wDN{Inana}. 
#etcsl: line-id=12

13. izi bar₇-bar₇-ra kalam-e šeŋ₃-ŋa₂
#lem: izi[fire]; bar[burn]; kalam[the Land (of Sumer)]; šeŋ[rain]
#tr.en: Raining blazing fire down upon the Land, 
#etcsl: line-id=13

14. an-ne₂ me šum₂-ma nin ur-ra u₅-a
#lem: An[1]DN; me[Being]; šum[give]; nin[lady]; ur[dog]; u[ride]
#tr.en: endowed with divine powers by @wDN{An}, lady who rides upon a beast, 
#etcsl: line-id=14

15. inim kug an-na-ta inim dug₄-dug₄
#lem: inim[word]; kug[purify]; An[1]DN; inim[word]; dug[speak]
#tr.en: whose words are spoken at the holy command of @wDN{An}! 
#etcsl: line-id=15

16. biluda{da} gal-gal-la niŋ₂-zu a-ba mu-un-zu
#lem: biluda[rituals]; gal[big]; niŋ[thing]; aba[who?]; zu[know]
#tr.en: The great rites are yours: who can fathom them? 
#etcsl: line-id=16

17. kur gul-gul ud-de₃ a₂ ba-e-šum₂
#lem: kur[mountain(s)]; gul[destroy]; ud[storm]; a[arm]; šum[give]
#tr.en: Destroyer of the foreign lands, you confer strength on the storm. 
#etcsl: line-id=17

18. ki aŋ₂ {d}en-lil₂-la₂ kalam-ma ni₂ mi-ni-ri
#lem: ki[place]; aŋ[measure]; Enlil[1]DN; kalam[the Land (of Sumer)]; ni[fear]; ri[impose]
#tr.en: Beloved of @wDN{Enlil}, you have made awesome terror weigh upon the Land. 
#etcsl: line-id=18

19. a₂ aŋ₂-ŋa₂ an-na-ke₄ ba-gub-be₂-en
#lem: a[arm]; aŋ[measure]; An[1]DN; gub[stand]
#tr.en: You stand at the service of @wDN{An's} commands. 
#etcsl: line-id=19

20. nin-ŋu₁₀ za-pa-aŋ₂-zu-še₃ kur i₃-gam-gam-e
#lem: nin[lady]; zipaŋ[voice]; kur[mountain(s)]; gurum[bend]
#tr.en: At your battle-cry, my lady, the foreign lands bow low. 
#etcsl: line-id=20

21. ni₂ me-lem₄ u₁₈-lu-da nam-lu₂-ulu₃
#lem: ni[fear]; melim[frightening splendor]; ulu[south wind]; namlulu[humanity]
#tr.en: When humanity comes before you in awed silence at the terrifying radiance and tempest, 
#etcsl: line-id=21

22. niŋ₂-me-ŋar ŋiri₃-bi u₃-mu-ri-gub
#lem: niŋmeŋar[silence]; ŋiri[foot]; gub[stand]
#tr.en: you grasp the most terrible of all the divine powers. 
#etcsl: line-id=22

23. me-ta me huš-bi šu ba-e-re-ti
#lem: me[Being]; me[Being]; huš[reddish]; šu[hand]; teŋ[approach]
#tr.en: Because of you, the threshold of tears is opened, 
#etcsl: line-id=23

24. i-dub er₂-ra-ke₄ ŋal₂ ma-ra-ab-taka₄
#lem: idib[threshold]; er[tears]; ŋal[open]; taka[set aside]
#tr.en: and people walk along the path of the house of great lamentations. 
#etcsl: line-id=24

25. e₂ a-nir gal-gal-la sila-ba mu-ri-du
#lem: e[house]; anir[lament]; gal[big]; sila[street]; du[go]
#tr.en: In the van of battle, all is struck down before you. 
#etcsl: line-id=25

26. igi me₃-ta niŋ₂ ma-ra-ta-si-ig
#lem: igi[eye]; me[battle]; niŋ[thing]; sig[put into]
#tr.en: With your strength, 
#etcsl: line-id=26

27. nin-ŋu₁₀ a₂ ni₂-za {na₄}zu₂ zu₂ i₃-gu₇-e
#lem: nin[lady]; a[arm]; ni[self]; zu[hard stone]; zu[tooth]; gu[eat]
#tr.en: my lady, teeth can crush flint. 
#etcsl: line-id=27

28. ud du₇-du₇-gin₇ i₃-du₇-du₇-de₃-en
#lem: ud[storm]; du[push]; du[push]
#tr.en: You charge forward like a charging storm. 
#etcsl: line-id=28

29. ud gu₃ ra-ra-da gu₃ im-da-ab-ra-ra-an
#lem: ud[storm]; gu[voice]; rah[beat]; gu[voice]; rah[beat]
#tr.en: You roar with the roaring storm, 
#etcsl: line-id=29

30. {d}iškur-da šegₓ(|KA×LI|) mu-da-an-gi₄-gi₄-in
#lem: Iškur[1]DN; šeg[voice]; gi[turn]
#tr.en: you continually thunder with @wDN{Iškur}. 
#etcsl: line-id=30

31. im-hul-im-hul-da im-da-kuš₂-u₃-de₃-en
#lem: imhul[destructive wind]; kušu[tired]
#tr.en: You spread exhaustion with the stormwinds, 
#etcsl: line-id=31

32. ŋiri₃-za nu-kuš₂-u₃ i₃-im-si
#lem: ŋiri[foot]; kušu[tired]; si[fill]
#tr.en: while your own feet remain tireless. 
#etcsl: line-id=32

33. balaŋ a-nir-ra-ta i-lu im-da-ab-be₂
#lem: balaŋ[an instrument]; anir[lament]; ilu[lament]; dug[speak]
#tr.en: With the lamenting @fsux{balaŋ} drum a lament is struck up. 
#etcsl: line-id=33

34. nin-ŋu₁₀ {d}a-nun-na diŋir gal-gal-e-ne
#lem: nin[lady]; Anunak[1]DN; diŋir[deity]; gal[big]
#tr.en: My lady, the great @wDN{Anuna} gods fly from you to the ruin mounds like scudding bats. 
#etcsl: line-id=34

35. su-din{mušen} dal-la-gin₇ du₆-de₃ mu-e-ši-ib-ra-aš
#lem: sudin[bat]; dal[fly]; dud[(ruin) mound]; rah[beat]
#tr.en: They dare not stand before your terrible gaze. 
#etcsl: line-id=35

36. igi huš-a-za (1:la-ba-sug₂-ge-de₃-eš:1)
#lem: igi[eye]; huš[reddish]; gub[stand]
#tr.en: They dare not confront your terrible countenance. 
#etcsl: line-id=36

:36v.1.1: ($some mss. have instead:$) la-ba-sug₂-ge-eš-am₃
#lem: gub[stand]

37. saŋ-ki huš-a-za saŋ nu-mu-un-de₃-ŋa₂-ŋa₂
#lem: saŋki[forehead]; huš[reddish]; saŋ[head]; ŋar[put]
#tr.en: Who can cool your raging heart? 
#etcsl: line-id=37

38. šag₄ ib₂-ba-za a-ba ib₂-te-en-te-en
#lem: šag[heart]; ib[angry]; aba[who?]; ten[extinguish]
#tr.en: Your malevolent anger is too great to cool. 
#etcsl: line-id=38

39. šag₄ hul-ŋal₂-la-za te-en-ten-bi mah-am₃
#lem: šag[heart]; huluŋal[evil]; ten[extinguish]; mah[great]
#tr.en: Lady, can your mood be soothed? 
#etcsl: line-id=39

40. nin ur₅ i₃-sag₉ nin šag₄ i₃-hul₂
#lem: nin[lady]; ur[liver]; sag[good]; nin[lady]; šag[heart]; hul[rejoice]
#tr.en: Lady, can your heart be gladdened? 
#etcsl: line-id=40

41. ib₂-ba nu-te-en-te-en dumu gal {d}suen-na
#lem: ib[angry]; ten[extinguish]; dumu[child]; gal[big]; Suen[1]DN
#tr.en: Eldest daughter of @wDN{Suen}, your rage cannot be cooled! 
#etcsl: line-id=41

42. nin kur-ra dirig-ga a-ba ki-za ba-an-tum₃
#lem: nin[lady]; kur[mountain(s)]; dirig[make more than]; aba[who?]; ki[place]; tum[bring]
#tr.en: Lady supreme over the foreign lands, who can take anything from your province? 
#etcsl: line-id=42

43. (1:hur-saŋ ki-za:1) ba-e-de₃-gid₂-de₃-en {d}ezina₂ niŋ₂-gig-bi
#lem: hursaŋ[mountain]; ki[place]; gid[long]; Ezina[1]DN; niŋgig[that which is bad]
#tr.en: @varh[t4072.v1]{Once you have extended your province over the hills } @vart[t4072.v2,t4072.v1]{@varn{2 mss. have instead:} If you frown at the mountains }, vegetation there is ruined. 
#etcsl: line-id=43

:43v.1.1: ($2 mss. have instead:$) kur saŋ-ki-za
#lem: kur[mountain(s)]; saŋki[forehead]

44. (1:abul-la-ba:1) izi mu-ni-in-ri-ri
#lem: abula[gate]; izi[fire]; ri[impose]
#tr.en: Their @varh[t4072.v3]{great gateways } @vart[t4072.v4,t4072.v3]{@varn{1 ms. has instead:} palaces } are set afire. 
#etcsl: line-id=44

:44v.1.1: ($1 ms. has instead:$) e₂-gal-la-ba
#lem: egal[palace]

45. id₂-ba uš₂ ma-ra-an-de₂ uŋ₃-bi (1:ma-ra-na₈-na₈:1)
#lem: id[river]; uš[blood]; de[pour]; uŋ[people]; naŋ[drink]
#tr.en: Blood is poured into their rivers because of you, 
#etcsl: line-id=45

:45v.1.1: ($2 mss. have instead:$) ba-ra-na₈-na₈
#lem: naŋ[drink]

46. ugnim-bi ni₂-bi-a ma-ra-ab-lah₅-e
#lem: ugnim[army]; ni[self]; lah[plural stem of tum ⟦bring⟧]
#tr.en: and their people @varh[t4072.v5]{must drink it } @vart[t4072.v6,t4072.v5]{@varn{2 mss. have instead:} could not drink }. They must lead their troops captive before you, all together. 
#etcsl: line-id=46

47. zu₂ keše₂-bi ni₂-bi-a ma-ra-ab-si-il-le
#lem: zu[tooth]; kešed[bind]; ni[self]; sil[split]
#tr.en: They must scatter their élite regiments for you, all together. 
#etcsl: line-id=47

48. ŋuruš a₂-tuku-bi ni₂-bi-a ma-ra-ab-sug₂-ge-eš
#lem: ŋuruš[young adult male]; atuku[powerful]; ni[self]; sug[stand]
#tr.en: They must stand their able-bodied young men at your service, all together. 
#etcsl: line-id=48

49. iri-ba ki-e-ne-di-ba mir i-ib₂-si
#lem: iri[city]; kiʾenedi[play area]; mir[north wind]; si[fill]
#tr.en: Tempests have filled the dancing-places of their cities. 
#etcsl: line-id=49

50. ŋuruš šag₄-gan-bi LU₂-eš₂ ma-ra-ab-sar-re-eš
#lem: ŋuruš[young adult male]; šaggan[perfect]; heše[oppressed]; sar[run]
#tr.en: They drive their young men before you as prisoners. 
#etcsl: line-id=50

51. iri kur za-ra li-bi₂-in-dug₄-ga-am₃
#lem: iri[city]; kur[mountain(s)]; zaʾe[you]; dug[speak]
#tr.en: Your holy command has been spoken over the city which has not declared @q[city,Inana]{“The foreign lands are yours!”}, wherever they have not declared @q[,Inana]{“It is your own father's!”}; and it is brought back under your feet. 
#etcsl: line-id=51

52. a-a ugu-zu li-bi₂-in-eš-am₃
#lem: aya[father]; ugu[bear]; e[speak]
#tr.en: Responsible care is removed from its sheepfolds. 
#etcsl: line-id=52

53. inim kug-zu bi₂-in-dug₄ ki ŋiri₃-za he₂-eb-gi₄
#lem: inim[word]; kug[pure]; dug[speak]; ki[place]; ŋiri[foot]; gi[turn]
#tr.en: Its woman no longer speaks affectionately with her husband; 
#etcsl: line-id=53

54. šag₄ tur₃-bi-ta ŋiri₃ he₂-eb₂-ta-an-ze₂-er
#lem: šag[heart]; tur[animal stall]; ŋiri[foot]; zir[tear out]
#tr.en: at dead of night she no longer takes counsel with him, 
#etcsl: line-id=54

55. munus-bi dam-a-ni-ta sag₉-ga na-an-da-ab-be₂
#lem: munus[woman]; dam[spouse]; sag[good]; dug[speak]
#tr.en: and she no longer reveals to him the pure thoughts of her heart. 
#etcsl: line-id=55

56. ŋi₆ u₃-na ad na-an-di-ni-ib-gi₄-gi₄
#lem: ŋi[night]; ŋiʾunak[night]; ad[voice]; gi[turn]
#tr.en: Impetuous wild cow, 
#etcsl: line-id=56

57. niŋ₂ kug šag₄-ga-na nam-mu-da-an-bur₂-re
#lem: niŋ[thing]; kug[purify]; šag[heart]; bur[spread out]
#tr.en: great daughter of @wDN{Suen}, 
#etcsl: line-id=57

58. u₃-sumun₂ zid-zid dumu gal {d}suen-na
#lem: sumun[wild cow]; zid[right]; dumu[child]; gal[big]; Suen[1]DN
#tr.en: lady greater than @wDN{An}, 
#etcsl: line-id=58

59. nin an-ra dirig-ga a-ba ki-za ba-an-tum₃
#lem: nin[lady]; An[1]DN; dirig[make more than]; aba[who?]; ki[place]; tum[bring]
#tr.en: who can take anything from your province? 
#etcsl: line-id=59

60. me zid-de₃ nin gal nin-e-ne
#lem: me[Being]; zid[right]; nin[lady]; gal[big]; nin[lady]
#tr.en: Great queen of queens, issue of a holy womb for righteous divine powers, 
#etcsl: line-id=60

61. šag₄ kug-ta e₃-a ama ugu-ni-ir dirig-ga
#lem: šag[heart]; kug[pure]; e[leave]; ama[mother]; ugu[bear]; dirig[make more than]
#tr.en: greater than your own mother, wise and sage, 
#etcsl: line-id=61

62. gal-zu igi-ŋal₂ nin kur-kur-ra
#lem: galanzu[wise]; igiŋal[wise]; nin[lady]; kur[mountain(s)]
#tr.en: lady of all the foreign lands, life-force of the teeming people: 
#etcsl: line-id=62

63. zi-ŋal₂ uŋ₃ lu-a šir₃ kug-zu ga-am₃-dug₄
#lem: ziŋal[living things]; uŋ[people]; lu[abundant]; šir[sing]; kug[pure]; dug[speak]
#tr.en: I will recite your holy song! True goddess fit for divine powers, 
#etcsl: line-id=63

64. diŋir zid me-a tum₂-ma gal-bi dug₄-ga-zu mah-am₃
#lem: diŋir[deity]; zid[right]; me[Being]; tum[suitable]; gal[big]; dug[speak]; mah[great]
#tr.en: your splendid utterances are magnificent. Deep-hearted, 
#etcsl: line-id=64

65. šag₄ su₃-ra₂ munus zid šag₄ zalag-zalag-ga (1:me-zu:1) ga-mu-ra-ab-dug₄
#lem: šag[heart]; sud[distant]; munus[woman]; zid[right]; šag[heart]; zalag[bright]; me[Being]; dug[speak]
#tr.en: good woman with a radiant heart, I will enumerate @varh[t4072.v7]{your divine powers } @vart[t4072.v8,t4072.v7]{@varn{2 mss. have instead:} good divine powers } @vart[t4072.v9,t4072.v7]{@varn{1 ms. has instead:} holy divine powers } for you! 
#etcsl: line-id=65

