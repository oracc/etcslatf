#etcsl: line-id=G.123

G.124. ki kur₉-ra-bi %e ma-a-ar %s lu₂ mu-da-an-zu-am₃
#tr.en: are burning in dark distress have been made known to me!
#lem: ki[place]; kur[enter]; meʾe[I]IP; lu[person]; zu[know]
#etcsl: line-id=G.124

G.125. a-ra₂ gig-ga šag₄ bur₁₂-ra-ŋu₁₀
#tr.en: My people whose hearts have been broken on the bitter way
#lem: ara[way]; gig[sick]; šag[heart]; bur[tear out]
#etcsl: line-id=G.125

G.126. u₅-a tur-ra-ŋu₁₀ er₂-ra ma-an-du₁₂-am₃
#tr.en: perform the lullabies of my young ones for me in tears!
#lem: ua[oh!]; tur[small]; er[tears]; du[play (a musical instrument)]
#etcsl: line-id=G.126

G.127. nin e₂ du₃-a ki-tuš-a-ne-ne
#tr.en: The well-built houses, ladies' dwellings, were falsely founded,
