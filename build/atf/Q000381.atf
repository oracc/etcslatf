#etcsl: line-id=E.110

E.111. %e u₃-mu-un-bi %s me-bi ba-ra-an-e₃-a
#tr.en: lord who has removed its divine powers!
#lem: umun[lord]N; me[Being]; e[leave]
#etcsl: line-id=E.111

E.112. a₂-bi nu-mu-un-tag-ga-am₃ en₃-bi nu-tar-ra-am₃
