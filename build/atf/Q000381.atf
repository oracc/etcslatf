#lem: šud[prayer]; ŋeš[tree]; tuku[acquire]; igi[eye]; bar[place outside]
#etcsl: line-id=T.307

T.308. {d}iš-me-{d}da-gan-na inim-ma-ni su-a-na ba-dug₃-ga-am₃
