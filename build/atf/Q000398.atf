&Q000398 = A praise poem of Šulgi (Šulgi D)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.2.4.2.04
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.2.4.2.04&display=Crit&charenc=gcirc#

1. lugal-ŋu₁₀ gud# [gal] a₂ gu₂-nu muš-huš [igi] piriŋ-ŋa₂
#lem: lugal[king]; gud[bull]; gal[big]; a[arm]; gunu[speckled]; mušhuš[monster]; igi[eye]; piriŋ[lion]
#tr.en: O my king, great bull with splendid limbs, 
#etcsl: line-id=1

2. sipad šul-gi gud gal a₂ gu₂-nu muš-huš igi piriŋ-ŋa₂
#lem: sipad[shepherd]; Šulgir[1]RN; gud[bull]; gal[big]; a[arm]; gunu[speckled]; mušhuš[monster]; igi[eye]; piriŋ[lion]
#tr.en: dragon with a lion's eyes! Shepherd @wRN{Šulgi}, 
#etcsl: line-id=2

3. amar tur₃ he₂-ŋal₂-la tud-da gu₂ mar-mar-re di-de₃
#lem: amar[calf]; tur[animal stall]; heŋal[plenty]; utud[give birth (to)]; gu[neck]; mer[cvve]; di[speak]
#tr.en: great bull with splendid limbs, dragon with a lion's eyes! 
#etcsl: line-id=3

4. kalag-ga nam-ur-saŋ-ŋa₂ tum₂-ma he₂-du₇ kalam-ma-na
#lem: kalag[strong]; namursaŋ[heroism]; tum[suitable]; hedu[ornament]; kalam[the Land (of Sumer)]
#tr.en: Bull-calf born in the cattle-pen of abundance, thriving there! 
#etcsl: line-id=4

5. nitah zid {d}utu-u₃ niŋ₂-si-sa₂ saŋ-e-eš₂ rig₇-ga
#lem: nita[male]; zid[right]; Utu[1]DN; niŋsisa[justice]; saŋ[head]; rig[donate]
#tr.en: Mighty one fit for heroism, the ornament of his Land! 
#etcsl: line-id=5

6. nemur₂(|PIRIG.TUR|) ban₃-da ga zid gu₇-a gud a₂ gur₈ piriŋ gal-še₃ tud-da
#lem: nemur[leopard]; banda[junior]; ga[milk]; zid[right]; gu[eat]; gud[bull]; a[arm]; gurum[bend]; piriŋ[lion]; gal[big]; utud[give birth (to)]
#tr.en: Righteous man, invested with justice by @wDN{Utu}! 
#etcsl: line-id=6

7. sun₄ za-gin₃ gaba kug-ga u₆ di
#lem: sum[beard]; zagin[lapis lazuli]; gaba[breast]; kug[pure]; u[admiration]; di[speak]
#tr.en: Fierce leopard who feeds on rich milk, rampant bull who was born to be a great beast! 
#etcsl: line-id=7

8. lugal saŋ-men-na hi-li-bi
#lem: lugal[king]; saŋmen[crown]; hili[attractiveness]
#tr.en: A lapis-lazuli beard, a holy breast -- marvellous to behold! 
#etcsl: line-id=8

9. šul-gi aga zid-da he₂-du₇-bi
#lem: Šulgir[1]RN; aga[tiara]; zid[right]; hedu[ornament]
#tr.en: O king, joy of the royal tiara! 
#etcsl: line-id=9

10. suh-gir₁₁ nam-diŋir-ra tum₂-tum₂
#lem: suhgir[diadem]; namdiŋir[divinity]; tum[carry]
#tr.en: @wRN{Šulgi}, ornament of the legitimate crown, 
#etcsl: line-id=10

11. lu₂ an-ne₂ mu dug₃-ga sa₄-a
#lem: lu[person]; An[1]DN; mu[name]; dug[good]; še[call by name]
#tr.en: wearing the diadem of godhead, named by @wDN{An} with a good name! 
#etcsl: line-id=11

12. sipad zid a₂ šum₂-ma {d}en-lil₂-la₂
#lem: sipad[shepherd]; zid[right]; a[arm]; šum[give]; Enlil[1]DN
#tr.en: Good shepherd, endowed with strength by @wDN{Enlil}, 
#etcsl: line-id=12

13. šul-gi {d}nin-lil₂-la₂ ki aŋ₂ šag₄-ga-na
#lem: Šulgir[1]RN; Ninlil[1]DN; ki[place]; aŋ[measure]; šag[heart]
#tr.en: @wRN{Šulgi}, the beloved of @wDN{Ninlil's} heart! 
#etcsl: line-id=13

14. lugal-ŋu₁₀ za-gin₇ a-ba an-ga-kalag a-ba an-ga-a-da-sa₂
#lem: lugal[king]; zaʾe[you]; aba[who?]; kalag[strong]; aba[who?]; sa[equal]
#tr.en: O, my king, 
#etcsl: line-id=14

15. a-ba za-gin₇ šag₄-ta ŋeštug₂-ga šu daŋal mu-ni-in-dug₄
#lem: aba[who?]; zaʾe[you]; šag[heart]; ŋeštug[ear]; šu[hand]; daŋal[wide]; dug[speak]
#tr.en: who is as mighty as you, and who rivals you? 
#etcsl: line-id=15

16. nam-ur-saŋ-zu-u₃ [pa] he₂#-e₃-e₃
#lem: namursaŋ[heroism]; pa[branch]; e[leave]
#tr.en: Indeed, who is there who from birth is as richly endowed with understanding as you? 
#etcsl: line-id=16

17. nam-kalag-ga-zu [mi₂ dug₃ he₂]-e
#lem: namkalag[strength]; mi[cvne]; dug[good]; e[speak]
#tr.en: May your heroism shine forth, and may your might be respectfully praised! 
#etcsl: line-id=17

18. a nam-UG [...] sah₆-me-en₃
#lem: a[water]; X; X; zah[disappear]
#tr.en: You destroy the offspring of ……. You are mighty, ……. 
#etcsl: line-id=18

19. gaba-ŋal₂ X [...]
#lem: gabaŋal[forceful]; X; X
#tr.en: You are brave, ……. When in the @wTN{E-kur} ……, 
#etcsl: line-id=19

20. lipiš-tuku [...]
#lem: lipištuku[furious]; X
#tr.en: in the hostile foreign lands you plunder cities; like a panting lion, 
#etcsl: line-id=20

21. ud e₂-kur-ra# [...]
#lem: ud[sun]; Ekur[1]TN; X
#tr.en: you ……; like a cheetah, you ……; 
#etcsl: line-id=21

22. kur gu₂-erim₂#-[ŋal₂-la-še₃] iri gul-[gul-me-en₃]
#lem: kur[mountain(s)]; guʾerimŋal[hostile]; iri[city]; gul[destroy]
#tr.en: a dragon, you ……; 
#etcsl: line-id=22

23. piriŋ eme [ed₂-de₃ ...]
#lem: piriŋ[lion]; eme[tongue]; e[leave]; X
#tr.en: You hurl angry words against the people of the foreign lands that are hostile to @wDN{Nanna}. 
#etcsl: line-id=23

24. nemur₂(|PIRIG.TUR|)-[gin₇ ...]
#lem: nemur[leopard]; X
#tr.en: You are adorned with splendid horns, 
#etcsl: line-id=24

25. ušumgal# [...]
#lem: ušumgal[great dragon]; X
#tr.en: like a virile wild bull born to be a great wild bull. 
#etcsl: line-id=25

$ 2 lines missing
28. kur gu₂-erim₂-ŋal₂ {d}nanna-a-ka uŋ₃-ba gu₃ mi-ri₂-a ra-ra-me-en₃
#lem: kur[mountain(s)]; guʾerimŋal[hostile]; Nanna[1]DN; uŋ[people]; gu[voice]; mir[angry]; rah[beat]
#tr.en: You are a chariot, 
#etcsl: line-id=28

29. am zid am gal-še₃ tud-da-gin₇ si-muš gu₂-nu-me-en₃
#lem: am[wild bull]; zid[right]; am[wild bull]; gal[big]; utud[give birth (to)]; simuš[brilliance]; gunu[speckled]
#tr.en: a waggon set on the road. 
#etcsl: line-id=29

30. niŋ₂-šu {ŋiš}gigir₂ har-ra-an-na sig₁₀-ga-me-en₃
#lem: niŋšuk[chariot]; gigir[chariot]; harran[route]; sig[put into]
#tr.en: Like a noble ass, 
#etcsl: line-id=30

31. {anše}ni-is-ku-gin₇ kaš₄ ne-ŋal₂-la-zu-u₂ {d}en-lil₂ hul₂-le-me-en₃
#lem: nisku[description of equids]; kaš[run]; neŋal[mighty]; Enlil[1]DN; hul[rejoice]
#tr.en: by your vigorous running you bring joy to @wDN{Enlil}. 
#etcsl: line-id=31

32. {ŋiš}ildag₂ ki-en-DU zag-ga du₃-a-gin₇ usu-a-me-en₃
#lem: ildag[poplar]; ki.en.DU[watercourse]; zag[side]; du[build]; usu[strength]
#tr.en: You are as strong as an @fsux{ildag} tree planted by the side of a watercourse. 
#etcsl: line-id=32

33. mes zid gurun₇-na gun₃-a-gin₇ u₆ di dug₃-ga-me-en₃
#lem: mes[tree]; zid[right]; gurun[fruit]; gunu[speckled]; u[admiration]; di[speak]; dug[good]
#tr.en: You are a sweet sight, like a fertile @fsux{meš} tree laden with colourful fruit. 
#etcsl: line-id=33

34. ŋišnimbar dilmun kug-gin₇ {d}nin-e₂-gal-ke₄ mi₂ zid dug₄-ga-me-en₃
#lem: ŋešnimbar[date-palm]; Dilmun[1]GN; kug[pure]; Ninegalak[1]DN; mi[cvne]; zid[right]; dug[speak]
#tr.en: You are cherished by @wDN{Ninegala}, like a date palm of holy @wGN{Dilmun}. 
#etcsl: line-id=34

35. {ŋiš}erin duru₅ ha-šu-ur₂-re mu₂-a-gin₇ ŋissu dug₃-ga-me-en₃
#lem: eren[cedar]; duru[wet]; hašur[tree]; mu[grow]; ŋissu[shade]; dug[good]
#tr.en: You have a pleasant shade, like a sappy cedar growing amid the cypresses. 
#etcsl: line-id=35

36. lugal-ŋu₁₀ za-gin₇ a-ba an-ga-kalag a-ba an-ga-a-da-sa₂
#lem: lugal[king]; zaʾe[you]; aba[who?]; kalag[strong]; aba[who?]; sa[equal]
#tr.en: O, my king, 
#etcsl: line-id=36

37. a-ba za-gin₇ šag₄-ta ŋeštug₂-ga šu daŋal mu-ni-in-dug₄
#lem: aba[who?]; zaʾe[you]; šag[heart]; ŋeštug[ear]; šu[hand]; daŋal[wide]; dug[speak]
#tr.en: who is as mighty as you, and who rivals you? 
#etcsl: line-id=37

38. nam-ur-saŋ-zu-u₃ pa he₂-e₃-e₃
#lem: namursaŋ[heroism]; pa[branch]; e[leave]
#tr.en: Indeed, who is there who from birth is as richly endowed with understanding as you? 
#etcsl: line-id=38

39. nam-kalag-ga-zu-u₃ mi₂ dug₃ he₂-e
#lem: namkalag[strength]; mi[cvne]; dug[good]; e[speak]
#tr.en: May your heroism shine forth, and may your might be respectfully praised! 
#etcsl: line-id=39

40. sipad šul-gi a-zu [šag₄] kug#-ga ud ba-an-ri-a
#lem: sipad[shepherd]; Šulgir[1]RN; azu[doctor]; šag[heart]; kug[pure]; ud[sun]; ri[impose]
#tr.en: Shepherd @wRN{Šulgi}, when your seed was placed in the holy womb, 
#etcsl: line-id=40

41. ama ugu₄-zu {d}nin-sumun₂#-[ke₄] mu-u₃-tud-e-[en₃]
#lem: ama[mother]; ugu[bear]; Ninsumunak[1]DN; utud[give birth (to)]
#tr.en: your mother @wDN{Ninsumun} gave birth to you; 
#etcsl: line-id=41

42. diŋir-zu kug {d}lugal#-[ban₃-da] mu-u₃-dim₂-e-[en₃]
#lem: diŋir[deity]; kug[purify]; Lugalbanda[1]DN; dim[create]
#tr.en: your personal god, holy @wDN{Lugalbanda}, fashioned you; 
#etcsl: line-id=42

43. ama {d}nin-tur₅-re# [mi₂ zid mu-u₃-dug₄]
#lem: ama[mother]; Nintur[1]DN; mi[cvne]; zid[right]; dug[speak]
#tr.en: Mother @wDN{Nintur} nurtured you; 
#etcsl: line-id=43

44. an-ne₂ mu dug₃-[ga mu-ri-in-sa₄]
#lem: An[1]DN; mu[name]; dug[good]; še[call by name]
