@div segment B

@div proverb 17.b1

B.17.b1.1. [...] X še ŠA# [...]
#lem: X; X; še[barley]; X; X
#tr.en: @gap{3 lines fragmentary}
#etcsl: line-id=B.17.b1.1

B.17.b1.2. X ki# aŋ₂-ŋa₂ X [...]
#lem: X; ki[place]; aŋ[measure]; X; X
#etcsl: line-id=B.17.b1.2

B.17.b1.3. [...] NE-am₃ dug₃ lul# [...]
#lem: X; X; dug[good]; lul[false]; X
#etcsl: line-id=B.17.b1.3

@end proverb

@div proverb 17.b2

B.17.b2.4. sukud#-de₃ an-na šu nu-um-[da-la₂]
#lem: sukud[height]; an[sky]; šu[hand]; la[hang]
#tr.en: @note{cf. @xref[t.6.1.22,]{6.1.22: ll. 203-206}, @xref[t.1.8.1.5,]{1.8.1.5: ll. 28-29}, @xref[t.1.8.1.5.1,]{1.8.1.5.1: ll. 12-13}, 6.3.a: ll. 17-18} No one is tall enough to reach up and touch the heavens. 
#etcsl: line-id=B.17.b2.4

#etcsl#cf cf. 6.1.22: ll. 203-206, 1.8.1.5: ll. 28-29, 1.8.1.5.1: ll. 12-13, 6.3.a: ll. 17-18

B.17.b2.5. daŋal#-e ki-a <igi> nu-um-ma-an-il₂-il₂
#lem: daŋal[wide]; ki[place]; igi[eye]; il[raise]
#tr.en: No one is broad enough to lift his gaze over the whole earth. 
#etcsl: line-id=B.17.b2.5

B.17.b2.6. kalag#-ga ki-nu₂ ni₂ nu-mu-un-gid₂-de₃
#lem: kalag[strong]; kinud[sleeping quarter]; ni[self]; gid[long]
#tr.en: No one is strong enough even to stretch himself fully in his bed. 
#etcsl: line-id=B.17.b2.6

B.17.b2.7. [za]-e#-me-en ud-gin₇ dug₄-dug₄-ga
#lem: zaʾe[you]; ud[storm]; dug[speak]
#tr.en: But you (?), 
#etcsl: line-id=B.17.b2.7

B.17.b2.8. piriŋ#-gin₇ ne he₂-gub
#lem: piriŋ[lion]; ni[self]; gub[stand]
#tr.en: who roar like a storm -- may you establish yourself like a lion. 
#etcsl: line-id=B.17.b2.8

B.17.b2.9. X-zu {ŋiš}kiri₆ a he₂-eb-de₆
#lem: X; kiri[(fruit) plantation]; a[water]; de[carry]
#tr.en: No man can bring about your demise. 
#etcsl: line-id=B.17.b2.9

B.17.b2.10. lu₂ nam-bi₂-ib-til-e
#lem: lu[person]; til[complete]
#etcsl: line-id=B.17.b2.10

@end proverb

@div proverb 17.b3

B.17.b3.11. šul diŋir-ŋu₁₀ ŋiri₃ {d}lamma-ŋu₁₀#
#lem: šul[youth]; diŋir[deity]; ŋiri[foot]; lammar[(female) tutelary deity]
#tr.en: @note{cf. @xref[t.6.1.09,t.6.1.09.a8]{6.1.09.a8}, @xref[t.6.1.10,t.6.1.10.9]{6.1.10.9-12}, @xref[t.6.1.19,t.6.1.19.a1]{6.1.19.a1}, 5.6.7: ll. 28-31} I was a youth -- now my personal god, and access to my protective deity, 
#etcsl: line-id=B.17.b3.11

#etcsl#cf cf. 6.1.09.a8, 6.1.10.9-12, 6.1.19.a1, 5.6.7: ll. 28-31

B.17.b3.12. nam-ŋuruš anše kar-ra#-[gin₇]
#lem: namŋuruš[manliness]; anše[equid]; kar[flee]
#tr.en: and my youthful vigour have all left my loins, like a run-away donkey. 
#etcsl: line-id=B.17.b3.12

B.17.b3.13. haš₂-ŋa₂ ba-an-[taka₄]
#lem: haš[thigh]; taka[set aside]
#tr.en: My black mountain has sprouted white gypsum. 
#etcsl: line-id=B.17.b3.13

B.17.b3.14. hur-saŋ gig₂-ŋu₁₀ im-babbar ba#-[an-mu₂]
#lem: hursaŋ[mountain]; giggig[black]; imbabbar[gypsum]; mu[grow]
#tr.en: My mother …… from the forest …… has given me paralysed hands. 
#etcsl: line-id=B.17.b3.14

B.17.b3.15. ama-ŋu₁₀ tir-ta ŋiš dab₅-ba# šu dab₅ mu-da-an-šum₂
#lem: ama[mother]; tir[forest]; ŋeš[tree]; dab[seize]; šu[hand]; dab[seize]; šum[give]
#tr.en: My mongoose, 
#etcsl: line-id=B.17.b3.15

B.17.b3.16. {d}nin-kilim i₃ niŋ₂ hab₂-ba gu₇#-[gu₇-ŋu₁₀]
#lem: ninkilim[mongoose]; i[oil]; niŋ[thing]; hab[malodorous]; gu[eat]
#tr.en: which used to eat strong-smelling butter, 
#etcsl: line-id=B.17.b3.16

B.17.b3.17. dug i₃-nun-na-še₃ gu₂ nu-mu-un-ši-la₂-e
#lem: dug[(clay) pot]; inun[ghee]; gu[neck]; la[hang]
#tr.en: can no longer stretch its neck even towards a jar of ghee. 
#etcsl: line-id=B.17.b3.17

@end proverb

@div proverb 17.b4

B.17.b4.18. ukur₃-re dumu-na tibir₂ 1(DIŠ)-am₃ šu nu-um-ma-ni-dug₄-ge#
#lem: ukur[poor]; dumu[child]; tibir[hand]; n; šu[hand]; dug[speak]
#tr.en: @note{cf. @xref[t.6.1.02,t.6.1.02.23]{6.1.02.23}} The poor man does not strike his son a single blow; 
#etcsl: line-id=B.17.b4.18

#etcsl#cf cf. 6.1.02.23

B.17.b4.19. gi₁₆-sa da-ri₂-še₃ mu-un-[na]-ni-ak-[e]
#lem: gilsa[treasure]; dari[eternal]; ak[do]
#tr.en: he treasures him highly forever. 
#etcsl: line-id=B.17.b4.19

@end proverb

@div proverb 17.b5

B.17.b5.20. ukur₃-re# al#-ŋal₂-la X X X tu₇ |DAG.KISIM₅×X|-ra bi₂-in-šu₂
#lem: ukur[poor]; ŋal[⟦be⟧ to be (there]; X; X; X; tu[soup]; ubur[breast]; šuš[cover]
#tr.en: @note{cf. @xref[t.6.1.02,t.6.1.02.22]{6.1.02.22}} When someone is poor ……, they dine on the broth of the human breast. 
#etcsl: line-id=B.17.b5.20

#etcsl#cf cf. 6.1.02.22

@end proverb

@div proverb 17.b6

B.17.b6.21. ukur₃ tu₇-a igi bar-ra
#lem: ukur[poor]; tu[soup]; igi[eye]; bar[place outside]
#tr.en: A poor man staring into the soup. 
#etcsl: line-id=B.17.b6.21

@end proverb

@div proverb 17.b7

B.17.b7.22. ŋiš-erin₂ sa ak-am₃ {ŋiš!}pu₂ niŋ₂-lul ak-a
#lem: ŋešrin[scales]; sa[net]; ak[do]; pu[cistern]; niŋlul[falsehood]; ak[do]
#tr.en: @note{cf. @xref[t.6.1.03,t.6.1.03.64]{6.1.03.64}} Scales made with a net are a pit contrived of dishonesty; 
#etcsl: line-id=B.17.b7.22

#etcsl#cf cf. 6.1.03.64

B.17.b7.23. dam-gar₃-ra gu₅-li-ni!(GAN₂)-še₃# lu₂ ši-in-ga-an-tuku-tuku
#lem: damgar[merchant]; guli[friend]; lu[person]; tuku[acquire]
#tr.en: should a man then take a merchant for his friend? 
#etcsl: line-id=B.17.b7.23

@end proverb

@div proverb 17.b8

B.17.b8.24. dam-gar₃-ra kug-babbar %e ta %s ba-an-tur-re-en
#lem: damgar[merchant]; kugbabbar[silver]; ta[what?]QP; tur[small]
#tr.en: @note{cf. @xref[t.6.1.01,t.6.1.01.165]{6.1.01.165}, @xref[t.6.1.03,t.6.1.03.65]{6.1.03.65}, @xref[t.6.1.22,]{6.1.22: ll. 194-196}} You, merchant, 
#etcsl: line-id=B.17.b8.24

#etcsl#cf cf. 6.1.01.165, 6.1.03.65, 6.1.22: ll. 194-196

B.17.b8.25. [u₃] še# %e ta %s ba-an-tur-re-en
#lem: u[and]; še[barley]; ta[what?]QP; tur[small]
#tr.en: how small you made the amount of silver! And how small you made the amount of barley! 
#etcsl: line-id=B.17.b8.25

@end proverb

@div proverb 17.b9

B.17.b9.26. [e₂-gal]
#lem: egal[palace]
#tr.en: @note{cf. @xref[t.6.1.02,t.6.1.02.158]{6.1.02.158}, @xref[t.6.1.14,t.6.1.14.22]{6.1.14.22}, @xref[t.6.1.25,t.6.1.25.10]{6.1.25.10}} The palace: 
#etcsl: line-id=B.17.b9.26

#etcsl#cf cf. 6.1.02.158, 6.1.14.22, 6.1.25.10

B.17.b9.27. [ud] 1(DIŠ)# ama tud-da-am₃#
#lem: ud[sun]; n; ama[mother]; utud[give birth (to)]
#tr.en: one day a mother giving birth, 
#etcsl: line-id=B.17.b9.27

B.17.b9.28. [ud 1(DIŠ) ama a-nir]-ra-am₃
#lem: ud[sun]; n; ama[mother]; anir[lament]
#tr.en: the next day a mother in mourning. 
#etcsl: line-id=B.17.b9.28

@end proverb

@div proverb 17.b10

B.17.b10.29. [...] X [...]
#lem: X; X; X
#etcsl: line-id=B.17.b10.29

@end proverb

