&Q000798 = Proverbs: collection 4
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.6.1.04
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.6.1.04&display=Crit&charenc=gcirc#

@div segment A

@div proverb 4.1

A.4.1.1. 1 dug sukud-ra₂ alan gu₃ de₂-de₂
#lem: n; dug[(clay) pot]; sukud[height]; alan[image]; gu[voice]; de[pour]
#tr.en: Unique: a tall pot and a shouting statue. 
#etcsl: line-id=A.4.1.1

@end proverb

@div proverb 4.2

A.4.2.2. niŋ₂ izi sig₉ me i₃-kal-kal-am₃ egir-ra-bi na
#lem: niŋ[thing]; izi[fire]; sig[put into]; me[Being]; kal[rare]; egir[back]; me[be]
#tr.en: What is placed in the fire has a valuable role to play but leaves nothing behind when it's gone. 
#etcsl: line-id=A.4.2.2

@end proverb

@div proverb 4.3

A.4.3.3. MAŠ# giŋ₄ MAŠ giŋ₄ ki im-du-a-kam
#lem: n; giŋ[unit of weight]; n; giŋ[unit of weight]; ki[place]; du[go]
#tr.en: Half a shekel is half a shekel wherever you go (?); discarded, 
#etcsl: line-id=A.4.3.3

A.4.3.4. šub giŋ₄ ki am muš-a-kam
#lem: šub[fall]; giŋ[unit of weight]; ki[place]; am[wild bull]; muš[snake]
#tr.en: it is a shekel belonging to the place of wild cattle and serpents. 
#etcsl: line-id=A.4.3.4

@end proverb

@div proverb 4.4

A.4.4.5. an an-guru₃ ki šu-ni-še₃ an-la₂
#lem: an[sky]; gur[lift]; ki[place]; šu[hand]; la[hang]
#tr.en: @note{cf. @xref[t.6.1.03,t.6.1.03.167]{6.1.03.167}, @xref[t.6.1.22,]{6.1.22: l. 189}, @xref[t.6.2.4,]{6.2.4: VAT 21604 (+) 21605 Seg. B l. 2}} He holds up the sky, letting the earth dangle from his hands. 
#etcsl: line-id=A.4.4.5

#etcsl#cf cf. 6.1.03.167, 6.1.22: l. 189, 6.2.4: VAT 21604 (+) 21605 Seg. B l. 2

@end proverb

@div proverb 4.5

A.4.5.6. šul-a-lum-bi al-il₂-il₂
#lem: šulalum[punishment]; il[raise]
#tr.en: @note{cf. @xref[t.6.2.4,]{6.2.4: VAT 21604 (+) 21605 Seg. B l. 4}} He bears the responsibility for it. 
#etcsl: line-id=A.4.5.6

#etcsl#cf cf. 6.2.4: VAT 21604 (+) 21605 Seg. B l. 4

@end proverb

@div proverb 4.6

A.4.6.7. u₂-a-gin₇ saŋ-gu₂-ne-ka-ra ba-e-a-ed₃-de₃-de₃-en
#lem: ua[provisioner]; saŋguŋal[proud]; ed[go up]
#tr.en: @note{cf. @xref[t.6.2.4,]{6.2.4: VAT 21604 (+) 21605 Seg. B l. 7}} As a provisioner, I will come down upon those who speak proudly (?). 
#etcsl: line-id=A.4.6.7

#etcsl#cf cf. 6.2.4: VAT 21604 (+) 21605 Seg. B l. 7

@end proverb

@div proverb 4.7

A.4.7.8. ud šu₂-uš ŋiš₃-e a ab-ra-an
#lem: ud[sun]; šuš[cover]; ŋeš[penis]; a[water]; ri[impose]
#tr.en: All day long, oh penis, 
#etcsl: line-id=A.4.7.8

A.4.7.9. uš₂ šag₄-ba-gin₇ gi duru₅-a ab-la₂-en
#lem: uš[blood]; šag[heart]; gi[reed]; duru[wet]; la[hang]
#tr.en: you ejaculate as if you have blood inside you, and then you hang like a damp reed. 
#etcsl: line-id=A.4.7.9

@end proverb

@div proverb 4.8

A.4.8.10. lu₂ ga-šum dab₅-ba-ni al-me-a lu₂ du₁₄-da-ka-na ba-an-kur₉
#lem: lu[person]; gašum[assassin]; dab[seize]; me[be]; lu[person]; dud[combat]; kur[enter]
#tr.en: @note{cf. @xref[t.6.2.4,]{6.2.4: VAT 21604 (+) 21605 Seg. B ll. 5-6}} He who was the capturer of someone's assassin became his opponent. 
#etcsl: line-id=A.4.8.10

#etcsl#cf cf. 6.2.4: VAT 21604 (+) 21605 Seg. B ll. 5-6

@end proverb

@div proverb 4.9

A.4.9.11. {tum₉}si-sa₂ tum₉ si-am₃ {tum₉}u₁₈-lu lu₂-bi sig₁₀-ga-am₃
#lem: sisa[north wind]; tumu[wind]; si[fill]; ulu[south wind]; lu[person]; sig[put into]
#tr.en: @note{cf. @xref[t.6.2.4,t624.h1]{6.2.4: VAT 21604 (+) 21605 Seg. B ll 8-13}} The north wind is a satisfying wind; the south wind is harmful (?) to man. 
#etcsl: line-id=A.4.9.11

#etcsl#cf cf. 6.2.4: VAT 21604 (+) 21605 Seg. B ll. 8-13

A.4.9.12. {tum₉}sa₁₂-ti-um tum₉ šeŋ₁₄-ŋa₂ {tum₉}mar-tu lu₂ til₃-ba dirig-ga
#lem: satium[east wind]; tumu[wind]; šeŋ[rain]; MAR.TU[westerner]; lu[person]; til[live (of a single person)]; dirig[make more than]
#tr.en: The east wind is a rain-bearing wind; the west wind is greater than those who live there. 
#etcsl: line-id=A.4.9.12

A.4.9.13. {tum₉}sa₁₂-ti-um tum₉ he₂-ŋal₂-la gu₅-li {d}na-ra-am-{d}suen
#lem: satium[east wind]; tumu[wind]; heŋal[plenty]; guli[friend]; Naramsuen[1]RN
#tr.en: The east wind is a wind of prosperity, the friend of @wRN{Naram-@wDN{Suen}}. 
#etcsl: line-id=A.4.9.13

@end proverb

@div proverb 4.10

A.4.10.14. niŋ₂ zu a-na-aš he₂-en-de₃-šu₂
#lem: niŋ[thing]; zu[know]; anaš[why?]; šuš[cover]
#tr.en: Why should someone who knows something conceal it? 
#etcsl: line-id=A.4.10.14

@end proverb

@div proverb 4.11

A.4.11.15. dim₃-ma-ŋu₁₀ ki na-am₃#-ba-al
#lem: dima[small object]; ki[place]; bal[dig]
#tr.en: My intelligence (?) has dug the ground; 
#etcsl: line-id=A.4.11.15

A.4.11.16. %e aŋ₂ %s u₂-gu de₂-a-ŋu₁₀ nu-ub-pad₃-de₃-en
#lem: aŋ[thing]N; ugu[cvne]; de[pour]; pad[find]
#tr.en: you will not find what I have lost! 
#etcsl: line-id=A.4.11.16

@end proverb

@div proverb 4.12

A.4.12.17. maš₂# a-a lu₂ ba-ni-in-ed₃-de₃ kaš-a su-bur₂
#lem: maš[goat]; a[water]; lu[person]; ed[go up]; kaš[beer]; subur[quicksand]
#tr.en: A goat can be made to go down into water; in beer it becomes stuck. 
#etcsl: line-id=A.4.12.17

@end proverb

@div proverb 4.13

A.4.13.18. [...] UL# gu₇-ŋu₁₀ ab-X-e
#lem: X; X; gu[eat]; X
#tr.en: He will …… which I have eaten (?). 
#etcsl: line-id=A.4.13.18

@end proverb

@div proverb 4.14

A.4.14.19. lu₂-tur ga nu-un-da#-gu₇-a ama-zu sumun₂ kurun-a
#lem: lutur[child]; ga[milk]; gu[eat]; ama[mother]; sumun[wild cow]; kurun[beer]
#tr.en: Oh little one who is no longer consuming milk, your mother is a wild cow yielding beer. 
#etcsl: line-id=A.4.14.19

@end proverb

@div proverb 4.15

A.4.15.20. ni₂# teŋ₃-ŋa₂-ni nu-ub#-da-an-til niŋ₂-gu₇# ab-ta-kud
#lem: ni[fear]; teŋ[approach]; til[complete]; niŋgu[food]; kud[cut]
#tr.en: He could not overcome his fears, so he cut off what was fuelling them. 
#etcsl: line-id=A.4.15.20

@end proverb

@div proverb 4.16

A.4.16.21. [a] zig₃#-ga-gin₇ peš₁₀ he₂-da-hul₂
#lem: a[water]; zig[rise]; piš[bank]; hul[rejoice]
#tr.en: The riverbank should rejoice as though there were a flood. 
#etcsl: line-id=A.4.16.21

A.4.16.22. {id₂}idigna a-u₃-ba ŋal₂-la-gin₇# {d}en-lil₂ he₂-da-hul₂
#lem: Idigna[1 Tigris]; aʾu[high water]; ŋal[⟦be⟧ to be (there]; Enlil[1]DN; hul[rejoice]
#tr.en: @wDN{Enlil} should rejoice as though the @wWN{Tigris} were at high water. 
#etcsl: line-id=A.4.16.22

@end proverb

@div proverb 4.17

A.4.17.23. [...] sag₉-ga-zu zu₂ he₂-kud
#lem: X; sag[good]; zu[tooth]; kud[cut]
#tr.en: May your favourite …… bite you. 
#etcsl: line-id=A.4.17.23

@end proverb

@div proverb 4.18

A.4.18.24. [tug₂ huŋ]-ŋa₂#-am₃ gada huŋ-ŋa₂-am₃#
#lem: tug[textile]; huŋ[hire]; gada[flax]; huŋ[hire]
#tr.en: @note{cf. @xref[t.5.6.1,]{5.6.1: ll. 209-211}} I want to get hold of borrowed clothes, 
#etcsl: line-id=A.4.18.24

#etcsl#cf cf. 5.6.1: ll. 209-211

A.4.18.25. za-<gin₃> huŋ-ŋa₂-am₃ šu he₂-ma-ŋal₂
#lem: zagin[lapis lazuli]; huŋ[hire]; šu[hand]; ŋal[⟦be⟧ to be (there]
#tr.en: borrowed linen and borrowed lapis lazuli. 
#etcsl: line-id=A.4.18.25

@end proverb

@div proverb 4.19

A.4.19.26. [X X] X# su-ni i₃-še₂₂-še₂₂# X [X X]
#lem: X; X; X; su[flesh]; šeš[anoint]; X; X; X
#tr.en: … 
#etcsl: line-id=A.4.19.26

A.4.19.27. X engur a mu-de₃-tah-e
#lem: X; engur[(cosmic) underground waters]; a[water]; tah[add]
#tr.en: … anoints his body …… adds water to the subterranean waters. 
#etcsl: line-id=A.4.19.27

@end proverb

@div proverb 4.20

A.4.20.28. [...] RI
#lem: X; X
#etcsl: line-id=A.4.20.28

@end proverb

$ (unknown no. of lines missing)
@end segment

@div segment B

@div proverb 4.41

B.4.41.1. [...] X X
#lem: X; X; X
#tr.en: in order to cross  
#etcsl: line-id=B.4.41.1

B.4.41.2. [...]-an-na X [...] bal#-e-da
#lem: X; X; X; bala[turn]
#tr.en: …… when he lifts it up ……: 
#etcsl: line-id=B.4.41.2

B.4.41.3. [X X X]-ši#-ib₂-guru₃-gur₃#-ru#
#lem: X; X; gur[lift]
#tr.en: @q{“The weapon will take care of the oxen rent for me!”} 
#etcsl: line-id=B.4.41.3

B.4.41.4. {ŋiš}tukul a₂ gud en₃# ma#-tar-re-e-še
#lem: tukul[weapon]; a[arm]; gud[bull]; en[cvne]; tar[cut]
#etcsl: line-id=B.4.41.4

@end proverb

@div proverb 4.42

B.4.42.5. [X X] mu-na-ab#-ši-GI-re-de₃-[...] ŋiš₃#-am₃ ŋiš ab-ra-ra
#lem: X; X; X; ŋeš[penis]; ŋeš[tree]; rah[beat]
#tr.en: Beat the … 
#etcsl: line-id=B.4.42.5

B.4.42.6. [...] egir-ra-a-ni in-su-re-eš-a
#lem: X; egir[back]; sur[press]
#tr.en: … behind him they squeezed ……: 
#etcsl: line-id=B.4.42.6

B.4.42.7. ugu-ŋu₁₀-uš am₃-kum₂-e-še
#lem: ugu[skull]; kum[hot]
#tr.en: @q{“The water is too hot for me!”} 
#etcsl: line-id=B.4.42.7

B.4.42.8. X bi₂#-ed₃-de₃-eš ŋiškim ba-ab-til₃
#lem: X; ed[go up]; ŋeškim[sign]; til[live (of a single person)]
#tr.en: Then they brought up …… and entrusted ……. 
#etcsl: line-id=B.4.42.8

@end proverb

@div proverb 4.43

B.4.43.9. tug₂ ib₂-taka₄# ha-la dumu geme₂-kam
#lem: tug[textile]; ibtag[remainder]; hala[inheritance share]; dumu[child]; geme[female worker]
#tr.en: Left-over clothes are the share of the slave-girl's child; 
#etcsl: line-id=B.4.43.9

B.4.43.10. ib₂-ta-šub in-bul-bul-a bi₂-in-ak
#lem: šub[fall]; inbulbul[an agricultural product]; ak[do]
#tr.en: they will fall off her and became nothing but chaff. 
#etcsl: line-id=B.4.43.10

@end proverb

@div proverb 4.44

B.4.44.11. HAR-UŠ šu keše₂-da-ni i₃ ri-a i₃ šeš₄#-da-ni
#lem: X; šu[hand]; kešed[bind]; i[oil]; ri[impose]; i[oil]; šeš[anoint]
#tr.en: A …… is his clasped hands; pressed oil, 
#etcsl: line-id=B.4.44.11

B.4.44.12. %e aŋ₂ %s sig₁₀-ga A-|ZI&ZI.LAGAB| %e mu-nud-da-ni
#lem: aŋ[thing]N; sig[put into]; A.ZI\&ZI.LAGAB[esparto grass]; munud[bed]N
#tr.en: oil for his anointing; a likeness, reeds for his bed. 
#etcsl: line-id=B.4.44.12

@end proverb

@div proverb 4.45

B.4.45.13. {ŋiš}kiši₁₆ nam-lu₂-inim-ma
#lem: kišig[acacia]; namluʾinimak[status of witness]
#tr.en: The prosopis plant is how a witness should be: 
#etcsl: line-id=B.4.45.13

B.4.45.14. harub-ba-am₃ im-ta-e₃-a
#lem: harub[carob (tree)]; e[leave]
#tr.en: fruit pods come forth from it. 
#etcsl: line-id=B.4.45.14

@end proverb

@div proverb 4.46

B.4.46.15. šag₄ niŋ₂-kas₇ nu-zu šag₄# igi#-ŋal₂-tuku
#lem: šag[heart]; niŋkas[account]; zu[know]; šag[heart]; igiŋaltuku[wise]
#tr.en: A heart which does not know accounting -- is that a wise heart? 

#etcsl: line-id=B.4.46.15

@end proverb

@div proverb 4.47

B.4.47.16. lu₂ a-šag₄ ur₁₁-ru-ke₄ a-šag₄ he₂-ur₁₁-ru
#lem: lu[person]; ašag[field]; uru[sow]; ašag[field]; uru[sow]
#tr.en: He who ploughs the fields should plough the fields; 
#etcsl: line-id=B.4.47.16

B.4.47.17. lu₂ še šu su-ub-bu-da-ke₄ še šu he₂#-eb-su-ub-be₂
#lem: lu[person]; še[barley]; šu[hand]; sub[rub]; še[barley]; šu[hand]; sub[rub]
#tr.en: he who harvests grain should harvest grain. 
#etcsl: line-id=B.4.47.17

@end proverb

@div proverb 4.48

B.4.48.18. ka-bi kišib-gin₇ MAŠ-am₃ bid₃-bi u₂-a ma₃-ur₃-am₃
#lem: kag[mouth]; kišib[cylinder seal]; n; bed[anus]; u[plant(s)]; maʾur[the place where a water course becomes too shallow to allow boats to pass]
#tr.en: Its mouth, like a seal (?), is half; its anus is the place amongst the grass where boats are pulled from the water. 
#etcsl: line-id=B.4.48.18

@end proverb

@div proverb 4.49

B.4.49.19. muš un-na-dab₅ e-ne ka-inim-ma ba-ab-šum₂-mu
#lem: muš[snake]; dab[seize]; ane[he]; kaʾinimak[incantation formula]; šum[give]
#tr.en: After the serpent has been caught for him, he himself casts the incantation. 
#etcsl: line-id=B.4.49.19

@end proverb

@div proverb 4.50

B.4.50.20. %e ta#-am₃ %s u₈-am₃ %e ta-am₃ %s a-a-lum-am₃
#lem: ta[what?]QP; u[sheep]; ta[what?]QP; ayalum[stag]
#tr.en: What is it, a sheep? What is it, a stag? 
#etcsl: line-id=B.4.50.20

@end proverb

@div proverb 4.51

B.4.51.21. %e [ta]-am₃# %s ma-mu₂ %e gi₄-in-na-kam
#lem: ta[what?]QP; mamud[dream]; gin[worker]N
#tr.en: What are the dreams of a slave girl? 
#etcsl: line-id=B.4.51.21

B.4.51.22. %e ta-am₃ %s sizkur₂ %e e-re %s sig₁₀ ki-in-na-kam
#lem: ta[what?]QP; siškur[prayer]; ere[slave]N; sig[put into]; kiŋ[seek]
#tr.en: What are the prayers of a striving (?) slave? 
#etcsl: line-id=B.4.51.22

@end proverb

@div proverb 4.52

B.4.52.23. [...] X e-da-gu₇# til-e-da-gin₇
#lem: X; X; gu[eat]; til[complete]
#tr.en: Let my gifts never cease (?) in the presence of his god. 
#etcsl: line-id=B.4.52.23

