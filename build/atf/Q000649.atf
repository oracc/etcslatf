&Q000649 = A song of Inana and Dumuzid (Dumuzid-Inana R)
@composite
#project: etcslatf/inter
#atf: use unicode
#atf: use math
#etcsl: text-id=c.4.08.18
#key: after http://etcsl.orinst.ox.ac.uk/cgi-bin/etcsl.cgi?text=c.4.08.18&display=Crit&charenc=gcirc#

@div version 1 (Version A (of three closely related compositions))

@div sa-gida A

1.A.1. {[lu₂]}[ki-sikil kun-sig₃] mul#-mul-la sig₇ sag₉-ga-am₃#
#lem: kisikil[young woman]; kunsig[bristle]; mul[shine]; sissig[green-yellow]; sag[good]
#tr.en: Maiden, glossy mane, lovely beauty, @wDN{Inana}, glossy mane, lovely beauty! 
#etcsl: line-id=1.A.1

1.A.2. {[d]}inana# kun-sig₃ mul-mul-la sig₇ sag₉-ga-am₃
#lem: Inanak[1]DN; kunsig[bristle]; mul[shine]; sissig[green-yellow]; sag[good]
#tr.en: Maiden, mane of the ibex, …… red deer, 
#etcsl: line-id=1.A.2

1.A.3. {[lu₂]}[ki-sikil] kun-sig₃ tarah X lu#-lim X lu-lim-ma
#lem: kisikil[young woman]; kunsig[bristle]; durah[wild goat]; X; lulim[stag]; X; lulim[stag]
#tr.en: …… red deer, Inana, mane of the ibex, 
#etcsl: line-id=1.A.3

1.A.4. {[d]}inana# kun-sig₃ tarah X [lu]-lim X lu-lim-e
#lem: Inanak[1]DN; kunsig[bristle]; durah[wild goat]; X; lulim[stag]; X; lulim[stag]
#tr.en: …… red deer, …… red deer! 
#etcsl: line-id=1.A.4

1.A.5. {lu₂#}ki-sikil še-zar-maš-gin₇ gun₃-a# lugal-ra tum₂-ma
#lem: kisikil[young woman]; zarmaš[grain heap]; gunu[speckled]; lugal[king]; tum[suitable]
#tr.en: Maiden, colourful as a pile of grain, fit for the king, @wDN{Inana}, 
#etcsl: line-id=1.A.5

1.A.6. {d}inana še-zar-maš-gin₇ gun₃-a {d}dumu-zid-ra tum₂-ma
#lem: Inanak[1]DN; zarmaš[grain heap]; gunu[speckled]; Dumuzid[1]DN; tum[suitable]
#tr.en: colourful as a pile of grain, fit for @wDN{Dumuzid}! 
#etcsl: line-id=1.A.6

1.A.7. {lu₂}ki-sikil še-zar gu₂-nida-a hi-li šu gi₄-a-ŋen
#lem: kisikil[young woman]; šezar[grain heap]; gunida[designation of grain]; hili[attractiveness]; šu[hand]; gi[turn]
#tr.en: Maiden, you are a shock of two-row barley, fully developed in loveliness, @wDN{Inana}, 
#etcsl: line-id=1.A.7

1.A.8. {d}inana še-zar gu₂-nida-a hi-li šu gi₄-a-ŋen
#lem: Inanak[1]DN; šezar[grain heap]; gunida[designation of grain]; hili[attractiveness]; šu[hand]; gi[turn]
#tr.en: you are a shock of two-row barley, fully developed in loveliness! 
#etcsl: line-id=1.A.8

1.A.9. nin-ŋen nin-ŋen X X X hi-li gur₃-ru-ŋen
#lem: nin[lady]; nin[lady]; X; X; X; hili[attractiveness]; gur[lift]
#tr.en: I am the queen, I am the queen, I am …… full of loveliness! 
#etcsl: line-id=1.A.9

1.A.10. %e me-e %s ki-sikil-ŋen nin-ŋen# [... hi]-li gur₃-ru-ŋen
#lem: meʾe[I]IP; kisikil[young woman]; nin[lady]; X; hili[attractiveness]; gur[lift]
#tr.en: I am the maiden, I am the queen, I am …… full of loveliness! 
#etcsl: line-id=1.A.10

1.A.11. nin a an-ne₂ ru-a-ŋen [X X hi]-li gur₃#-ru-ŋen
#lem: nin[lady]; a[water]; An[1]DN; ri[impose]; X; X; hili[attractiveness]; gur[lift]
#tr.en: I am the queen, seed engendered by @wDN{An}, I am …… full of loveliness! 
#etcsl: line-id=1.A.11

1.A.12. %e u₅ ze₂-ba u₅ ze₂-ba %s X X X ir-si#-im %e ze₂-ba-ŋen
#lem: u[oil]N; zeb[good]V/i; u[oil]N; zeb[good]V/i; X; X; X; irsim[fragrance]; zeb[good]V/i
#tr.en: I am good oil, good oil, …… sweet perfume! 
#etcsl: line-id=1.A.12

1.A.13. IR X IM X X X X X X X ma₂ he₂-em-ši-ib-us₂-e
#lem: X; X; X; X; X; X; X; X; X; X; ma[ship]; us[accompany]
#tr.en: …… may he moor the boat ……. 
#etcsl: line-id=1.A.13

1.A.14. X X X X X X X X ma₂ he₂-em-ši-ib-us₂-e
#lem: X; X; X; X; X; X; X; X; ma[ship]; us[accompany]
#tr.en: …… may he moor the boat ……. 
#etcsl: line-id=1.A.14

1.A.15. nin#-[ŋen] X X e₂ PAD₃ en-ni-a %e mu-un-da-an-di-di-in
#lem: nin[lady]; X; X; e[house]; X; en[lord]; de[go]
#tr.en: I am the queen, I shall go with him to his ……. 
#etcsl: line-id=1.A.15

1.A.16. {d}inana#-[ŋen] X X X X-ni-a %e mu-un-da-an-di-di-in
#lem: Inanak[1]DN; X; X; X; X; de[go]
#tr.en: I am @wDN{Inana}, I shall go with him to his ……. 
#etcsl: line-id=1.A.16

1.A.17. GA X X X X X X X-ni-a %e mu-un-da-an-di-di-in
#lem: X; X; X; X; X; X; X; X; de[go]
#tr.en: I shall go with him to his ……. 
#etcsl: line-id=1.A.17

1.A.18. {e₂}pa-pah X A UB X-ni-a %e mu-un-da-an-di-di-in
#lem: papah[cella]; X; X; X; X; de[go]
#tr.en: I shall go with him to his …… shrine. 
#etcsl: line-id=1.A.18

1.A.19. e₂-e kab-dug₄-ga X-ni-a %e mu-un-da-an-di-di-in
#lem: e[house]; kabduga[checked]; X; de[go]
#tr.en: I shall go with him to the house with its measuring jars. 
#etcsl: line-id=1.A.19

1.A.20. %e mu-ti-in-e %s ga-ŋu₁₀# ga-ga-ŋu₁₀ %e di-di %e du₅-mu-u₅-zu
#lem: mutin[male]; ga[milk]; gara[cream]; de[go]; zu[know]
#tr.en: Let me learn the way to the man, my milk, my cream! 
#etcsl: line-id=1.A.20

1.A.21. {d}ama-ušum-ŋu₁₀ ga-ŋu₁₀ ga-ga-ŋu₁₀ %e di-di %e du₅-mu-u₅-zu
#lem: Amaušum[1]DN; ga[milk]; gara[cream]; de[go]; zu[know]
#tr.en: Let me learn the way to my @wDN{Ama-ušum}, my milk, my cream! 
#etcsl: line-id=1.A.21

1.A.22. {d}ama-ušumgal-an#-na ga-ŋu₁₀ ga-ga-ŋu₁₀ %e di-di %e du₅-mu-u₅-zu
#lem: Amaʾušumgalanak[1]DN; ga[milk]; gara[cream]; de[go]; zu[know]
#tr.en: Let me learn the way to @wDN{Ama-ušumgal-ana}, my milk, my cream! 
#etcsl: line-id=1.A.22

1.A.23. {u₂}numun₂-še₃ ga-ŋu₁₀ ga-ŋu₁₀-še₃ ga-ŋu₁₀ %e di-di %e du₅-mu-u₅-zu
#lem: numun[alfalfa grass]; ga[milk]; ga[milk]; ga[milk]; de[go]; zu[know]
#tr.en: Let me learn the way to the esparto grass, my milk, to my milk, my milk! 
#etcsl: line-id=1.A.23

1.A.24. {ŋiš}asal₂ ki sed₅-še₃ ga-ŋu₁₀ %e di-di %e du₅-mu-u₅-zu
#lem: asal[poplar]; ki[place]; sed[cold]; ga[milk]; de[go]; zu[know]
#tr.en: Let me learn the way to the poplars, the cool place, my milk! 
#etcsl: line-id=1.A.24

1.A.25. {u₂}in-uš u₂ sikil-še₃ ga-ŋu₁₀ %e di-di %e du₅-mu-u₅-zu
#lem: innuš[plant]; u[plant(s)]; sikil[pure]; ga[milk]; de[go]; zu[know]
#tr.en: Let me learn the way to the @fsux{innuš} plants, the pure plants, my milk! 
#etcsl: line-id=1.A.25

1.A.26. {u₂}rib-ba ki halba₂-še₃ ga-ŋu₁₀ %e di-di %e du₅-mu-u₅-zu
#lem: ribba[type of plant]; ki[place]; halba[frost]; ga[milk]; de[go]; zu[know]
#tr.en: Let me learn the way to the grasslands, the frosty place, my milk! 
#etcsl: line-id=1.A.26

1.A.27. amaš kug-ga amaš %e mu-ti-in-na-ŋa₂-še₃ %e di-di %e du₅-mu-u₅-zu
#lem: amaš[sheepfold]; kug[pure]; amaš[sheepfold]; mutin[male]; de[go]; zu[know]
#tr.en: Let me learn the way to the holy sheepfold, my man's sheepfold! 
#etcsl: line-id=1.A.27

1.A.28. amaš kug-ge amaš {d}dumu-zid-ŋa₂-še₃# %e di-di# %e du₅-mu#-u₅-zu
#lem: amaš[sheepfold]; kug[pure]; amaš[sheepfold]; Dumuzid[1]DN; de[go]; zu[know]
#tr.en: Let me learn the way to the holy sheepfold, my @wDN{Dumuzid's} sheepfold! 
#etcsl: line-id=1.A.28

@div trailer 

1.A.29. sa-gid₂-da#-am₃
#lem: sagida[musical notation]
