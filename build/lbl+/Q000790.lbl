&Q000790

{1 = 1-10}
9=1.	@wPN{Nam-zid-tara} walked by @wDN{Enlil}, who said to him: 
13=2.	@q[Enlil,Nam-zid-tara]{“Where have you come from, 
17=3.	@wPN{Nam-zid-tara}?”} @q[Nam-zid-tara,Enlil]{“From @wDN{Enlil's} temple. 
21=4.	My turn of duty is finished. 
25=5.	I serve at the place of the @fsux{gudug} priests, 
29=6.	with their sheep. 
33=7.	I am on my way home. 
37=8.	Don't stop me; 
41=9.	I am in a hurry. 
45=10.	Who are you who asks me questions?”} 

{11 = 11-16}
49=11.	@q[Enlil,Nam-zid-tara]{“I am @wDN{Enlil}.”} But @wDN{Enlil} had changed his appearance: 
53=12.	he had turned into a raven and was croaking. 
57=13.	@q[Nam-zid-tara,Enlil]{“But you are not a raven, 
61=14.	you really are @wDN{Enlil}!”} 
65=15.	@q[Enlil,Nam-zid-tara]{“How did you recognise that I am @wDN{Enlil}, 
69=16.	who decrees the destinies?”} 

{17 = 17-18}
73=17.	@q[Nam-zid-tara,Enlil]{“When your uncle @wDN{En-me-šara} was a captive, after taking for himself the rank of @wDN{Enlil}, 
77=18.	he said: @q[En-me-cara,]{“Now I shall know the fates, like a lord.”}”} 

{19 = 19-23}
81=19.	@q[Enlil,Nam-zid-tara]{“You may acquire precious metals, you may acquire precious stones, 
85=20.	you may acquire cattle or you may acquire sheep; 
89=21.	but the day of a human being is always getting closer, 
93=22.	so where does your wealth lead? Now, I am indeed @wDN{Enlil}, 
97=23.	who decrees the fates. What is your name?”} 

{24 = 24-27}
101=24.	@q[Nam-zid-tara,Enlil]{“My name is @wPN{Nam-zid-tara} (Well-blessed).”} @q[Enlil,Nam-zid-tara]{“Your fate  
105=25.	shall be assigned according to your name: 
109=26.	leave the house of your master, 
113=27.	and your heirs shall come and go regularly in my temple.”} 
